 /*
- * Metal's discovery (patch 0184): Metal.framework looks up IOServiceMatching("IOAcceleratorES")
- * and loads /System/Library/Extensions/<MetalPluginName>.bundle, class MetalPluginClassName; Turnip's
- * Darwin backend, without TU_DARWIN_SERVICE, also opens IOAcceleratorES (type 0x4147, NTNL tunnel).
- * IOAcceleratorES here is the empty in-kernel class of the fuxi lane (FuxiAdrenoUserClient.cpp,
- * compiled into this kernel; Apple's IOGPUFamily is not loaded), declared again to derive from it.
- * The class is named AGXAccelerator as UniXNU's is, the name Apple's sandbox profiles accept. It is
- * published only with boot-arg pandora_gpu_metal=1: once it exists, every process that starts
- * Metal (backboardd first) finds it and goes looking for the plugin.
+ * Metal's discovery (patch 0333): Metal.framework calls
+ * IOServiceMatching("IOAcceleratorES") - 210 times per boot - and then loads
+ * /System/Library/Extensions/<MetalPluginName>.bundle, class MetalPluginClassName.
+ * Turnip's Darwin backend, without TU_DARWIN_SERVICE, opens the same node with
+ * type 0x4147 (NTNL tunnel).
+ *
+ * The class name has to be exactly "IOAcceleratorES": IOServiceMatching() resolves
+ * through OSMetaClass::applyToInstancesOfClassName() ->
+ * sAllClassesDict->getObject(name), so it walks one metaclass's instance set and never
+ * looks at subclasses (that is why AGXAccelerator, a subclass, answered none of the
+ * 210 calls). Patch 0184 used to sit on that name via an empty fuxi-lane class; 0333
+ * renamed that one to FuxiAcceleratorES and publishes this node here instead.
+ *
+ * Published only with boot-arg pandora_gpu_metal=1. AGXAccelerator stays as the
+ * UniXNU-compatible alias but no longer has a personality, so only one node exists -
+ * two nodes would make Metal see two GPUs.
  */
 class IOAcceleratorES : public IOService {
 	OSDeclareDefaultStructors(IOAcceleratorES);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties,
+	    IOUserClient **handler) APPLE_KEXT_OVERRIDE;
 };
 
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+/* The query Apple's userland issues, run from the kernel. */
+static IOService *
+pandora_gpu_es_query(bool userland)
+{
+	OSDictionary *m = IOService::serviceMatching("IOAcceleratorES");
+	if (m && userland) {
+		m->setObject("IOServiceNotificationUser", kOSBooleanTrue);
+	}
+	IOService *found = m ? IOService::copyMatchingService(m) : nullptr;
+	if (m) {
+		m->release();
+	}
+	return found;
+}
+
+static void
+pandora_gpu_es_report(const char *when)
+{
+	IOService *plain = pandora_gpu_es_query(false);
+	IOService *uland = pandora_gpu_es_query(true);
+	IOLog("PANDORA GPU ES: %s plain %s, userland %s\n", when,
+	    plain ? plain->getMetaClass()->getClassName() : "none",
+	    uland ? uland->getMetaClass()->getClassName() : "none");
+	if (plain) {
+		plain->release();
+	}
+	if (uland) {
+		uland->release();
+	}
+}
+
+static void
+pandora_gpu_es_publish_thread(void *arg, wait_result_t)
+{
+	IOService *es = static_cast<IOService *>(arg);
+	/*
+	 * registerService() from inside a personality start() only queues a match job, and at 0.139 s
+	 * the platform workloop is not dispatching yet: the job never reaches doServiceMatch(), so the
+	 * service never gets kIOServiceRegisteredState/kIOServiceMatchedState and IOServiceMatching()
+	 * answers nothing for the whole boot. Register late and synchronously instead - that runs
+	 * doServiceMatch() inline.
+	 */
+	IOSleep(1500);
+	es->registerService(kIOServiceSynchronous);
+	IOLog("PANDORA GPU ES: registered at boot+1.5 s, state %#x plane %d\n", es->getState(),
+	    es->inPlane(gIOServicePlane));
+	pandora_gpu_es_report("after register");
+	/* backboardd starts asking around 28 s; sample inside its window. */
+	IOSleep(44000);
+	pandora_gpu_es_report("at boot+45 s");
+	/* Deliberately no release: the registry holds no reference, so letting go frees the node. */
+}
+
+bool
+IOAcceleratorES::start(IOService *provider)
+{
+	int metal = 0;
+	(void)PE_parse_boot_argn("pandora_gpu_metal", &metal, sizeof(metal));
+	if (!metal || !IOService::start(provider)) {
+		return false;
+	}
+	setName("NativeAdrenoGpu");
+	setProperty("MetalPluginName", "NativeAdrenoMetal");
+	setProperty("MetalPluginClassName", "NativeAdrenoMetalDevice");
+	/* Registration is deferred: see pandora_gpu_es_publish_thread(). The retain keeps it alive. */
+	retain();
+	thread_t thread;
+	if (kernel_thread_start(pandora_gpu_es_publish_thread, this, &thread) != KERN_SUCCESS) {
+		release();
+		return false;
+	}
+	thread_deallocate(thread);
+	return true;
+}
+
+IOReturn
+IOAcceleratorES::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    __unused OSDictionary *properties, IOUserClient **handler)
+{
+	IOLog("PANDORA GPU ES: open type 0x%x\n", type);
+	return pandora_gpu_new_client(this, owningTask, securityID, type, handler);
+}
+
 class AGXAccelerator : public IOAcceleratorES {
 	OSDeclareDefaultStructors(AGXAccelerator);
 
