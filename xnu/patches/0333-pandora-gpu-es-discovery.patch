 class IOAcceleratorES : public IOService {
 	OSDeclareDefaultStructors(IOAcceleratorES);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties,
+	    IOUserClient **handler) APPLE_KEXT_OVERRIDE;
 };
 
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+static int pandora_gpu_es_started;
+
+/* Query exactly as Apple's userland issues it, from the kernel. */
+static IOService *
+pandora_gpu_es_query(bool userland)
+{
+	OSDictionary *m = IOService::serviceMatching("IOAcceleratorES");
+	if (m && userland) {
+		m->setObject("IOServiceNotificationUser", kOSBooleanTrue);
+	}
+	IOService *found = m ? IOService::copyMatchingService(m) : nullptr;
+	if (m) {
+		m->release();
+	}
+	return found;
+}
+
+static void
+pandora_gpu_es_sample(IOService *es, const char *when)
+{
+	IOService *plain = pandora_gpu_es_query(false);
+	IOService *uland = pandora_gpu_es_query(true);
+	IOLog("PANDORA GPU ES: %s state %#x rc %d plane %d, plain %s, userland %s\n", when,
+	    es->getState(), es->getRetainCount(), es->inPlane(gIOServicePlane),
+	    plain ? plain->getMetaClass()->getClassName() : "none",
+	    uland ? uland->getMetaClass()->getClassName() : "none");
+	if (plain) {
+		plain->release();
+	}
+	if (uland) {
+		uland->release();
+	}
+}
+
+static void
+pandora_gpu_es_publish_thread(void *arg, wait_result_t)
+{
+	IOService *es = static_cast<IOService *>(arg);
+	/*
+	 * registerService() from inside a personality start() only queues a match job, and at 0.139 s
+	 * the platform workloop is not dispatching, so the job never reaches doServiceMatch(). Register
+	 * late and synchronously instead: that runs the match inline.
+	 */
+	IOSleep(1500);
+	es->registerService(kIOServiceSynchronous);
+	pandora_gpu_es_sample(es, "after register");
+	/*
+	 * backboardd asks between 29 s and 55 s (log18: 206 iterator queries at 29.067 s, then single
+	 * service queries at 49.835 s and 54.89 s). Sample every 2 s across that window so the log
+	 * shows whether the node disappears, gets terminated, or breaks its reference count.
+	 */
+	IOSleep(44000);
+	for (int i = 0; i < 6; i++) {
+		pandora_gpu_es_sample(es, "window");
+		IOSleep(2000);
+	}
+	/* No release of `es`: the registry holds no reference of its own. */
+}
+
+bool
+IOAcceleratorES::start(IOService *provider)
+{
+	int metal = 0;
+	(void)PE_parse_boot_argn("pandora_gpu_metal", &metal, sizeof(metal));
+	if (!metal) {
+		return false;
+	}
+	IOLog("PANDORA GPU ES: start call %d, state %#x rc %d\n", pandora_gpu_es_started + 1,
+	    getState(), getRetainCount());
+	/*
+	 * registerService() re-runs matching for the node, and that calls start() a second time. The
+	 * second IOService::start() fails (already started), and returning false there makes doServiceMatch
+	 * terminate the node; terminate() is queued, not synchronous, so the node stayed visible for a
+	 * while and then vanished - log18 answers the in-kernel query at 45.6 s and backboardd's identical
+	 * query at 49.8 s gets nothing. Accept every call after the first.
+	 */
+	if (pandora_gpu_es_started) {
+		return true;
+	}
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	pandora_gpu_es_started = 1;
+	setName("NativeAdrenoGpu");
+	setProperty("MetalPluginName", "NativeAdrenoMetal");
+	setProperty("MetalPluginClassName", "NativeAdrenoMetalDevice");
+	/* Registration is deferred: see pandora_gpu_es_publish_thread(). The retain keeps it alive. */
+	retain();
+	thread_t thread;
+	if (kernel_thread_start(pandora_gpu_es_publish_thread, this, &thread) != KERN_SUCCESS) {
+		release();
+		return false;
+	}
+	thread_deallocate(thread);
+	return true;
+}
+
+IOReturn
+IOAcceleratorES::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    __unused OSDictionary *properties, IOUserClient **handler)
+{
+	IOLog("PANDORA GPU ES: open type 0x%x\n", type);
+	return pandora_gpu_new_client(this, owningTask, securityID, type, handler);
+}
