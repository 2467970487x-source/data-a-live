 }
+
+/*
+ * Metal's discovery (patch 0333). IOServiceMatching("X") resolves through
+ * OSMetaClass::applyToInstancesOfClassName(): it looks the name up in sAllClassesDict and walks that
+ * one class's instance set - exact class name, no subclass walk, no provider check. So AGXAccelerator
+ * (a subclass of IOAcceleratorES) can never answer the 225 IOAcceleratorES lookups backboardd makes
+ * per boot. Publish a service whose class name is one iOS asks for, handing out the same
+ * AGXDeviceUserClient AGXAccelerator does: type 0 is Metal's own IOServiceOpen, 0x4147 is Turnip's
+ * raw ABI.
+ */
+class IOAcceleratorESLegacy : public IOAcceleratorES {
+	OSDeclareDefaultStructors(IOAcceleratorESLegacy);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties,
+	    IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorESLegacy, IOAcceleratorES);
+
+/* The query iOS issues, run from the kernel: same dictionary, same filter bit. */
+static IOService *
+pandora_gpu_es_query(void)
+{
+	OSDictionary *m = IOService::serviceMatching("IOAcceleratorESLegacy");
+	IOService *found = m ? IOService::copyMatchingService(m) : nullptr;
+	if (m) {
+		m->release();
+	}
+	return found;
+}
+
+static void
+pandora_gpu_es_publish_thread(void *arg, wait_result_t)
+{
+	IOService *es = static_cast<IOService *>(arg);
+	/*
+	 * registerService() from inside a personality start() only queues a match job, and at 0.139 s
+	 * the platform workloop is not dispatching yet: the job never reaches doServiceMatch() and the
+	 * service stays without kIOServiceRegisteredState/kIOServiceMatchedState for the whole boot.
+	 * Register late and synchronously, so doServiceMatch() runs inline.
+	 */
+	IOSleep(1500);
+	es->registerService(kIOServiceSynchronous);
+	IOService *early = pandora_gpu_es_query();
+	IOLog("PANDORA GPU ES: early state %#x plane %d, self-query -> %s\n", es->getState(),
+	    es->inPlane(gIOServicePlane),
+	    early ? early->getMetaClass()->getClassName() : "none");
+	if (early) {
+		early->release();
+	}
+	/* backboardd asks between 28 s and 55 s: still there at 45 s means it is there when asked. */
+	IOSleep(44000);
+	IOService *late = pandora_gpu_es_query();
+	IOLog("PANDORA GPU ES: late state %#x plane %d, self-query -> %s\n", es->getState(),
+	    es->inPlane(gIOServicePlane),
+	    late ? late->getMetaClass()->getClassName() : "none");
+	if (late) {
+		late->release();
+	}
+	/*
+	 * Deliberately no release of `es`: the personality has already dropped its reference by now and
+	 * the registry does not hold one either, so letting go here frees the service and detaches it.
+	 * log14 held the node at 1.6 s (state 0x1e) and lost it before backboardd's 49.8 s query.
+	 */
+}
+
+bool
+IOAcceleratorESLegacy::start(IOService *provider)
+{
+	int metal = 0;
+	(void)PE_parse_boot_argn("pandora_gpu_metal", &metal, sizeof(metal));
+	if (!metal || !IOService::start(provider)) {
+		return false;
+	}
+	setName("NativeAdrenoGpu");
+	setProperty("MetalPluginName", "NativeAdrenoMetal");
+	setProperty("MetalPluginClassName", "NativeAdrenoMetalDevice");
+	/* Registration is deferred: see pandora_gpu_es_publish_thread(). The retain keeps it alive. */
+	retain();
+	thread_t thread;
+	if (kernel_thread_start(pandora_gpu_es_publish_thread, this, &thread) != KERN_SUCCESS) {
+		release();
+		return false;
+	}
+	thread_deallocate(thread);
+	return true;
+}
+
+IOReturn
+IOAcceleratorESLegacy::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    __unused OSDictionary *properties, IOUserClient **handler)
+{
+	IOLog("PANDORA GPU ES: open type 0x%x\n", type);
+	return pandora_gpu_new_client(this, owningTask, securityID, type, handler);
+}
