+/* SPDX-License-Identifier: GPL-2.0-only */
+/* iOS 16 Apple80211 ioctl/event ABI, as recorded in HackiOS redwood's
+ * redwood_apple80211.c. Only implemented Peach operations/capabilities are
+ * exposed. All mutable protocol state stays on pandora_wifi's worker. */
+#include "PeachApple80211.h"
+#include "PeachNet.h"
+#include <kern/kalloc.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <sys/errno.h>
+#include <sys/kern_event.h>
+#include <sys/proc.h>
+#include <sys/systm.h>
+
+#define APPLE_SET 0x802869c8u
+#define APPLE_GET 0xc02869c9u
+typedef struct {
+    char interface[16];
+    int32_t type, value;
+    uint32_t length;
+    user_addr_t data __attribute__((aligned(8)));
+} AppleRequest;
+typedef struct { uint32_t version, channel, flags; } AppleChannel;
+typedef struct {
+    uint32_t version, count;
+    AppleChannel channels[401];
+    uint32_t unused;
+} AppleChannels;
+typedef struct {
+    uint8_t unknown0[12];
+    uint16_t count;
+    uint8_t unknown1[800];
+    uint8_t number[400], indoor[400], dfs[400], passive[400], wide40[400], wide80[400];
+    uint8_t unknown2[1602];
+    uint32_t flags[400];
+    uint8_t unknown3[3600];
+} __attribute__((packed)) AppleChannelsInfo;
+typedef struct {
+    uint32_t version;
+    AppleChannel channel;
+    uint16_t noise_known;
+    int16_t noise, snr, rssi;
+    uint16_t beacon_interval, capability;
+    uint8_t bssid[6], rate_count, unused0;
+    uint32_t rates[15];
+    uint8_t ssid_bytes, ssid[32], unused1[3];
+    uint32_t age_ms;
+    uint8_t flags, unused2;
+    uint16_t ie_bytes;
+    uint8_t ies[1024];
+} AppleScanResult;
+typedef struct {
+    uint32_t version, bss_type;
+    uint8_t bssid[6], unused0[2];
+    uint32_t ssid_bytes;
+    uint8_t ssid[32];
+    uint32_t scan_type, phy_mode;
+    uint16_t dwell_ms, unused1;
+    uint32_t rest_ms, channel_count;
+    AppleChannel channels[400];
+    uint64_t flags;
+    uint32_t unused2, name_count;
+    uint8_t names[10][56];
+    uint32_t short_ssid, unused3;
+} AppleScanRequest;
+typedef struct {
+    uint32_t version;
+    uint16_t mode, auth_lower, auth_upper, unused0;
+    uint32_t ssid_bytes;
+    uint8_t ssid[32], bssid[6], unused1[2];
+    uint32_t key_version, key_bytes, key_cipher;
+    uint16_t key_flags, key_index;
+    uint8_t key[64];
+} AppleJoin;
+typedef struct {
+    uint8_t down, unused0[3];
+    int32_t rssi;
+    uint16_t snr, noise;
+    uint8_t unused1[4], involuntary, unused2[3];
+    uint32_t reason, subreason;
+    uint8_t unused3[4];
+} AppleLink;
+_Static_assert(sizeof(AppleRequest) == 40 && offsetof(AppleRequest, data) == 32,
+               "Apple80211 ioctl envelope");
+_Static_assert(sizeof(AppleChannels) == 4824 && sizeof(AppleChannelsInfo) == 10016 &&
+               offsetof(AppleChannelsInfo, flags) == 0x12d0, "Apple80211 channels");
+_Static_assert(sizeof(AppleScanRequest) == 5456 && sizeof(AppleScanResult) == 1164 &&
+               offsetof(AppleScanResult, ies) == 0x8c, "Apple80211 scan ABI");
+_Static_assert(sizeof(AppleJoin) == 0x88 && offsetof(AppleJoin, key) == 0x48 &&
+               sizeof(AppleLink) == 32, "Apple80211 join/link ABI");
+static LCK_GRP_DECLARE(apple_group, "nezha-apple80211");
+static LCK_MTX_DECLARE(apple_lock, &apple_group);
+static unsigned result_next, result_generation;
+static void erase(void *p, size_t n)
+{ volatile unsigned char *v = p; while (n--) *v++ = 0; }
+static int give(AppleRequest *r, const void *data, size_t bytes)
+{
+    if (r->length < bytes) { r->length = (uint32_t)bytes; return EMSGSIZE; }
+    if (!r->data && bytes) return EFAULT;
+    return copyout(data, r->data, bytes);
+}
+static AppleChannel channel(unsigned frequency, unsigned flags)
+{
+    AppleChannel c = {1, frequency == 2484 ? 14 : frequency < 2500 ?
+        (frequency - 2407) / 5 : (frequency - 5000) / 5,
+        2u | (frequency < 2500 ? 8u : 16u) | (!(flags & 1) ? 0x80u : 0) |
+        ((flags & 2) ? 0x100u : 0)};
+    return c;
+}
+static AppleChannel bss_channel(unsigned frequency)
+{
+    PeachWmiScanChannel channels[PEACH_WMI_SCAN_CHANNELS];
+    unsigned n = peach_net_channels(channels, PEACH_WMI_SCAN_CHANNELS);
+    for (unsigned i = 0; i < n; i++)
+        if (channels[i].frequency == frequency) return channel(frequency, channels[i].flags);
+    return channel(frequency, 1); /* no active-channel claim without a rule */
+}
+static int network(AppleRequest *r, const PeachWmiBss *b)
+{
+    AppleScanResult *out = kalloc_data(sizeof(*out), Z_WAITOK | Z_ZERO);
+    if (!out) return ENOMEM;
+    unsigned room = sizeof(out->ies);
+    int err = r->length < offsetof(AppleScanResult, ies) ? EINVAL :
+        copyin(r->data, out, offsetof(AppleScanResult, ies));
+    if (err) { kfree_data(out, sizeof(*out)); return err; }
+    if (out->ie_bytes < room) room = out->ie_bytes;
+    memset(out, 0, sizeof(*out));
+    out->version = 1; out->channel = bss_channel(b->frequency);
+    out->rssi = b->rssi; out->beacon_interval = b->beacon_interval; out->capability = b->capability;
+    memcpy(out->bssid, b->bssid, 6); out->ssid_bytes = b->ssid_bytes;
+    memcpy(out->ssid, b->ssid, b->ssid_bytes);
+    out->ie_bytes = b->ie_bytes <= room ? b->ie_bytes : 0;
+    memcpy(out->ies, b->ies, out->ie_bytes);
+    uint64_t ns;
+    absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+    uint64_t age = ns / 1000 > b->seen_us ? (ns / 1000 - b->seen_us) / 1000 : 0;
+    out->age_ms = age > UINT32_MAX ? UINT32_MAX : (uint32_t)age;
+    for (unsigned off = 0; off + 2 <= b->ie_bytes && b->ies[off + 1] <= b->ie_bytes - off - 2;) {
+        unsigned n = b->ies[off + 1];
+        if (b->ies[off] == 1 || b->ies[off] == 50)
+            for (unsigned i = 0; i < n && out->rate_count < 15; i++) {
+                unsigned rate = (b->ies[off + 2 + i] & 127) / 2;
+                if (rate && rate <= 54) out->rates[out->rate_count++] = rate;
+            }
+        off += n + 2;
+    }
+    err = give(r, out, sizeof(*out)); kfree_data(out, sizeof(*out)); return err;
+}
+static int get(AppleRequest *r)
+{
+    PeachNetInfo info; peach_net_info(&info);
+    switch (r->type) {
+    case 43: case 44: {
+        static const char name[256] = "UniXNU Nezha WCN7860 Peach v2";
+        return give(r, name, sizeof(name));
+    }
+    case 12: {
+        /* AES, AES-CCM, short preamble/slot, WPA2 and WME. No HT, power-save
+         * or PMF capability until their actual protocol paths exist. */
+        const uint8_t capabilities[13] = {0x0c, 0x46, 0x02};
+        return give(r, capabilities, sizeof(capabilities));
+    }
+    case 15: r->value = 1; return 0; /* station */
+    case 19: {
+        if (info.state == PeachNetFailed) return ENXIO;
+        uint32_t power[6] = {1, 1, info.powered, 0, 0, 0};
+        return give(r, power, sizeof(power));
+    }
+    case 13:
+        r->value = info.state == PeachNetOnline ? 4 : info.state == PeachNetAssociating ? 2 :
+            info.state == PeachNetHandshake ? 3 : info.state == PeachNetScanning ? 1 : 0;
+        return 0;
+    case 21: r->value = info.result; return 0;
+    case 27: case 254: case 207: {
+        PeachWmiScanChannel channels[PEACH_WMI_SCAN_CHANNELS];
+        unsigned count = peach_net_channels(channels, PEACH_WMI_SCAN_CHANNELS);
+        if (!count) return ENXIO;
+        size_t bytes = r->type == 207 ? sizeof(AppleChannelsInfo) : sizeof(AppleChannels);
+        void *out = kalloc_data(bytes, Z_WAITOK | Z_ZERO);
+        if (!out) return ENOMEM;
+        if (r->type == 207) {
+            AppleChannelsInfo *a = out; a->count = count;
+            for (unsigned i = 0; i < count; i++) {
+                AppleChannel c = channel(channels[i].frequency, channels[i].flags);
+                a->number[i] = c.channel; a->flags[i] = c.flags;
+                a->dfs[i] = !!(channels[i].flags & 2);
+                a->passive[i] = !!(channels[i].flags & 3);
+                a->indoor[i] = !!(channels[i].flags & 8);
+            }
+        } else {
+            AppleChannels *a = out; a->version = 1; a->count = count;
+            for (unsigned i = 0; i < count; i++) a->channels[i] = channel(channels[i].frequency, channels[i].flags);
+        }
+        int err = give(r, out, bytes); kfree_data(out, bytes); return err;
+    }
+    case 11: {
+        PeachWmiBss b;
+        lck_mtx_lock(&apple_lock);
+        unsigned index = result_next, generation = result_generation;
+        int err = peach_net_bss(index, &b);
+        lck_mtx_unlock(&apple_lock);
+        if (!err) err = network(r, &b);
+        /* User memory faults and allocation must not block scan events
+         * on the protocol worker. Advance only this successful snapshot. */
+        lck_mtx_lock(&apple_lock);
+        if (!err && result_next == index && result_generation == generation) result_next++;
+        lck_mtx_unlock(&apple_lock);
+        return err;
+    }
+    default: break;
+    }
+    if (info.state != PeachNetOnline) return ENXIO;
+    switch (r->type) {
+    case 1: {
+        int err = give(r, info.current.ssid, info.current.ssid_bytes);
+        if (!err) r->length = info.current.ssid_bytes;
+        return err;
+    }
+    case 9: return give(r, info.current.bssid, 6);
+    case 4: {
+        struct { uint32_t version; AppleChannel channel; } a = {1, bss_channel(info.current.frequency)};
+        return give(r, &a, sizeof(a));
+    }
+    case 16: {
+        struct { uint32_t version, radios, unit; int32_t each[4], all, each_ext[4], all_ext; }
+            a = { .version = 1, .radios = 1, .each = {info.current.rssi}, .all = info.current.rssi,
+                  .each_ext = {info.current.rssi}, .all_ext = info.current.rssi };
+        return give(r, &a, sizeof(a));
+    }
+    case 2: {
+        uint32_t auth[4] = {1, 1, info.security == PeachStationWpa2Psk ? 8u : 0, 0};
+        return give(r, auth, sizeof(auth));
+    }
+    case 103: return network(r, &info.current);
+    default: return EOPNOTSUPP;
+    }
+}
+static int join(const AppleRequest *r)
+{
+    if (r->length < sizeof(AppleJoin)) return EINVAL;
+    AppleJoin a; PeachNetRequest request = {0};
+    int err = copyin(r->data, &a, sizeof(a));
+    if (err) { erase(&a, sizeof(a)); return err; }
+    if (a.version != 1 || (a.auth_lower & ~1u) || (a.auth_upper & ~8u) ||
+        !a.ssid_bytes || a.ssid_bytes > 32) { err = EOPNOTSUPP; goto done; }
+    request.action = PeachControlJoin; request.join.version = PEACH_CONTROL_VERSION;
+    request.join.ssid_bytes = a.ssid_bytes; memcpy(request.join.ssid, a.ssid, a.ssid_bytes);
+    if (memcmp(a.bssid, "\0\0\0\0\0\0", 6)) {
+        request.join.bssid_valid = 1; memcpy(request.join.bssid, a.bssid, 6);
+    }
+    if (!a.auth_upper && !a.key_bytes) request.join.security = PeachStationOpen;
+    else if (a.auth_upper == 8 && a.key_cipher == 6 && a.key_bytes == 32) {
+        request.join.security = PeachStationWpa2Psk; memcpy(request.join.pmk, a.key, 32);
+    } else if (a.auth_upper == 8 && a.key_cipher == 10 && a.key_bytes >= 8 && a.key_bytes <= 63) {
+        request.join.security = PeachStationWpa2Psk; request.passphrase_bytes = a.key_bytes;
+        memcpy(request.passphrase, a.key, a.key_bytes);
+    } else { err = EOPNOTSUPP; goto done; }
+    err = peach_net_request(&request);
+done:
+    erase(&a, sizeof(a)); erase(&request, sizeof(request)); return err;
+}
+static int set(const AppleRequest *r)
+{
+    if (r->type == 20) return join(r);
+    if (r->type == 22) {
+        PeachNetInfo info; peach_net_info(&info);
+        if (info.state == PeachNetReady || info.state == PeachNetScanning ||
+            info.state == PeachNetRecovering) return 0;
+        PeachNetRequest request = { .action = PeachControlLeave };
+        return peach_net_request(&request);
+    }
+    if (r->type == 10) {
+        if (r->length != sizeof(AppleScanRequest)) return EINVAL;
+        AppleScanRequest *a = kalloc_data(sizeof(*a), Z_WAITOK);
+        if (!a) return ENOMEM;
+        int err = copyin(r->data, a, sizeof(*a));
+        if (!err && (a->version != 1 || a->ssid_bytes > 32 || a->channel_count > 400 ||
+            a->name_count > 10 || (a->scan_type != 1 && a->scan_type != 2))) err = EINVAL;
+        /* Backend performs a full passive scan. It never transmits probes
+         * or overrides the firmware's board-specific regulatory rules. */
+        if (!err) { PeachNetRequest request = { .action = PeachControlScan }; err = peach_net_request(&request); }
+        kfree_data(a, sizeof(*a)); return err;
+    }
+    if (r->type == 383) {
+        /* iOS 16 hides its second scan entry point behind an undocumented set
+         * (4104 bytes, i.e. a 4096-byte body plus a header). wifid was aborting
+         * half a second after this call returned EOPNOTSUPP, and the join it
+         * was asked for never reached the driver, so treat it as a scan and
+         * dump the header once: if the guess is wrong the hex says what it is
+         * without another build. */
+        unsigned char head[32] = {0};
+        if (r->length >= 8 && r->data) (void)copyin(r->data, head, sizeof(head));
+        static unsigned dumps;
+        if (dumps < 4) {
+            dumps++;
+            printf("NEZHA WIFI: set 383 length %u head %02x%02x%02x%02x %02x%02x%02x%02x "
+                "%02x%02x%02x%02x %02x%02x%02x%02x\n", r->length,
+                head[0], head[1], head[2], head[3], head[4], head[5], head[6], head[7],
+                head[8], head[9], head[10], head[11], head[12], head[13], head[14], head[15]);
+        }
+        PeachNetRequest request = { .action = PeachControlScan };
+        return peach_net_request(&request);
+    }
+    if (r->type == 19) {
+        uint32_t power[6];
+        if (r->length < sizeof(power)) return EINVAL;
+        int err = copyin(r->data, power, sizeof(power));
+        if (err) return err;
+        PeachNetInfo info; peach_net_info(&info);
+        /* Idempotent power-on only. Do not acknowledge power-off or
+         * restart before hardware teardown/drain has been implemented. */
+        return power[0] == 1 && power[1] == 1 && power[2] == 1 && info.powered &&
+            info.state != PeachNetFailed ? 0 : EOPNOTSUPP;
+    }
+    return EOPNOTSUPP;
+}
+/* Every request wifid makes arrives here. One line per call, capped so a long
+ * browsing session cannot flood the 4 MB ring: a userspace abort leaves the
+ * last line before it as the only evidence of what it was asking for, and the
+ * deduped "first of each type" scheme used before went silent exactly during
+ * the switch that crashed wifid. */
+static unsigned apple_calls;
+#define APPLE_CALL_LINES 6000u
+static int apple_ioctl(u_long command, void *data)
+{
+    if (command != APPLE_SET && command != APPLE_GET) return EOPNOTSUPP;
+    AppleRequest *r = data;
+    if (!r || strncmp(r->interface, "en0", sizeof(r->interface))) return ENXIO;
+    if (command == APPLE_SET) {
+        int err = proc_suser(current_proc());
+        return err ? err : set(r);
+    }
+    return get(r);
+}
+int peach_apple80211_ioctl(u_long command, void *data)
+{
+    int err = apple_ioctl(command, data);
+    AppleRequest *r = data;
+    if (!r || (command != APPLE_SET && command != APPLE_GET)) return err;
+    if (apple_calls < APPLE_CALL_LINES) {
+        unsigned n = ++apple_calls;
+        printf("NEZHA WIFI: a80211 %u %s type %d length %u -> %d\n", n,
+            command == APPLE_SET ? "set" : "get", r->type, r->length, err);
+        if (n == APPLE_CALL_LINES) printf("NEZHA WIFI: a80211 log full after %u calls\n", n);
+    }
+    return err;
+}
+static void post(unsigned code, const void *data, unsigned bytes)
+{
+    char name[16] = "en0";
+    struct kev_msg message = { .vendor_code = KEV_VENDOR_APPLE, .kev_class = KEV_IEEE80211_CLASS,
+        .kev_subclass = 1, .event_code = code };
+    message.dv[0].data_ptr = name; message.dv[0].data_length = sizeof(name);
+    message.dv[1].data_ptr = (void *)data; message.dv[1].data_length = bytes;
+    (void)kev_post_msg(&message);
+}
+void peach_apple80211_event(unsigned code)
+{
+    if (code == PeachAppleScanDone) {
+        lck_mtx_lock(&apple_lock); result_next = 0; result_generation++; lck_mtx_unlock(&apple_lock);
+    }
+    post(code, NULL, 0);
+}
+void peach_apple80211_link(unsigned status, int rssi)
+{
+    AppleLink link = { .down = status != 1, .rssi = status == 1 ? rssi : 0,
+        .involuntary = status > 1, .reason = status > 1 ? 4 : 0 };
+    post(2, NULL, 0); post(3, NULL, 0); post(4, &link, sizeof(link));
+}
diff --git a/bsd/dev/qcom/PeachApple80211.h b/bsd/dev/qcom/PeachApple80211.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/qcom/PeachApple80211.h
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PEACH_APPLE80211_H
+#define PEACH_APPLE80211_H
+#include <sys/types.h>
+enum { PeachAppleScanDone = 10, PeachAppleJoinDone = 9 };
+int peach_apple80211_ioctl(u_long, void *);
+void peach_apple80211_event(unsigned);
+void peach_apple80211_link(unsigned status, int rssi); /* 0 manual down, 1 up, 2 lost */
+#endif
diff --git a/bsd/dev/qcom/PeachCe.c b/bsd/dev/qcom/PeachCe.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/qcom/PeachCe.c
@@ -0,0 +1,239 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Register fields: fw-api/hw/peach/v2/soc_ce_seq_hwioreg.h and ce_*_desc.h.
+ * Ownership/assignment: hif/src/ce/{ce_assignment.h,ce_main.c}; SRNG setup:
+ * hal/wifi3.0/{hal_generic_api.h,hal_srng.c}. No Linux ABI is used. */
+#include "PeachCe.h"
+#if defined(KERNEL)
+#include <libkern/libkern.h>
+#else
+#include <string.h>
+#endif
+
+const PeachCeTarget peach_ce_target[9] = {
+    {0, 2, 32, 2048, 0}, {1, 1, 32, 2048, 0},
+    {2, 1, 32, 3520, 0}, {3, 2, 32, 3520, 0},
+    {4, 2, 256, 256, 8}, {5, 1, 0, 2048, 0},
+    {6, 3, 32, 16384, 0}, {7, 4, 0, 0, 8}, {8, 3, 32, 16384, 0},
+};
+const PeachCeService peach_ce_services[15] = {
+    {0x101, 2, 3}, {0x101, 1, 2}, {0x102, 2, 3}, {0x102, 1, 2},
+    {0x103, 2, 3}, {0x103, 1, 2}, {0x104, 2, 3}, {0x104, 1, 2},
+    {0x100, 2, 3}, {0x100, 1, 2}, {1, 2, 0}, {1, 1, 2},
+    {0x300, 2, 4}, {0x300, 1, 1}, {0, 0, 0},
+};
+/* SRNG pointers and lengths are in dwords, never byte addresses. */
+enum { CE_BASE = 0x01b80000, STRIDE = 0x2000, ENABLE = 0x40 };
+#define CTRY(c, expr) do { int err_ = (expr); if (err_) { (c)->error = err_; return err_; } } while (0)
+static uint32_t get32(const void *p) { uint32_t v; memcpy(&v, p, 4); return v; }
+static void put32(void *p, uint32_t v) { memcpy(p, &v, 4); }
+static void barrier(PeachCe *c) { c->ops.barrier(c->ops.context); }
+static int read32(PeachCe *c, uint32_t r, uint32_t *v)
+{
+    c->last_register = r;
+    int err = c->ops.read32(c->ops.context, r, v);
+    c->last_value = err ? 0xffffffffu : *v;
+    return err;
+}
+static int write32(PeachCe *c, uint32_t r, uint32_t v)
+{
+    c->last_register = r; c->last_value = v;
+    return c->ops.write32(c->ops.context, r, v);
+}
+static int invalid(PeachCe *c) { return c->error = PeachCeProtocol; }
+
+static int carve(PeachCe *c, size_t *used, size_t bytes, PeachMhiDma *out)
+{
+    size_t start = (*used + 63) & ~(size_t)63;
+    if (start > c->memory.capacity || bytes > c->memory.capacity - start) return PeachMhiInvalid;
+    *out = (PeachMhiDma){(unsigned char *)c->memory.bytes + start, c->memory.iova + start, bytes};
+    *used = start + bytes;
+    return 0;
+}
+static int prepare_ring(PeachCe *c, PeachCeRing *r, size_t *used,
+                         uint32_t base, uint32_t doorbell, unsigned n, unsigned dw)
+{
+    r->base = base; r->doorbell = doorbell; r->entries = n; r->dwords = dw;
+    CTRY(c, carve(c, used, n * dw * 4, &r->descriptors));
+    return carve(c, used, 4, &r->pointer);
+}
+int peach_ce_prepare(PeachCe *c, PeachMhiDma memory, const PeachCeOps *ops)
+{
+    if (!c || !ops || !ops->read32 || !ops->write32 || !ops->barrier ||
+        !ops->receive || !memory.bytes || ((uintptr_t)memory.bytes & 63) ||
+        (memory.iova & 63) || memory.capacity < PEACH_CE_DMA_BYTES ||
+        memory.iova >= 0x100000000ull || memory.capacity > 0x100000000ull - memory.iova)
+        return PeachMhiInvalid;
+    memset(c, 0, sizeof(*c)); c->ops = *ops; c->memory = memory;
+    memset(memory.bytes, 0, PEACH_CE_DMA_BYTES);
+    const unsigned entries[5] = {16, 512, 256, 32, 256};
+    const unsigned limits[5] = {2048, 2048, 3520, 3520, 256};
+    size_t used = 0;
+    for (unsigned i = 0; i < PEACH_CE_CHANNELS; i++) {
+        PeachCeChannel *ch = &c->channel[i];
+        ch->receive = i == 1 || i == 2; ch->limit = limits[i];
+        uint32_t base = CE_BASE + i * STRIDE + (ch->receive ? 0x1000 : 0);
+        CTRY(c, prepare_ring(c, &ch->ring, &used, base, base + 0x400,
+            entries[i], ch->receive ? 2 : 4));
+        if (ch->receive)
+            CTRY(c, prepare_ring(c, &ch->status, &used, base + 0x58,
+                base + 0x408, entries[i], 4));
+        CTRY(c, carve(c, &used, entries[i] * limits[i], &ch->buffers));
+    }
+    barrier(c); c->prepared = 1;
+    return 0;
+}
+
+static int start_ring(PeachCe *c, PeachCeRing *r, unsigned status, unsigned ringid)
+{
+    uint32_t v;
+    CTRY(c, read32(c, r->base + 0x10, &v));
+    /* A freshly reset host-owned CE must be inactive. Never overwrite a
+     * live ring, including if firmware ownership differs from this ABI. */
+    if (v == 0xffffffffu || (v & ENABLE)) return invalid(c);
+    CTRY(c, write32(c, r->base + 0x10, 0));
+    CTRY(c, write32(c, r->base, (uint32_t)r->descriptors.iova));
+    CTRY(c, write32(c, r->base + 4, (r->entries * r->dwords) << 8));
+    CTRY(c, write32(c, r->base + 8, r->dwords | (status ? ringid << 8 : 0)));
+    /* Explicitly turn off prior MSI state and timer/threshold interrupts. */
+    CTRY(c, write32(c, r->base + 0x4c, 0));
+    CTRY(c, write32(c, r->base + (status ? 0x24 : 0x30), 0));
+    if (!status) CTRY(c, write32(c, r->base + 0x34, 0));
+    CTRY(c, write32(c, r->base + (status ? 0x14 : 0x1c), (uint32_t)r->pointer.iova));
+    CTRY(c, write32(c, r->base + (status ? 0x18 : 0x20), 0));
+    CTRY(c, write32(c, r->doorbell, 0));
+    CTRY(c, write32(c, r->doorbell + 4, 0));
+    barrier(c);
+    CTRY(c, write32(c, r->base + 0x10, ENABLE | (status ? 0 : 2)));
+    CTRY(c, read32(c, r->base + 0x10, &v));
+    if ((v & 0x7f) != (ENABLE | (status ? 0u : 2u))) return invalid(c);
+    return 0;
+}
+static void post_rx(PeachCeChannel *ch, unsigned buffer)
+{
+    PeachCeRing *r = &ch->ring;
+    unsigned char *d = (unsigned char *)r->descriptors.bytes + r->wp * 8;
+    uint64_t addr = ch->buffers.iova + (uint64_t)buffer * ch->limit;
+    put32(d, (uint32_t)addr); put32(d + 4, (uint32_t)(addr >> 32));
+    r->wp = (r->wp + 1) & (r->entries - 1);
+}
+int peach_ce_start(PeachCe *c)
+{
+    if (!c || !c->prepared || c->started) return PeachMhiInvalid;
+    if (c->error) return c->error;
+    for (unsigned i = 0; i < PEACH_CE_CHANNELS; i++) {
+        PeachCeChannel *ch = &c->channel[i];
+        if (ch->receive) {
+            uint32_t v;
+            CTRY(c, read32(c, ch->ring.base + 0xb0, &v));
+            CTRY(c, write32(c, ch->ring.base + 0xb0, (v & ~0xffffu) | ch->limit));
+            CTRY(c, start_ring(c, &ch->status, 1, 100 + i));
+        }
+        CTRY(c, start_ring(c, &ch->ring, 0, 0));
+        if (ch->receive) {
+            /* Vendor CE workaround leaves two entries unposted. Buffers are
+             * reclaimed in order; rp identifies the next completed buffer. */
+            for (unsigned j = 0; j < ch->ring.entries - 2; j++) post_rx(ch, j);
+            barrier(c);
+            CTRY(c, write32(c, ch->ring.doorbell, ch->ring.wp * ch->ring.dwords));
+        }
+    }
+    c->started = 1;
+    return 0;
+}
+
+static int hardware_index(PeachCe *c, PeachCeRing *r, unsigned *index)
+{
+    barrier(c);
+    uint32_t dw = *(volatile uint32_t *)r->pointer.bytes;
+    if (dw >= r->entries * r->dwords || dw % r->dwords) return invalid(c);
+    *index = dw / r->dwords;
+    barrier(c);
+    return 0;
+}
+static int reap_tx(PeachCe *c, PeachCeRing *r)
+{
+    unsigned tail;
+    CTRY(c, hardware_index(c, r, &tail));
+    unsigned complete = (tail - r->rp) & (r->entries - 1);
+    unsigned posted = (r->wp - r->rp) & (r->entries - 1);
+    if (complete > posted) return invalid(c);
+    r->rp = tail;
+    return 0;
+}
+int peach_ce_send(PeachCe *c, unsigned pipe, unsigned metadata, const void *p, size_t n)
+{
+    if (!c || !c->started || pipe >= PEACH_CE_CHANNELS || !p || !n || metadata > 0xffff)
+        return PeachMhiInvalid;
+    if (c->error) return c->error;
+    PeachCeChannel *ch = &c->channel[pipe];
+    PeachCeRing *r = &ch->ring;
+    if (ch->receive || n > ch->limit) return PeachMhiInvalid;
+    CTRY(c, reap_tx(c, r));
+    unsigned next = (r->wp + 1) & (r->entries - 1);
+    if (next == r->rp) return PeachCeFull;
+    size_t off = r->wp * ch->limit;
+    memcpy((unsigned char *)ch->buffers.bytes + off, p, n);
+    unsigned char *d = (unsigned char *)r->descriptors.bytes + r->wp * 16;
+    uint64_t addr = ch->buffers.iova + off;
+    put32(d, (uint32_t)addr); put32(d + 4, (uint32_t)(addr >> 32) | (uint32_t)n << 16);
+    put32(d + 8, metadata); put32(d + 12, 0);
+    barrier(c); r->wp = next;
+    CTRY(c, write32(c, r->doorbell, r->wp * r->dwords));
+    return 0;
+}
+
+static int receive_one(PeachCe *c, unsigned pipe, unsigned *received)
+{
+    PeachCeChannel *ch = &c->channel[pipe];
+    PeachCeRing *s = &ch->status, *r = &ch->ring;
+    unsigned head;
+    CTRY(c, hardware_index(c, s, &head));
+    if (head == s->rp) return 0;
+    unsigned char *d = (unsigned char *)s->descriptors.bytes + s->rp * 16;
+    uint32_t info = get32(d), meta = get32(d + 12);
+    unsigned n = info >> 16;
+    /* Hardware can publish HP just before the status length becomes visible.
+     * Defer rather than consume an incomplete descriptor (vendor CE race). */
+    if (!n) return 0;
+    if (n > ch->limit || (info & 0x1f00) || ((meta >> 20) & 0xff) != 100 + pipe)
+        return invalid(c);
+    unsigned buffer = r->rp;
+    c->ops.receive(c->ops.receive_context, pipe,
+        (unsigned char *)ch->buffers.bytes + buffer * ch->limit, n);
+    put32(d, 0);
+    s->rp = (s->rp + 1) & (s->entries - 1);
+    /* Move this consumed buffer into the next free descriptor. The buffer
+     * sequence remains in-order even though two ring entries stay empty. */
+    /* Only entries-2 buffers circulate; r->rp is a buffer index on RX. */
+    r->rp++;
+    if (r->rp == r->entries - 2) r->rp = 0;
+    post_rx(ch, buffer);
+    barrier(c);
+    CTRY(c, write32(c, s->doorbell + 4, s->rp * s->dwords));
+    CTRY(c, write32(c, r->doorbell, r->wp * r->dwords));
+    *received = 1;
+    return 0;
+}
+int peach_ce_poll(PeachCe *c, unsigned budget)
+{
+    if (!c || !c->started || !budget || c->polling) return PeachMhiInvalid;
+    if (c->error) return c->error;
+    c->polling = 1;
+    int err = 0;
+    for (unsigned i = 0; i < PEACH_CE_CHANNELS && !err; i++)
+        if (!c->channel[i].receive) err = reap_tx(c, &c->channel[i].ring);
+    for (unsigned done = 0; done < budget && !err;) {
+        unsigned received = 0;
+        unsigned pipe = 1 + (c->next_channel++ & 1);
+        err = receive_one(c, pipe, &received);
+        if (err) break;
+        if (!received) {
+            pipe = 3 - pipe;
+            err = receive_one(c, pipe, &received);
+            if (!received) break;
+        }
+        done += received;
+    }
+    c->polling = 0;
+    return err;
+}
diff --git a/bsd/dev/qcom/PeachCe.h b/bsd/dev/qcom/PeachCe.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/qcom/PeachCe.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PEACH_CE_H
+#define PEACH_CE_H
+#include "PeachMhiFirmware.h"
+
+/* Peach v2 register/descriptor ABI, Kiwi CE assignment selected by the
+ * vendor's TARGET_TYPE_PEACH path. CE9-11 belong to MHI and are never touched.
+ * One worker owns all rings. Callbacks may copy/parse; they must not wait,
+ * recursively poll, or keep the borrowed RX buffer after returning. */
+#define PEACH_CE_DMA_BYTES 0x220000u
+#define PEACH_CE_CHANNELS 5u
+enum { PeachCeFull = -6, PeachCeProtocol = -20 };
+typedef struct { uint32_t pipe, direction, entries, max_bytes, flags; } PeachCeTarget;
+typedef struct { uint32_t service, direction, pipe; } PeachCeService;
+extern const PeachCeTarget peach_ce_target[9];
+extern const PeachCeService peach_ce_services[15];
+
+typedef struct {
+    void *context;
+    /* Target register offsets, not BAR offsets. The platform supplies the
+     * Peach PCI aperture, bus-fault containment and own-domain DMA checks. */
+    int (*read32)(void *, uint32_t, uint32_t *);
+    int (*write32)(void *, uint32_t, uint32_t);
+    void (*barrier)(void *);
+    void (*receive)(void *, unsigned pipe, const void *, size_t);
+    void *receive_context;
+} PeachCeOps;
+
+typedef struct {
+    PeachMhiDma descriptors, pointer;
+    uint32_t base, doorbell;
+    unsigned entries, dwords, wp, rp;
+} PeachCeRing;
+typedef struct {
+    PeachCeRing ring, status;
+    PeachMhiDma buffers;
+    unsigned limit, receive;
+} PeachCeChannel;
+typedef struct {
+    PeachCeOps ops;
+    PeachMhiDma memory;
+    PeachCeChannel channel[PEACH_CE_CHANNELS];
+    unsigned prepared, started, polling, next_channel;
+    uint32_t last_register, last_value;
+    int error;
+} PeachCe;
+
+/* Prepare DMA first; WLFW WLAN_CFG/MISSION precede hardware ring setup, as
+ * hif_pci_bus_configure does. DMA must be zeroed, coherent and retained. */
+int peach_ce_prepare(PeachCe *, PeachMhiDma, const PeachCeOps *);
+int peach_ce_start(PeachCe *);
+int peach_ce_poll(PeachCe *, unsigned budget);
+/* Copies into retained per-slot DMA; completion is reaped before reuse. */
+int peach_ce_send(PeachCe *, unsigned pipe, unsigned metadata, const void *, size_t);
+#endif
