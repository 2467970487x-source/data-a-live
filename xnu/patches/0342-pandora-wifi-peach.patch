+ * THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ * ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION
+ * OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN
+ * CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+#include "PeachRx.h"
+#if defined(KERNEL)
+#include <libkern/libkern.h>
+#else
+#include <string.h>
+#endif
+
+#define RTRY(r, expr) do { int err_ = (expr); if (err_) { (r)->error = err_; return err_; } } while (0)
+#define REO_BASE 0x00a38000u
+#define WBM_BASE 0x00a34000u
+#define RX_RBM 8u /* Peach single-PDEV RX release -> WBM2SW3. */
+static uint32_t u32(const void *p) { uint32_t v; memcpy(&v, p, 4); return v; }
+static PeachSrngOps *ops(PeachRx *r) { return &r->rings[PeachSrngReoRx].ops; }
+static void barrier(PeachRx *r) { ops(r)->barrier(ops(r)->context); }
+static int health(PeachRx *r) { return ops(r)->health(ops(r)->context); }
+static int invalid(PeachRx *r) { return r->error = PeachCeProtocol; }
+static int rd(PeachRx *r, uint32_t reg, uint32_t *value)
+{
+    r->last_register = reg;
+    int err = ops(r)->read32(ops(r)->context, reg, value);
+    r->last_value = err ? 0xffffffffu : *value;
+    if (!err && *value == 0xffffffffu) return PeachCeProtocol;
+    return err;
+}
+static int wr(PeachRx *r, uint32_t reg, uint32_t value)
+{
+    r->last_register = reg; r->last_value = value;
+    return ops(r)->write32(ops(r)->context, reg, value);
+}
+static int update(PeachRx *r, uint32_t reg, uint32_t mask, uint32_t value)
+{
+    uint32_t old, check;
+    RTRY(r, rd(r, reg, &old));
+    RTRY(r, wr(r, reg, (old & ~mask) | value));
+    RTRY(r, rd(r, reg, &check));
+    return (check & mask) == value ? 0 : invalid(r);
+}
+PeachMhiDma peach_rx_queue(const PeachRx *r, unsigned tid)
+{
+    if (!r || !r->prepared || tid > 16) return (PeachMhiDma){0};
+    return (PeachMhiDma){(unsigned char *)r->queues.bytes + tid * 512u,
+        r->queues.iova + tid * 512u, tid == 16 ? 128 : 512};
+}
+static void prepare_queues(PeachRx *r)
+{
+    /* rx_reo_queue/ext are 128B each, aligned to 128B. The QoS queues
+     * retain all three extensions, matching hal_get_reo_qdesc_size_be.
+     * Non-QoS TID 16 uses only the base descriptor. */
+    for (unsigned tid = 0; tid <= 16; tid++) {
+        uint32_t *p = peach_rx_queue(r, tid).bytes;
+        unsigned ac = (tid == 0 || tid == 3) ? 0 :
+                      (tid == 1 || tid == 2) ? 1 : (tid == 4 || tid == 5) ? 2 : 3;
+        p[0] = 4u | 8u << 4 | 0xddbeefu << 8; /* REO owner / queue */
+        p[1] = tid;
+        p[2] = 1u | 1u << 1 | ac << 5 | 1u << 27; /* valid/counter1/ignore AMPDU */
+        /* hal_update_non_ba_win_size: QoS window 2, non-QoS window 1.
+         * SSN/SVLD remain zero, PN checking is not enabled yet. */
+        p[2] |= tid == 16 ? 1u << 8 : 1u << 11;
+        if (tid != 16) {
+            static const uint32_t pattern[] = {0xadbeef, 0xbdbeef, 0xcdbeef};
+            for (unsigned i = 0; i < 3; i++)
+                p[(i + 1) * 32] = 4u | 10u << 4 | pattern[i] << 8;
+        }
+    }
+}
+int peach_rx_prepare(PeachRx *r, PeachSrng rings[PeachSrngKinds], PeachMhiDma memory)
+{
+    if (!r || !rings || !memory.bytes || !memory.iova ||
+        ((uintptr_t)memory.bytes & 127) || (memory.iova & 127) ||
+        memory.capacity < PEACH_RX_DMA_BYTES || memory.iova >= 0x100000000ull ||
+        PEACH_RX_DMA_BYTES > 0x100000000ull - memory.iova) return PeachMhiInvalid;
+    for (unsigned i = 0; i < PeachSrngKinds; i++) {
+        if (!rings[i].prepared || rings[i].started || rings[i].error)
+            return PeachMhiInvalid;
+        PeachMhiDma d = rings[i].memory;
+        if (d.iova < memory.iova + PEACH_RX_DMA_BYTES &&
+            memory.iova < d.iova + d.capacity) return PeachMhiInvalid;
+    }
+    memset(r, 0, sizeof(*r)); r->rings = rings; r->memory = memory;
+    RTRY(r, health(r));
+    memset(memory.bytes, 0, PEACH_RX_DMA_BYTES);
+    size_t off = PEACH_RX_LINKS * 128u;
+    r->links = (PeachMhiDma){memory.bytes, memory.iova, off};
+    r->queues = (PeachMhiDma){(unsigned char *)memory.bytes + off,
+        memory.iova + off, PEACH_RX_QUEUE_BYTES};
+    off += PEACH_RX_QUEUE_BYTES;
+    r->buffers = (PeachMhiDma){(unsigned char *)memory.bytes + off,
+        memory.iova + off, PEACH_RX_BUFFERS * PEACH_RX_BUFFER_BYTES};
+    r->prepared = 1; prepare_queues(r); barrier(r);
+    /* No kernel virtual-address cookie conversion. Preserve unrelated
+     * register fields; this endpoint is solely owned by this driver. */
+    RTRY(r, update(r, REO_BASE + 0x70, 0x180000, 0));
+    RTRY(r, update(r, WBM_BASE + 0x94, 0x1ff, 0));
+    /* Enable aging, preserving firmware-owned REO/ring enable bits. */
+    RTRY(r, update(r, REO_BASE, 0xc, 0xc));
+    for (unsigned i = 0; i < 4; i++)
+        RTRY(r, wr(r, REO_BASE + 0xb2c + i * 4, i == 3 ? 40000 : 100000));
+    /* Route hash destinations 16..31 to the sole REO2SW1 ring. Drop/reclaim
+     * fragmented traffic via WBM (destination 5); no software defragmenter. */
+    RTRY(r, wr(r, REO_BASE + 0xc, 0x11111111));
+    RTRY(r, wr(r, REO_BASE + 0x10, 0x11111111));
+    RTRY(r, update(r, REO_BASE + 0xba0, 0x1e0000 | 0x1e00000, 5u << 17));
+    return 0;
+}
+static int replenish(PeachRx *r)
+{
+    if (!r->repost) return 0;
+    for (unsigned i = 0; i < PEACH_RX_BUFFERS; i++) {
+        if (r->owned[i]) continue;
+        RTRY(r, health(r));
+        unsigned char *p = (unsigned char *)r->buffers.bytes + i * PEACH_RX_BUFFER_BYTES;
+        /* Clear old tags/MSDU_DONE before firmware can take this buffer. */
+        memset(p, 0, PEACH_HTT_RX_PACKET_OFFSET);
+        unsigned previous = r->cookies[i], generation = (previous >> 8) + 1;
+        if (generation > 4095) generation = 1;
+        r->cookies[i] = generation << 8 | i;
+        uint32_t entry[2] = {(uint32_t)(r->buffers.iova + i * PEACH_RX_BUFFER_BYTES),
+            RX_RBM << 8 | r->cookies[i] << 12};
+        /* Mark ownership before publishing, including ambiguous failure. */
+        r->owned[i] = 1; r->in_flight++;
+        int err = peach_srng_push(&r->rings[PeachSrngRxBuffer], entry, sizeof(entry));
+        if (err == PeachCeFull) {
+            r->owned[i] = 0; r->in_flight--; r->cookies[i] = previous; return 0;
+        }
+        if (err) return r->error = err;
+        r->repost--;
+    }
+    return 0;
+}
+int peach_rx_new_queues(PeachRx *r, PeachMhiDma memory)
+{
+    if (!r || !r->prepared || !memory.bytes || !memory.iova ||
+        ((uintptr_t)memory.bytes & 127) || (memory.iova & 127) ||
+        memory.capacity < PEACH_RX_QUEUE_BYTES || memory.iova >= 0x100000000ull ||
+        PEACH_RX_QUEUE_BYTES > 0x100000000ull - memory.iova ||
+        (memory.iova < r->memory.iova + r->memory.capacity &&
+         r->memory.iova < memory.iova + PEACH_RX_QUEUE_BYTES) ||
+        (memory.iova < r->queues.iova + r->queues.capacity &&
+         r->queues.iova < memory.iova + PEACH_RX_QUEUE_BYTES)) return PeachMhiInvalid;
+    if (r->error) return r->error;
+    RTRY(r, health(r));
+    r->queues = memory;
+    memset(memory.bytes, 0, PEACH_RX_QUEUE_BYTES);
+    prepare_queues(r); barrier(r);
+    return 0;
+}
+int peach_rx_start(PeachRx *r, PeachHtt *h, unsigned pdev, unsigned peer_metadata_version)
+{
+    if (!r || !r->prepared || r->started || !h || !peer_metadata_version ||
+        peer_metadata_version > 2) return PeachMhiInvalid;
+    if (r->error) return r->error;
+    for (unsigned i = 0; i < PeachSrngKinds; i++)
+        if (!r->rings[i].started || r->rings[i].error) return PeachMhiInvalid;
+    /* The idle link pool is published before WMI INIT, alongside host
+     * TCL/WBM rings; firmware initialization may already reference it. */
+    if (r->rings[PeachSrngIdleLink].wp != PEACH_RX_LINKS) return PeachMhiInvalid;
+    RTRY(r, peach_htt_config_rx(h, pdev, PEACH_RX_BUFFER_BYTES));
+    r->repost = PEACH_RX_BUFFERS;
+    RTRY(r, replenish(r));
+    r->peer_metadata_version = peer_metadata_version; r->started = 1;
+    return 0;
+}
+static int buffer_index(PeachRx *r, uint32_t low, unsigned high, unsigned cookie, unsigned *index)
+{
+    unsigned i = cookie & 255;
+    uint64_t address = low | (uint64_t)high << 32;
+    if (!cookie || cookie != r->cookies[i] || !r->owned[i] ||
+        address != r->buffers.iova + i * PEACH_RX_BUFFER_BYTES)
+        return invalid(r);
+    *index = i;
+    return 0;
+}
+static void release(PeachRx *r, unsigned i)
+{ r->owned[i] = 0; r->in_flight--; r->repost++; }
+static int tag_valid(uint32_t word, unsigned tag, unsigned bytes)
+{ return ((word >> 1) & 511) == tag && ((word >> 10) & 4095) == bytes; }
+static int reap_link(PeachRx *r, uint32_t low, uint32_t info)
+{
+    unsigned char visited[(PEACH_RX_LINKS + 7) / 8] = {0};
+    unsigned total = 0;
+    for (unsigned limit = 0; limit < PEACH_RX_LINKS; limit++) {
+        unsigned cookie = info >> 12;
+        uint64_t address = low | (uint64_t)(info & 255) << 32;
+        if (cookie >= PEACH_RX_LINKS || ((info >> 8) & 15) != 1 ||
+            address != r->links.iova + cookie * 128u ||
+            (visited[cookie / 8] & (1u << (cookie & 7)))) return invalid(r);
+        visited[cookie / 8] |= 1u << (cookie & 7);
+        RTRY(r, health(r)); barrier(r);
+        uint32_t *p = (uint32_t *)((unsigned char *)r->links.bytes + cookie * 128u);
+        uint32_t link[32]; memcpy(link, p, sizeof(link)); barrier(r);
+        unsigned indices[6], count = 0;
+        /* Peach rx_msdu_link: next buffer_addr_info at DWORD1, six
+         * 16-byte rx_msdu_details starting at DWORD8. Like the vendor HAL,
+         * a zero packet address terminates the list; MPDU count is advisory. */
+        for (unsigned j = 0; j < 6; j++) {
+            unsigned word = 8 + j * 4;
+            if (!link[word] && !(link[word + 1] & 255)) break;
+            if (((link[word + 1] >> 8) & 15) != RX_RBM) return invalid(r);
+            RTRY(r, buffer_index(r, link[word], link[word + 1] & 255,
+                link[word + 1] >> 12, &indices[j]));
+            for (unsigned k = 0; k < j; k++)
+                if (indices[k] == indices[j]) return invalid(r);
+            count++;
+        }
+        if (!count || total + count > PEACH_RX_BUFFERS) return invalid(r);
+        uint32_t entry[8] = {low, info, 4u | 1u << 6}; /* SW/MSDU link, idle-list action 0 */
+        /* Clear stale next/packet pointers while SW owns the descriptor.
+         * WBM only returns this link to its idle list; it does not release
+         * packet children again. We retain their memory and repost later. */
+        memset(p, 0, sizeof(link)); barrier(r);
+        RTRY(r, peach_srng_push(&r->rings[PeachSrngWbmRelease], entry, sizeof(entry)));
+        for (unsigned j = 0; j < count; j++) release(r, indices[j]);
+        r->discarded += count; total += count;
+        low = link[1]; info = link[2];
+        if (!low && !(info & 255)) return 0;
+    }
+    return invalid(r);
+}
+static int reap_reo(PeachRx *r, const uint32_t d[8], PeachReceive receive, void *ctx)
+{
+    if (d[7] & 1) return reap_link(r, d[0], d[1]);
+    unsigned i;
+    if (((d[1] >> 8) & 15) != RX_RBM) return invalid(r);
+    RTRY(r, buffer_index(r, d[0], d[1] & 255, d[1] >> 12, &i));
+    RTRY(r, health(r)); barrier(r);
+    unsigned char *p = (unsigned char *)r->buffers.bytes + i * PEACH_RX_BUFFER_BYTES;
+    /* Normal REO2SW is MSDU memory with full noncompacted TLVs. A format
+     * mismatch is a firmware/host ABI failure, not an empty receive queue. */
+    if (!(u32(p + 4 + 0x7c) & 0x80000000u) ||
+        !tag_valid(u32(p), 197, 128) ||
+        !tag_valid(u32(p + PEACH_HTT_RX_MPDU_OFFSET), 194, 120)) return invalid(r);
+    barrier(r);
+    unsigned length = (d[4] >> 3) & 0x3fff;
+    unsigned padding = (u32(p + 4 + 0x28) >> 26) & 3;
+    unsigned offset = PEACH_HTT_RX_PACKET_OFFSET + padding;
+    /* Bad over-air packets are dropped. This minimal path accepts complete
+     * Ethernet-II MSDUs; no cross-buffer continuation or raw 802.11 input. */
+    unsigned drop = ((d[7] >> 1) & 3) != 1 || (d[2] & 0x100) ||
+        (d[4] & (4 | 0x20000)) || ((d[4] >> 29) & 3) != 2 ||
+        ((u32(p + 4 + 0x4c) >> 8) & 3) != 2 ||
+        (u32(p + 4 + 0x78) & 0xf8039000u) ||
+        length < 14 || length > PEACH_RX_BUFFER_BYTES - offset ||
+        length != (u32(p + 4 + 0x48) & 0x3fff);
+    const unsigned char *m = p + PEACH_HTT_RX_MPDU_OFFSET + 4;
+    uint32_t flags = u32(m + 0x20);
+    /* Only complete, nonaggregated infrastructure data. Preserve hardware
+     * encryption metadata so the connection owner can enforce its key/PN
+     * policy; Ethernet decapsulation alone does not authenticate a packet. */
+    drop |= (flags & 0x30009) != 0x10009 || (flags & 0x7c00) ||
+        (u32(m + 0x30) & 0x10000000u) || (u32(m + 0x34) & 0x40000000u);
+    PeachRxInfo info = {0};
+    info.peer = u32(m + 0x28) >> 16;
+    uint32_t peer_meta = u32(m + 0x24);
+    unsigned vdev_shift = r->peer_metadata_version == 2 ? 14 : 16;
+    /* RX_MPDU_START includes both the hardware SW peer and the negotiated
+     * host metadata. Only the local vdev and an ordinary link peer belong
+     * to this STA; ML peers and accelerator/passthrough frames are rejected. */
+    drop |= (peer_meta & 8191) != info.peer || (peer_meta & (1u << 13)) ||
+        ((peer_meta >> vdev_shift) & 255) ||
+        (r->peer_metadata_version == 2 && (peer_meta & 0xe0000000u));
+    info.tid = flags & 128 ? (u32(m + 4) >> 15) & 15 : 16;
+    info.encrypted = !!(flags & 0x40000);
+    info.cipher = (u32(m + 4) >> 2) & 15;
+    info.key_index = (u32(m + 0x30) >> 6) & 3;
+    info.multicast = !!(u32(p + 4 + 0x78) & 4);
+    info.decrypted = (flags & 0x200) && !((u32(p + 4 + 0x7c) >> 10) & 7);
+    info.pn = u32(m + 0x10) | (uint64_t)u32(m + 0x14) << 32;
+    memcpy(info.transmitter, m + 0x42, 6);
+    if (info.encrypted && (info.cipher != 6 || !info.decrypted ||
+        info.pn >= 0x1000000000000ull || u32(m + 0x18) || u32(m + 0x1c))) drop = 1;
+    int err = 0;
+    if (drop || !receive) r->discarded++;
+    else { r->received++; err = receive(ctx, p + offset, length, &info); }
+    release(r, i);
+    return err;
+}
+static int reap_wbm(PeachRx *r, const uint32_t d[8])
+{
+    /* RXDMA/REO error buffers need no completed MSDU_END tag. Like TX,
+     * WBM retains buffer_addr_info in DWORDs0/1 when CC is disabled;
+     * converted RX completions retain physical address/cookie at 6/7. */
+    unsigned source = d[2] & 7, converted = !!(d[2] & (1u << 16));
+    unsigned rbm = converted ? (d[2] >> 9) & 15 : (d[1] >> 8) & 15;
+    if ((source != 1 && source != 2) || (d[2] & 0x80000000u) ||
+        ((d[2] >> 6) & 7) != 0 || rbm != RX_RBM) return invalid(r);
+    unsigned i;
+    RTRY(r, buffer_index(r, converted ? d[6] : d[0],
+        (converted ? d[7] : d[1]) & 255,
+        converted ? (d[7] >> 8) & 0xfffff : d[1] >> 12, &i));
+    r->released++; release(r, i);
+    return 0;
+}
+int peach_rx_poll(PeachRx *r, PeachReceive receive, void *ctx)
+{
+    if (!r || !r->started) return 0;
+    if (r->error) return r->error;
+    static const unsigned kinds[] = {PeachSrngReoRx, PeachSrngReoException,
+                                     PeachSrngRxException, PeachSrngWbmCompletion};
+    for (unsigned ring = 0; ring < sizeof(kinds) / sizeof(kinds[0]); ring++) {
+        for (unsigned budget = 0; budget < 64; budget++) {
+            uint32_t d[8];
+            int err = peach_srng_pop(&r->rings[kinds[ring]], d, sizeof(d));
+            if (err == PeachSrngEmpty) break;
+            if (err) return r->error = err;
+            memcpy(r->last_descriptor, d, sizeof(d));
+            if (kinds[ring] == PeachSrngRxException) {
+                /* REO entrance format, always a link. A frameless BAR has
+                 * no packet/link address to return. */
+                if (!(d[0] | (d[1] & 255)) && (d[5] & (1u << 27))) continue;
+                RTRY(r, reap_link(r, d[0], d[1]));
+            } else RTRY(r, kinds[ring] == PeachSrngWbmCompletion ? reap_wbm(r, d) :
+                            reap_reo(r, d, receive, ctx));
+        }
+    }
+    return replenish(r);
+}
diff --git a/bsd/dev/qcom/PeachRx.h b/bsd/dev/qcom/PeachRx.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/qcom/PeachRx.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PEACH_RX_H
+#define PEACH_RX_H
+#include "PeachSrng.h"
+
+#define PEACH_RX_BUFFERS 256u
+#define PEACH_RX_BUFFER_BYTES 4096u
+#define PEACH_RX_LINKS 1023u
+#define PEACH_RX_QUEUE_BYTES (16u * 512u + 128u)
+#define PEACH_RX_DMA_BYTES (PEACH_RX_LINKS * 128u + PEACH_RX_QUEUE_BYTES + \
+                            PEACH_RX_BUFFERS * PEACH_RX_BUFFER_BYTES)
+
+typedef struct {
+    unsigned peer, tid, encrypted, cipher, key_index, multicast, decrypted;
+    uint64_t pn;
+    unsigned char transmitter[6];
+} PeachRxInfo;
+typedef int (*PeachReceive)(void *, const void *, size_t, const PeachRxInfo *);
+
+typedef struct {
+    PeachSrng *rings;
+    PeachMhiDma memory, links, queues, buffers;
+    unsigned prepared, started, repost, in_flight, peer_metadata_version;
+    unsigned char owned[PEACH_RX_BUFFERS];
+    uint32_t cookies[PEACH_RX_BUFFERS];
+    uint64_t received, discarded, released;
+    uint32_t last_register, last_value, last_descriptor[8];
+    int error;
+} PeachRx;
+
+/* One worker; no transient allocation. Queue descriptors are unbound until
+ * peer setup. Initial non-BA queues have PN disabled: protected peers need
+ * explicit PN/BA configuration before they can be connected. */
+int peach_rx_prepare(PeachRx *, PeachSrng rings[PeachSrngKinds], PeachMhiDma);
+/* Host rings and the idle link pool are started/seeded before WMI INIT.
+ * After HTT setup, this final step publishes packet buffers and filters. */
+int peach_rx_start(PeachRx *, PeachHtt *, unsigned pdev, unsigned peer_metadata_version);
+PeachMhiDma peach_rx_queue(const PeachRx *, unsigned tid);
+/* After peer retirement only: use fresh retained storage. Old descriptors
+ * may still be cached by REO and must never be cleared or reassigned. */
+int peach_rx_new_queues(PeachRx *, PeachMhiDma);
+/* Callback borrows a complete Ethernet MSDU only until it returns. No data
+ * callback means discard; configuring RX does not publish a NIC. Linked
+ * exceptions are dropped/reclaimed through SW2WBM. Unknown ownership stops
+ * the DP with all DMA retained. */
+int peach_rx_poll(PeachRx *, PeachReceive, void *);
+#endif
diff --git a/bsd/dev/qcom/PeachSrng.c b/bsd/dev/qcom/PeachSrng.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/qcom/PeachSrng.c
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Peach v2: hal_peach.c SRNG table, hal_generic_api.h initialization,
+ * hal_srng.c pointer ownership, wcss_seq_hwioreg_umac.h register offsets.
+ * This is the retained-ring primitive, not a complete packet datapath. */
+#include "PeachSrng.h"
+#if defined(KERNEL)
+#include <libkern/libkern.h>
+#else
+#include <string.h>
+#endif
+
+typedef struct { uint32_t base, doorbell; unsigned id, dwords, source, lmac; } RingConfig;
+static const RingConfig config[PeachSrngKinds] = {
+    {0x00a38500, 0x00a3b048, 1,   8, 0, 0}, /* REO2SW1 */
+    {0x00a388c0, 0x00a3b088, 0,   8, 0, 0}, /* REO2SW0 exception */
+    {0x00a44918, 0x00a46000, 24,  8, 1, 0}, /* SW2TCL1 */
+    {0x00a34f70, 0x00a370e0, 131, 8, 0, 0}, /* WBM2SW3 RX release */
+    {0, 0, 0, 2, 1, 1},                    /* FW-controlled RX refill */
+    {0, 0, 0, 8, 0, 1},                    /* FW-controlled RXDMA2SW */
+    {0x00a34d3c, 0x00a370b8, 120, 2, 1, 0}, /* WBM idle link */
+    {0x00a3437c, 0x00a37010, 121, 8, 1, 0}, /* SW2WBM release */
+    {0x00a34e08, 0x00a370c8, 128, 8, 0, 0}, /* WBM2SW0 TX; SW1 belongs to FW */
+};
+#define STRY(r, expr) do { int err_ = (expr); if (err_) { (r)->error = err_; return err_; } } while (0)
+static uint32_t u32(const void *p) { uint32_t v; memcpy(&v, p, 4); return v; }
+static void barrier(PeachSrng *r) { r->ops.barrier(r->ops.context); }
+static int invalid(PeachSrng *r) { return r->error = PeachCeProtocol; }
+static int rd(PeachSrng *r, uint32_t o, uint32_t *v)
+{
+    r->last_register = o;
+    int err = r->ops.read32(r->ops.context, o, v);
+    r->last_value = err ? 0xffffffffu : *v;
+    return err;
+}
+static int wr(PeachSrng *r, uint32_t o, uint32_t v)
+{
+    r->last_register = o; r->last_value = v;
+    return r->ops.write32(r->ops.context, o, v);
+}
+size_t peach_srng_bytes(unsigned kind, unsigned entries)
+{
+    if (kind >= PeachSrngKinds || entries < 4 || entries > 65535u / config[kind].dwords)
+        return 0;
+    size_t bytes = (size_t)entries * config[kind].dwords * 4;
+    return ((bytes + 63) & ~(size_t)63) + 128;
+}
+int peach_srng_prepare(PeachSrng *r, unsigned kind, unsigned entries,
+                       PeachMhiDma memory, const PeachSrngOps *ops)
+{
+    size_t bytes = peach_srng_bytes(kind, entries);
+    if (!r || !ops || !ops->read32 || !ops->write32 || !ops->health || !ops->barrier ||
+        !bytes || !memory.bytes || ((uintptr_t)memory.bytes & 63) || (memory.iova & 63) ||
+        memory.capacity < bytes || !memory.iova || memory.iova >= 0x100000000ull ||
+        bytes > 0x100000000ull - memory.iova) return PeachMhiInvalid;
+    memset(r, 0, sizeof(*r)); r->ops = *ops; r->kind = kind; r->entries = entries;
+    r->memory = memory; r->dwords = config[kind].dwords; r->source = config[kind].source;
+    r->lmac = config[kind].lmac; r->ring_id = config[kind].id;
+    r->base = config[kind].base; r->doorbell = config[kind].doorbell; r->loop = 1;
+    size_t descriptors = (size_t)entries * r->dwords * 4;
+    size_t pointer = (descriptors + 63) & ~(size_t)63;
+    r->descriptors = (PeachMhiDma){memory.bytes, memory.iova, descriptors};
+    r->head = (PeachMhiDma){(unsigned char *)memory.bytes + pointer, memory.iova + pointer, 4};
+    r->tail = (PeachMhiDma){(unsigned char *)memory.bytes + pointer + 64, memory.iova + pointer + 64, 4};
+    memset(memory.bytes, 0, bytes); barrier(r); r->prepared = 1;
+    return 0;
+}
+int peach_srng_start_host(PeachSrng *r)
+{
+    if (!r || !r->prepared || r->started || r->lmac) return PeachMhiInvalid;
+    if (r->error) return r->error;
+    STRY(r, r->ops.health(r->ops.context));
+    uint32_t v;
+    STRY(r, rd(r, r->base + 0x10, &v));
+    if (v == 0xffffffffu || (v & 0x40)) return invalid(r); /* never replace live DMA */
+    STRY(r, wr(r, r->base + 0x10, 0));
+    STRY(r, wr(r, r->base, (uint32_t)r->descriptors.iova));
+    if (r->kind == PeachSrngIdleLink) {
+        STRY(r, rd(r, r->base, &v));
+        if (v != (uint32_t)r->descriptors.iova) return invalid(r);
+    }
+    STRY(r, wr(r, r->base + 4, r->entries * r->dwords << 8));
+    STRY(r, wr(r, r->base + 8, r->dwords | (r->source ? 0 : r->ring_id << 8)));
+    /* Direct target doorbells, with coherent remote hardware pointer.
+     * No MSI, near-full interrupt, pointer coalescing or shadow acceleration. */
+    STRY(r, wr(r, r->base + 0x4c, 0));
+    if (!r->source) {
+        STRY(r, wr(r, r->base + 0x5c, 0));
+        STRY(r, wr(r, r->base + 0x54, 0));
+        STRY(r, wr(r, r->base + 0x74, 0));
+    }
+    STRY(r, wr(r, r->base + (r->source ? 0x30 : 0x24), 0));
+    if (r->source) STRY(r, wr(r, r->base + 0x34, 0));
+    /* WBM owns its idle list producer and consumer. Vendor HAL explicitly
+     * forbids a remote pointer here because it destabilizes WBM. */
+    PeachMhiDma pointer = r->source ? r->tail : r->head;
+    if (r->kind == PeachSrngIdleLink) pointer.iova = 0;
+    STRY(r, wr(r, r->base + (r->source ? 0x1c : 0x14), (uint32_t)pointer.iova));
+    STRY(r, wr(r, r->base + (r->source ? 0x20 : 0x18), 0));
+    STRY(r, wr(r, r->doorbell, 0));
+    STRY(r, wr(r, r->doorbell + 4, 0));
+    barrier(r);
+    uint32_t misc = 0x40 | (r->source ? 2 : 0);
+    if (r->kind == PeachSrngIdleLink) misc |= 1; /* ring ID disabled */
+    STRY(r, wr(r, r->base + 0x10, misc));
+    STRY(r, rd(r, r->base + 0x10, &v));
+    if ((v & 0x7f) != misc) return invalid(r);
+    r->started = 1;
+    return 0;
+}
+int peach_srng_seed_idle(PeachSrng *r, PeachMhiDma links, unsigned count)
+{
+    if (!r || !r->started || r->kind != PeachSrngIdleLink || r->wp ||
+        !count || count >= r->entries || !links.bytes ||
+        ((uintptr_t)links.bytes & 127) || !links.iova || (links.iova & 127) ||
+        links.iova >= 0x100000000ull || links.capacity < (size_t)count * 128 ||
+        (size_t)count * 128 > 0x100000000ull - links.iova)
+        return PeachMhiInvalid;
+    if (r->error) return r->error;
+    if (links.iova < r->memory.iova + r->memory.capacity &&
+        r->memory.iova < links.iova + (size_t)count * 128) return PeachMhiInvalid;
+    STRY(r, r->ops.health(r->ops.context));
+    /* hal_get_link_desc_size_peach: 32 DWORDs; dp_link_desc_ring_replenish:
+     * clear pool, then post buffer_addr_info with WBM_IDLE_DESC_LIST=1.
+     * Cookies are software indices only; never kernel virtual addresses. */
+    memset(links.bytes, 0, (size_t)count * 128);
+    uint32_t *p = r->descriptors.bytes;
+    for (unsigned i = 0; i < count; i++) {
+        p[i * 2] = (uint32_t)(links.iova + (size_t)i * 128);
+        p[i * 2 + 1] = 1u << 8 | i << 12;
+    }
+    r->wp = count;
+    barrier(r);
+    STRY(r, wr(r, r->doorbell, count * r->dwords));
+    return 0;
+}
+int peach_srng_start_lmac(PeachSrng *r, PeachHtt *h, unsigned pdev, unsigned id, unsigned type)
+{
+    if (!r || !r->prepared || r->started || !r->lmac || !h) return PeachMhiInvalid;
+    if (r->error) return r->error;
+    if (r->kind == PeachSrngRxBuffer) {
+        if (!((id == 0 && type == PeachHttSwToHw) || (id == 5 && type == PeachHttSwToSw)))
+            return PeachMhiInvalid;
+    } else if (id != 7 || type != PeachHttHwToSw) return PeachMhiInvalid;
+    STRY(r, r->ops.health(r->ops.context));
+    PeachHttRing request = {r->descriptors, r->head, r->tail, pdev, id, type, r->entries, r->dwords};
+    STRY(r, peach_htt_setup_ring(h, &request));
+    r->started = 1;
+    return 0;
+}
+static int hardware_pointer(PeachSrng *r, unsigned *index)
+{
+    STRY(r, r->ops.health(r->ops.context));
+    barrier(r);
+    uint32_t offset = *(volatile uint32_t *)(r->source ? r->tail.bytes : r->head.bytes);
+    if (offset >= r->entries * r->dwords || offset % r->dwords) return invalid(r);
+    *index = offset / r->dwords; barrier(r);
+    return 0;
+}
+static unsigned distance(PeachSrng *r, unsigned a, unsigned b)
+{ return a >= b ? a - b : r->entries - b + a; }
+static int publish(PeachSrng *r)
+{
+    barrier(r);
+    uint32_t offset = (r->source ? r->wp : r->rp) * r->dwords;
+    if (r->lmac) {
+        *(volatile uint32_t *)(r->source ? r->head.bytes : r->tail.bytes) = offset;
+        barrier(r);
+        return 0;
+    }
+    return wr(r, r->doorbell + (r->source ? 0 : 4), offset);
+}
+int peach_srng_push(PeachSrng *r, const void *descriptor, size_t n)
+{
+    if (!r || !r->started || !r->source || r->kind == PeachSrngIdleLink ||
+        !descriptor || n != r->dwords * 4)
+        return PeachMhiInvalid;
+    if (r->error) return r->error;
+    unsigned tail;
+    STRY(r, hardware_pointer(r, &tail));
+    if (distance(r, tail, r->rp) > distance(r, r->wp, r->rp)) return invalid(r);
+    r->rp = tail;
+    unsigned next = r->wp + 1;
+    if (next == r->entries) next = 0;
+    if (next == r->rp) return PeachCeFull;
+    memcpy((unsigned char *)r->descriptors.bytes + r->wp * n, descriptor, n);
+    r->wp = next;
+    STRY(r, publish(r));
+    return 0;
+}
+int peach_srng_pop(PeachSrng *r, void *descriptor, size_t n)
+{
+    if (!r || !r->started || r->source || !descriptor || n != r->dwords * 4)
+        return PeachMhiInvalid;
+    if (r->error) return r->error;
+    unsigned head;
+    STRY(r, hardware_pointer(r, &head));
+    if (head == r->rp) return PeachSrngEmpty;
+    unsigned char *p = (unsigned char *)r->descriptors.bytes + r->rp * n;
+    /* A published pointer alone does not prove descriptor stores completed.
+     * Peach destination formats put the expected loop in the final nibble. */
+    if ((u32(p + n - 4) >> 28) != r->loop) return PeachSrngEmpty;
+    barrier(r); memcpy(descriptor, p, n);
+    r->rp++;
+    if (r->rp == r->entries) { r->rp = 0; r->loop = (r->loop + 1) & 15; }
+    STRY(r, publish(r));
+    return 0;
+}
diff --git a/bsd/dev/qcom/PeachSrng.h b/bsd/dev/qcom/PeachSrng.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/qcom/PeachSrng.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PEACH_SRNG_H
+#define PEACH_SRNG_H
+#include "PeachHtt.h"
+
+enum { PeachSrngReoRx, PeachSrngReoException, PeachSrngTclTx,
+       PeachSrngWbmCompletion, PeachSrngRxBuffer, PeachSrngRxException,
+       PeachSrngIdleLink,
+       PeachSrngWbmRelease,
+       PeachSrngTxCompletion,
+       PeachSrngKinds, PeachSrngEmpty = -21 };
+typedef struct {
+    void *context;
+    int (*read32)(void *, uint32_t, uint32_t *);
+    int (*write32)(void *, uint32_t, uint32_t);
+    int (*health)(void *);
+    void (*barrier)(void *);
+} PeachSrngOps;
+typedef struct {
+    PeachSrngOps ops;
+    PeachMhiDma memory, descriptors, head, tail;
+    unsigned kind, entries, dwords, source, lmac, ring_id;
+    unsigned prepared, started, wp, rp, loop;
+    uint32_t base, doorbell, last_register, last_value;
+    int error;
+} PeachSrng;
+
+/* Coherent DMA lives until endpoint DMA is genuinely stopped or reboot.
+ * One worker owns all rings; copying a descriptor does not release its
+ * referenced buffers. Source TP advances mean descriptor consumption only. */
+size_t peach_srng_bytes(unsigned kind, unsigned entries);
+int peach_srng_prepare(PeachSrng *, unsigned kind, unsigned entries,
+                       PeachMhiDma, const PeachSrngOps *);
+int peach_srng_start_host(PeachSrng *);
+/* Seed once. WBM subsequently owns this ring, including both pointers.
+ * The zeroed link pool and all ring DMA must remain retained. */
+int peach_srng_seed_idle(PeachSrng *, PeachMhiDma links, unsigned count);
+/* RX buffer uses id 0/type SW_TO_HW, or vendor HOST1 id 5/type SW_TO_SW.
+ * Caller selects the advertised radio mapping; no pdev is inferred here. */
+int peach_srng_start_lmac(PeachSrng *, PeachHtt *, unsigned pdev, unsigned id, unsigned type);
+int peach_srng_push(PeachSrng *, const void *, size_t);
+int peach_srng_pop(PeachSrng *, void *, size_t);
+#endif
diff --git a/bsd/dev/qcom/PeachStation.c b/bsd/dev/qcom/PeachStation.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/qcom/PeachStation.c
@@ -0,0 +1,357 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* 802.11 legacy STA MLME over Peach WMI management TX/RX. No synthetic
+ * responses or autonomous network choice. Firmware wire format is handled
+ * by PeachWmi; association here requires actual AP response bytes. */
+#include "PeachStation.h"
+#if defined(KERNEL)
+#include <libkern/libkern.h>
+#else
+#include <string.h>
+#endif
+static unsigned u16(const unsigned char *p) { return p[0] | (unsigned)p[1] << 8; }
+static void p16(unsigned char *p, unsigned v) { p[0] = v; p[1] = v >> 8; }
+static int fail(PeachStation *s, int error)
+{
+    (void)peach_tx_authorize(s->tx, 0);
+    s->phase = PeachStationFailed;
+    return s->error = error;
+}
+#define STRY(s, expr) do { int err_ = (expr); if (err_) return fail((s), err_); } while (0)
+static uint64_t now(PeachStation *s) { return s->wmi->htc->ops.now_us(s->wmi->htc->ops.context); }
+static void sleep_ms(PeachStation *s) { s->wmi->htc->ops.sleep_us(s->wmi->htc->ops.context, 1000); }
+static int progress(PeachStation *s)
+{
+    int err = peach_htc_poll(s->wmi->htc);
+    if (!err) err = s->wmi->error ? s->wmi->error : s->htt->error;
+    return err;
+}
+static int rate_add(unsigned char rates[12], unsigned *count, unsigned value, unsigned frequency)
+{
+    static const unsigned char supported[] = {2,4,11,22,12,18,24,36,48,72,96,108};
+    unsigned found = 0, rate = value & 127;
+    for (unsigned i = frequency < 2500 ? 0 : 4; i < sizeof(supported); i++)
+        if (rate == supported[i]) found = 1;
+    if (!found) return value & 128 ? PeachMhiInvalid : 0;
+    for (unsigned i = 0; i < *count; i++)
+        if ((rates[i] & 127) == rate) return PeachCeProtocol;
+    if (*count == 12) return PeachCeProtocol;
+    rates[(*count)++] = value;
+    return 0;
+}
+static int rates_from_ies(const unsigned char *p, size_t n, unsigned frequency,
+                          unsigned char rates[12], unsigned *count)
+{
+    unsigned seen = 0; *count = 0;
+    while (n) {
+        if (n < 2 || p[1] > n - 2) return PeachCeProtocol;
+        unsigned tag = p[0], len = p[1];
+        if (tag == 1 || tag == 50) {
+            unsigned bit = tag == 1 ? 1 : 2;
+            if ((seen & bit) || !len || (tag == 1 && len > 8)) return PeachCeProtocol;
+            seen |= bit;
+            for (unsigned i = 0; i < len; i++) {
+                int err = rate_add(rates, count, p[2 + i], frequency);
+                if (err) return err;
+            }
+        }
+        p += 2 + len; n -= 2 + len;
+    }
+    return (seen & 1) && *count ? 0 : PeachMhiInvalid;
+}
+static int suite(const unsigned char *p, unsigned type)
+{ return !p[0] && p[1] == 15 && p[2] == 172 && p[3] == type; }
+static int rsn_supported(const unsigned char *p, size_t n)
+{
+    if (n < 8 || u16(p) != 1 || !suite(p + 2, 4)) return 0;
+    p += 6; n -= 6;
+    for (unsigned list = 0; list < 2; list++) {
+        if (n < 2) return 0;
+        unsigned count = u16(p), found = 0;
+        p += 2; n -= 2;
+        if (!count || count > n / 4) return 0;
+        for (unsigned i = 0; i < count; i++) if (suite(p + 4 * i, list ? 2 : 4)) found = 1;
+        if (!found) return 0;
+        p += count * 4; n -= count * 4;
+    }
+    if (!n) return 1; /* omitted RSN capabilities = zero */
+    if (n < 2 || (u16(p) & 0x40)) return 0; /* no required PMF support yet */
+    p += 2; n -= 2;
+    if (!n) return 1;
+    if (n < 2) return 0;
+    unsigned count = u16(p); p += 2; n -= 2;
+    if (count > n / 16) return 0;
+    p += count * 16; n -= count * 16;
+    return !n || (n == 4 && suite(p, 6));
+}
+static int bss_security(unsigned security, const PeachWmiBss *b)
+{
+    const unsigned char *rsn = NULL; unsigned bytes = 0;
+    for (size_t off = 0; off < b->ie_bytes;) {
+        if (b->ie_bytes - off < 2 || b->ies[off + 1] > b->ie_bytes - off - 2)
+            return PeachCeProtocol;
+        unsigned n = b->ies[off + 1];
+        if (b->ies[off] == 48) {
+            if (rsn) return PeachCeProtocol;
+            rsn = b->ies + off + 2; bytes = n;
+        }
+        off += 2 + n;
+    }
+    if (security == PeachStationOpen)
+        return (b->capability & 16) || rsn ? PeachMhiInvalid : 0;
+    if (!(b->capability & 16) || !rsn || !rsn_supported(rsn, bytes)) return PeachMhiInvalid;
+    return 0;
+}
+int peach_station_candidate(const PeachWmiBss *b, unsigned security)
+{
+    if (!b || security > PeachStationWpa2Psk || !b->ssid_bytes || b->ssid_bytes > 32 ||
+        b->ies_truncated || !b->beacon_interval || !b->dtim_period || (b->capability & 3) != 1 ||
+        (b->frequency >= 2500 && (b->frequency < 4900 || b->frequency >= 5925)))
+        return PeachMhiInvalid;
+    int err = bss_security(security, b);
+    unsigned char rates[12]; unsigned count;
+    return err ? err : rates_from_ies(b->ies, b->ie_bytes, b->frequency, rates, &count);
+}
+int peach_station_init(PeachStation *s, PeachWmi *w, PeachHtt *h, PeachRx *r, PeachTx *t)
+{
+    if (!s || !w || !h || !r || !t || !w->ready || !h->confirmed || !r->started || !t->started)
+        return PeachMhiInvalid;
+    memset(s, 0, sizeof(*s)); s->wmi = w; s->htt = h; s->rx = r; s->tx = t;
+    return 0;
+}
+static int mapping_live(PeachStation *s)
+{
+    const PeachHttPeer *p = peach_htt_peer(s->htt, 0, s->bssid);
+    return p && p->generation == s->peer_generation;
+}
+static int wait_peer(PeachStation *s)
+{
+    uint64_t end = now(s) + 10000000;
+    for (;;) {
+        const PeachHttPeer *p = peach_htt_peer(s->htt, 0, s->bssid);
+        if (p) {
+            if (!p->ast_valid || !p->hash_valid) return PeachMhiInvalid;
+            s->peer_generation = p->generation; return 0;
+        }
+        STRY(s, progress(s));
+        if (now(s) >= end) return PeachMhiTimeout;
+        sleep_ms(s);
+    }
+}
+static void header(PeachStation *s, unsigned subtype)
+{
+    memset(s->frame, 0, sizeof(s->frame)); s->frame[0] = subtype;
+    memcpy(s->frame + 4, s->bssid, 6); memcpy(s->frame + 10, s->wmi->mac, 6);
+    memcpy(s->frame + 16, s->bssid, 6);
+    p16(s->frame + 22, (s->sequence++ & 4095) << 4);
+}
+static int response(PeachStation *s, unsigned subtype, size_t minimum)
+{
+    uint64_t end = now(s) + 1000000;
+    for (;;) {
+        int err = peach_wmi_mgmt_rx(s->wmi, &s->received);
+        if (!err) {
+            const unsigned char *p = s->received.frame;
+            unsigned got = p[0] & 0xfc;
+            if (got == 0xc0 || got == 0xa0) {
+                s->on_air_status = s->received.bytes >= 26 ? u16(p + 24) : 0xffff;
+                return PeachMhiDeviceError;
+            }
+            if (got == subtype) {
+                if (s->received.bytes < minimum || memcmp(p + 4, s->wmi->mac, 6) ||
+                    (u16(p + 22) & 15) || (u16(p) & 0x0400)) return PeachCeProtocol;
+                return 0;
+            }
+        } else if (err != PeachWmiNoFrame) return err;
+        STRY(s, progress(s));
+        if (!mapping_live(s)) return PeachMhiDeviceError;
+        if (now(s) >= end) return PeachMhiTimeout;
+        sleep_ms(s);
+    }
+}
+static int authenticate(PeachStation *s)
+{
+    for (unsigned attempt = 0; attempt < 3; attempt++) {
+        header(s, 0xb0); p16(s->frame + 26, 1); /* open-system alg 0, transaction 1 */
+        int err = peach_wmi_mgmt_tx(s->wmi, s->frame, 30);
+        if (err && err != PeachMhiDeviceError) return err;
+        /* An AP response can arrive even when the host misses TX ACK. */
+        err = response(s, 0xb0, 30);
+        if (err == PeachMhiTimeout && attempt < 2) continue;
+        if (err) return err;
+        const unsigned char *p = s->received.frame;
+        if (u16(p + 24) || u16(p + 26) != 2) return PeachCeProtocol;
+        s->on_air_status = u16(p + 28);
+        return s->on_air_status ? PeachMhiDeviceError : 0;
+    }
+    return PeachMhiTimeout;
+}
+static unsigned wmm_parameters(const unsigned char *p, size_t bytes)
+{
+    while (bytes >= 2 && p[1] <= bytes - 2) {
+        if (p[0] == 221 && p[1] == 24 &&
+            !memcmp(p + 2, "\x00\x50\xf2\x02\x01\x01", 6)) return 1;
+        size_t n = p[1] + 2u; p += n; bytes -= n;
+    }
+    return 0;
+}
+static int associate(PeachStation *s, const PeachWmiBss *b)
+{
+    header(s, 0); p16(s->frame + 24, s->requested_caps); p16(s->frame + 26, 10);
+    unsigned off = 28;
+    s->frame[off++] = 0; s->frame[off++] = b->ssid_bytes;
+    memcpy(s->frame + off, b->ssid, b->ssid_bytes); off += b->ssid_bytes;
+    unsigned first = s->rate_count > 8 ? 8 : s->rate_count;
+    s->frame[off++] = 1; s->frame[off++] = first;
+    memcpy(s->frame + off, s->rates, first); off += first;
+    if (s->rate_count > first) {
+        s->frame[off++] = 50; s->frame[off++] = s->rate_count - first;
+        memcpy(s->frame + off, s->rates + first, s->rate_count - first); off += s->rate_count - first;
+    }
+    memcpy(s->frame + off, s->rsn, s->rsn_bytes); off += s->rsn_bytes;
+    unsigned qos = wmm_parameters(b->ies, b->ie_bytes);
+    if (qos) {
+        static const unsigned char info[] = {221,7,0,0x50,0xf2,2,0,1,0};
+        memcpy(s->frame + off, info, sizeof(info)); off += sizeof(info);
+    }
+    int err = peach_wmi_mgmt_tx(s->wmi, s->frame, off);
+    if (err && err != PeachMhiDeviceError) return err;
+    err = response(s, 0x10, 30);
+    if (err) return err;
+    const unsigned char *p = s->received.frame;
+    s->on_air_status = u16(p + 26);
+    if (s->on_air_status) return PeachMhiDeviceError;
+    PeachWmiAssociation *a = &s->association;
+    a->aid = u16(p + 28) & 0x3fff; a->capabilities = u16(p + 24);
+    a->protected_network = s->security == PeachStationWpa2Psk;
+    a->qos = qos && wmm_parameters(p + 30, s->received.bytes - 30);
+    if (!a->aid || a->aid > 2007 || (a->capabilities & 3) != 1 ||
+        !!(a->capabilities & 16) != a->protected_network) return PeachCeProtocol;
+    err = rates_from_ies(p + 30, s->received.bytes - 30, b->frequency, a->rates, &a->rate_count);
+    if (err) return err;
+    /* Every response rate must have been offered, including AP basic rates. */
+    for (unsigned i = 0; i < a->rate_count; i++) {
+        unsigned found = 0;
+        for (unsigned j = 0; j < s->rate_count; j++)
+            if ((a->rates[i] & 127) == (s->rates[j] & 127)) found = 1;
+        if (!found) return PeachCeProtocol;
+    }
+    return 0;
+}
+int peach_station_associate(PeachStation *s, unsigned bss_index, unsigned security)
+{
+    if (!s || !s->wmi || s->phase != PeachStationIdle || security > PeachStationWpa2Psk ||
+        bss_index >= s->wmi->bss_count || !s->wmi->scan_done || s->wmi->scan_active)
+        return PeachMhiInvalid;
+    const PeachWmiBss *b = &s->wmi->bss[bss_index];
+    int err = peach_station_candidate(b, security);
+    if (err) return err;
+    const PeachWmiRegDomain *reg = &s->wmi->regulatory[s->wmi->radio.phy];
+    if (!reg->valid || reg->generation != s->wmi->scan_reg_generation) return PeachMhiInvalid;
+    s->security = security; memcpy(s->bssid, b->bssid, 6);
+    if (security) {
+        static const unsigned char selected[] = {48,20,1,0,0,15,172,4,1,0,0,15,172,4,1,0,0,15,172,2,0,0};
+        memcpy(s->rsn, selected, sizeof(selected)); s->rsn_bytes = sizeof(selected);
+    }
+    STRY(s, rates_from_ies(b->ies, b->ie_bytes, b->frequency, s->rates, &s->rate_count));
+    s->requested_caps = 1u | (b->capability & 0x420) | (security ? 16u : 0);
+    s->phase = PeachStationPeer;
+    STRY(s, peach_wmi_peer_create(s->wmi, s->bssid, 1));
+    STRY(s, wait_peer(s));
+    STRY(s, peach_wmi_vdev_start(s->wmi, bss_index, 0));
+    /* Vendor initializes both default data and non-QoS queues. No BA. */
+    STRY(s, peach_wmi_peer_queue(s->wmi, s->htt, s->bssid, 0, peach_rx_queue(s->rx, 0)));
+    STRY(s, peach_wmi_peer_queue(s->wmi, s->htt, s->bssid, 16, peach_rx_queue(s->rx, 16)));
+    s->phase = PeachStationAuth; STRY(s, authenticate(s));
+    s->phase = PeachStationAssoc; STRY(s, associate(s, b));
+    STRY(s, peach_wmi_wmm(s->wmi, s->association.qos ? s->received.frame + 30 : NULL,
+        s->association.qos ? s->received.bytes - 30 : 0));
+    /* WMM APs can use every traffic class, including video and background
+     * IP traffic. TID0 was prepared above; queues already exist for 1..7. */
+    if (s->association.qos) for (unsigned tid = 1; tid < 8; tid++)
+        STRY(s, peach_wmi_peer_queue(s->wmi, s->htt, s->bssid, tid, peach_rx_queue(s->rx, tid)));
+    STRY(s, peach_wmi_peer_assoc(s->wmi, s->htt, &s->association));
+    STRY(s, peach_wmi_vdev_up(s->wmi));
+    STRY(s, peach_tx_bind(s->tx, 0, s->bssid));
+    s->tx->qos = s->association.qos;
+    s->phase = security ? PeachStationAwaitKeys : PeachStationOpenAssociated;
+    return 0; /* caller still has no authorized TX/NIC */
+}
+int peach_station_poll(PeachStation *s)
+{
+    if (!s || !s->wmi) return 0;
+    if (s->error) return s->error;
+    if (s->phase != PeachStationAwaitKeys && s->phase != PeachStationOpenAssociated) return 0;
+    const PeachWmiRegDomain *r = &s->wmi->regulatory[s->wmi->radio.phy];
+    if (!mapping_live(s) || !r->valid || r->generation != s->wmi->vdev_reg_generation)
+        return fail(s, PeachMhiDeviceError);
+    for (unsigned budget = 0; budget < PEACH_WMI_MGMT_FRAMES; budget++) {
+        int err = peach_wmi_mgmt_rx(s->wmi, &s->received);
+        if (err == PeachWmiNoFrame) return 0;
+        if (err) return fail(s, err);
+        unsigned subtype = s->received.frame[0] & 0xfc;
+        if (subtype == 0xc0 || subtype == 0xa0) {
+            s->on_air_status = s->received.bytes >= 26 ? u16(s->received.frame + 24) : 0xffff;
+            return fail(s, PeachMhiDeviceError);
+        }
+    }
+    return 0;
+}
+int peach_station_recover_unkeyed(PeachStation *s)
+{
+    if (!s || !s->wmi || !s->tx || !s->rx || !s->htt) return PeachMhiInvalid;
+    PeachWmi *w = s->wmi; PeachTx *t = s->tx;
+    if (w->error || s->htt->error || s->rx->error || t->error || w->key_pending)
+        return PeachMhiInvalid;
+    for (unsigned i = 0; i < 5; i++) if (w->keys[i].installed) return PeachMhiInvalid;
+    if (s->phase == PeachStationIdle) return 0; /* selection/PMK failed before setup */
+    if (!s->peer_generation) return PeachMhiInvalid;
+    (void)peach_tx_authorize(t, 0);
+    s->phase = PeachStationFailed; /* no new MLME while teardown polls */
+    uint64_t end = now(s) + 10000000;
+    while (t->in_flight || w->mgmt_in_flight) {
+        int err = progress(s);
+        if (err) return err;
+        if (now(s) >= end) return PeachMhiTimeout;
+        sleep_ms(s);
+    }
+    int err = peach_wmi_retire_unkeyed(w, s->htt, s->peer_generation);
+    if (err) return err;
+    PeachMhiDma queues;
+    err = w->ops.allocate(w->ops.context, PEACH_RX_QUEUE_BYTES, &queues);
+    if (!err) err = peach_rx_new_queues(s->rx, queues);
+    if (!err) err = peach_tx_unbind(t);
+    if (err) return err;
+    return peach_station_init(s, w, s->htt, s->rx, t);
+}
+/* Bring a live, keyed link down without resetting the firmware: drain what is
+ * in flight, retire the peer (the firmware drops its pairwise/group keys with
+ * it), release the host queues and bindings, and put the station back in Idle
+ * so the next selection can associate from scratch. The old code could only
+ * switch networks by restarting the whole endpoint, which cost one of three
+ * recoveries and left the radio unusable once they were spent. */
+int peach_station_leave(PeachStation *s)
+{
+    if (!s || !s->wmi || !s->tx || !s->rx || !s->htt) return PeachMhiInvalid;
+    PeachWmi *w = s->wmi; PeachTx *t = s->tx;
+    if (w->error || s->htt->error || s->rx->error || t->error || w->key_pending)
+        return PeachMhiInvalid;
+    if (s->phase == PeachStationIdle) return 0;
+    if (!s->peer_generation) return PeachMhiInvalid;
+    (void)peach_tx_authorize(t, 0);
+    s->phase = PeachStationFailed; /* no new MLME while teardown polls */
+    uint64_t end = now(s) + 10000000;
+    while (t->in_flight || w->mgmt_in_flight) {
+        int err = progress(s);
+        if (err) return err;
+        if (now(s) >= end) return PeachMhiTimeout;
+        sleep_ms(s);
+    }
+    int err = peach_wmi_retire_keyed(w, s->htt, s->peer_generation);
+    if (err) return err;
+    PeachMhiDma queues;
+    err = w->ops.allocate(w->ops.context, PEACH_RX_QUEUE_BYTES, &queues);
+    if (!err) err = peach_rx_new_queues(s->rx, queues);
+    if (!err) err = peach_tx_unbind(t);
+    if (err) return err;
+    return peach_station_init(s, w, s->htt, s->rx, t);
+}
diff --git a/bsd/dev/qcom/PeachStation.h b/bsd/dev/qcom/PeachStation.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/qcom/PeachStation.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PEACH_STATION_H
+#define PEACH_STATION_H
+#include "PeachWmi.h"
+#include "PeachRx.h"
+#include "PeachTx.h"
+
+enum { PeachStationIdle, PeachStationPeer, PeachStationAuth, PeachStationAssoc,
+       PeachStationAwaitKeys, PeachStationOpenAssociated, PeachStationFailed };
+enum { PeachStationOpen, PeachStationWpa2Psk };
+typedef struct {
+    PeachWmi *wmi;
+    PeachHtt *htt;
+    PeachRx *rx;
+    PeachTx *tx;
+    unsigned phase, security, sequence, on_air_status, requested_caps;
+    uint32_t peer_generation;
+    unsigned char bssid[6], rates[12], rsn[22], frame[512];
+    unsigned rate_count, rsn_bytes;
+    PeachWmiMgmt received;
+    PeachWmiAssociation association;
+    int error;
+} PeachStation;
+
+int peach_station_init(PeachStation *, PeachWmi *, PeachHtt *, PeachRx *, PeachTx *);
+/* Selection-time compatibility check; does not mutate station/hardware state. */
+int peach_station_candidate(const PeachWmiBss *, unsigned security);
+/* Explicit BSS selection by the future network control path. Open-system
+ * 802.11 auth + real association response, legacy 20MHz and optional WMM.
+ * WPA2 supports PSK/CCMP selection and stops in AwaitKeys; no ordinary data
+ * authorization, key installation, NIC or address acquisition is implied.
+ * Hidden SSIDs, required PMF, enterprise, WPA1 and WPA3 are unsupported. */
+int peach_station_associate(PeachStation *, unsigned bss_index, unsigned security);
+/* Single worker; called by protocol progress, never recursively polls HTC.
+ * Unmap/deauth/regulatory changes revoke TX and propagate failure. */
+int peach_station_poll(PeachStation *);
+/* Recover an unsuccessful pre-key association. Refuses installed keys,
+ * transport errors or ambiguous completions; never reuses old REO queues. */
+int peach_station_recover_unkeyed(PeachStation *);
+/* Teardown of a live keyed link, no firmware reset, no recovery budget. */
+int peach_station_leave(PeachStation *);
+#endif
diff --git a/bsd/dev/qcom/PeachTx.c b/bsd/dev/qcom/PeachTx.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/qcom/PeachTx.c
@@ -0,0 +1,233 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Peach v2 tcl_data_cmd/wbm2sw_completion_ring_tx, hal_be_tx.h and
+ * dp_be_tx.c. One nonfragmented Ethernet queue, no checksum/TSO offload. */
+#include "PeachTx.h"
+#if defined(KERNEL)
+#include <libkern/libkern.h>
+#else
+#include <string.h>
+#endif
+#define TX_RBM 5u /* Peach TCL0 -> WBM2SW0; WBM2SW1 is firmware-owned. */
+#define TTRY(t, expr) do { int err_ = (expr); if (err_) { (t)->error = err_; return err_; } } while (0)
+static int invalid(PeachTx *t) { return t->error = PeachCeProtocol; }
+static uint64_t now(PeachTx *t) { return t->htt->htc->ops.now_us(t->htt->htc->ops.context); }
+int peach_tx_prepare(PeachTx *t, PeachSrng rings[PeachSrngKinds], PeachHtt *h,
+                     PeachMhiDma memory, unsigned lmac, unsigned pdev)
+{
+    if (!t || !rings || !h || !h->htc || !h->htc->started || h->metadata_version != 1 ||
+        lmac > 3 || pdev > 3 || !memory.bytes || !memory.iova ||
+        ((uintptr_t)memory.bytes & 127) || (memory.iova & 127) ||
+        memory.capacity < PEACH_TX_DMA_BYTES || memory.iova >= 0x100000000ull ||
+        PEACH_TX_DMA_BYTES > 0x100000000ull - memory.iova) return PeachMhiInvalid;
+    for (unsigned i = 0; i < PeachSrngKinds; i++) {
+        /* RX rings may already be enabled before WMI INIT. */
+        if (!rings[i].prepared || rings[i].error ||
+            (rings[i].started && (i == PeachSrngTclTx || i == PeachSrngTxCompletion)))
+            return PeachMhiInvalid;
+        PeachMhiDma d = rings[i].memory;
+        if (d.iova < memory.iova + PEACH_TX_DMA_BYTES && memory.iova < d.iova + d.capacity)
+            return PeachMhiInvalid;
+    }
+    memset(t, 0, sizeof(*t));
+    t->ring = &rings[PeachSrngTclTx]; t->completion = &rings[PeachSrngTxCompletion];
+    t->htt = h; t->memory = memory; t->lmac = lmac; t->pdev = pdev;
+    PeachSrngOps *ops = &t->ring->ops;
+    TTRY(t, ops->health(ops->context));
+    memset(memory.bytes, 0, PEACH_TX_DMA_BYTES); ops->barrier(ops->context);
+    t->prepared = 1;
+    return 0;
+}
+int peach_tx_start(PeachTx *t)
+{
+    if (!t || !t->prepared || t->started || !t->htt->confirmed ||
+        t->htt->metadata_version != 1 || !t->ring->started || !t->completion->started)
+        return PeachMhiInvalid;
+    if (t->error) return t->error;
+    PeachSrngOps *ops = &t->ring->ops;
+    TTRY(t, ops->health(ops->context));
+    /* Bank 0 is host-owned; Peach has eight banks, last reserved for FW.
+     * hal_be_generic_api.h's Peach layout uses DSCP table bits at 17, not
+     * newer MCAST_PACKET_CTRL bits. STA uses the real BSS AST index.
+     * Non-raw encryption is taken from the peer, not this bank. */
+    uint32_t config = 2u << 1 | 1u << 9 | t->lmac << 15, check;
+    TTRY(t, ops->write32(ops->context, 0x00a4408c, config));
+    TTRY(t, ops->read32(ops->context, 0x00a4408c, &check));
+    if (check != config) return invalid(t);
+    t->started = 1;
+    return 0;
+}
+static int mapping_live(PeachTx *t)
+{
+    const PeachHttPeer *p = peach_htt_peer(t->htt, t->vdev, t->peer_mac);
+    return !t->htt->error && p && p->generation == t->peer_generation &&
+        p->peer == t->peer && p->ast_valid && p->hash_valid &&
+        p->ast == t->ast && p->hash == t->hash;
+}
+int peach_tx_bind(PeachTx *t, unsigned vdev, const unsigned char mac[6])
+{
+    if (!t || !t->started || t->authorized || t->in_flight || vdev || !mac)
+        return PeachMhiInvalid;
+    if (t->error) return t->error;
+    if (t->htt->error) return t->error = t->htt->error;
+    const PeachHttPeer *p = peach_htt_peer(t->htt, vdev, mac);
+    if (!p || !p->ast_valid || !p->hash_valid) return PeachMhiInvalid;
+    t->vdev = vdev; t->peer = p->peer; t->ast = p->ast; t->hash = p->hash;
+    t->peer_generation = p->generation; memcpy(t->peer_mac, mac, 6); t->bound = 1;
+    return 0;
+}
+int peach_tx_authorize(PeachTx *t, unsigned enabled)
+{
+    if (!t || !t->prepared || enabled > 1 || (enabled && (!t->bound || !mapping_live(t))))
+        return PeachMhiInvalid;
+    if (t->error) return t->error;
+    t->authorized = enabled;
+    return 0;
+}
+int peach_tx_unbind(PeachTx *t)
+{
+    if (!t || !t->prepared || t->authorized || t->in_flight || t->control_pending)
+        return PeachMhiInvalid;
+    if (t->error) return t->error;
+    t->bound = t->qos = t->control_done = t->control_acked = 0;
+    t->peer_generation = 0; memset(t->peer_mac, 0, sizeof(t->peer_mac));
+    return 0; /* retain cookie generations and all DMA storage */
+}
+static int send_packet(PeachTx *t, const void *packet, size_t bytes, unsigned tid, unsigned control)
+{
+    if (!t || !t->started || !t->bound || (!t->authorized && !control) || !packet ||
+        bytes < 14 || bytes > 1518 || tid > 15 ||
+        !t->ring->started || !t->completion->started) return PeachMhiInvalid;
+    if (t->error) return t->error;
+    if (!mapping_live(t)) { t->authorized = 0; return PeachMhiInvalid; }
+    if (t->ring->error || t->completion->error)
+        return t->error = t->ring->error ? t->ring->error : t->completion->error;
+    unsigned i = t->next;
+    for (unsigned n = 0; n < PEACH_TX_BUFFERS && t->owned[i]; n++)
+        i = (i + 1) % PEACH_TX_BUFFERS;
+    if (t->owned[i]) return PeachCeFull;
+    PeachSrngOps *ops = &t->ring->ops;
+    TTRY(t, ops->health(ops->context));
+    /* Native skb data has NET_IP_ALIGN=2: after the 14-byte Ethernet
+     * header the IP/EAPOL payload is word-aligned for target processing. */
+    unsigned char *p = (unsigned char *)t->memory.bytes + i * PEACH_TX_BUFFER_BYTES + 2;
+    memcpy(p, packet, bytes);
+    size_t length = bytes < 60 ? 60 : bytes;
+    if (length > bytes) memset(p + bytes, 0, length - bytes);
+    unsigned previous = t->cookies[i];
+    /* Native starts at slot ID zero. Add a generation only when a slot
+     * is reused after its validated completion, not on its first send. */
+    unsigned generation = t->submitted < PEACH_TX_BUFFERS ? 0 : (previous >> 6) + 1;
+    if (generation > 16383) generation = 1;
+    unsigned cookie = generation << 6 | i;
+    t->cookies[i] = cookie;
+    /* V1 metadata: vdev-based type 1, no optional HTT extension. */
+    uint32_t metadata = 1u | t->vdev << 2 | t->pdev << 10;
+    uint32_t entry[8] = {
+        (uint32_t)(t->memory.iova + i * PEACH_TX_BUFFER_BYTES + 2), TX_RBM << 8 | cookie << 12,
+        /* Captured native M2/M4: semi-hard notify, voice TID override and
+         * critical-frame classifier; TO_FW is clear for these frames. */
+        control ? 3u << 8 : 0, metadata << 16, (uint32_t)length,
+        1u | (control && t->qos ? 6u : tid) << 4 | (control ? 6u : 0) |
+            t->lmac << 9 | t->vdev << 24,
+        t->ast | (t->hash & 15) << 20, 0};
+    if (control && t->htt->htc->ops.log) {
+        t->htt->htc->ops.log(t->htt->htc->ops.context, "TX EAPOL native notify/classifier", entry[2], entry[5]);
+        t->htt->htc->ops.log(t->htt->htc->ops.context, "TX EAPOL DMA/cookie", entry[0], entry[1]);
+        t->htt->htc->ops.log(t->htt->htc->ops.context, "TX EAPOL metadata/length", entry[3], entry[4]);
+        t->htt->htc->ops.log(t->htt->htc->ops.context, "TX EAPOL search/hash", entry[6], 0);
+    }
+    t->owned[i] = 1; t->in_flight++; t->submitted_at[i] = now(t);
+    int err = peach_srng_push(t->ring, entry, sizeof(entry));
+    if (err == PeachCeFull) {
+        t->owned[i] = 0; t->in_flight--; t->cookies[i] = previous; return err;
+    }
+    if (err) return t->error = err; /* ownership is ambiguous: retain buffer */
+    t->next = (i + 1) % PEACH_TX_BUFFERS; t->submitted++;
+    if (control) {
+        t->control_cookie = cookie; t->control_pending = 1;
+        t->control_done = t->control_acked = 0;
+    }
+    return 0;
+}
+int peach_tx_send(PeachTx *t, const void *packet, size_t bytes, unsigned tid)
+{ return send_packet(t, packet, bytes, tid, 0); }
+int peach_tx_eapol(PeachTx *t, const unsigned char local[6], const void *packet, size_t bytes)
+{
+    const unsigned char *p = packet;
+    if (!t || !local || !p || bytes < 18 || bytes > 640 ||
+        memcmp(p, t->peer_mac, 6) || memcmp(p + 6, local, 6) ||
+        p[12] != 0x88 || p[13] != 0x8e || p[15] != 3 ||
+        (size_t)(p[16] * 256u + p[17]) + 18 != bytes) return PeachMhiInvalid;
+    if (t->control_pending) return PeachCeFull;
+    return send_packet(t, packet, bytes, 0, 1);
+}
+int peach_tx_poll(PeachTx *t)
+{
+    if (!t || !t->started || !t->completion->started) return 0;
+    if (t->error) return t->error;
+    if (t->bound && !mapping_live(t)) t->authorized = 0;
+    for (unsigned budget = 0; budget < 64; budget++) {
+        uint32_t d[8];
+        int err = peach_srng_pop(t->completion, d, sizeof(d));
+        if (err == PeachSrngEmpty) break;
+        if (err) return t->error = err;
+        memcpy(t->last_descriptor, d, sizeof(d));
+        t->last_status = d[2];
+        /* FW overlays HTT v3 transmit status on DWORDs 2..6. WBM still
+         * owns the cookie fields; the peer moves from DWORD7 to DWORD5. */
+        unsigned source = d[2] & 7, status = (d[2] >> 13) & 15;
+        /* MEC is a multicast learning notification, not ownership return
+         * for this cookie. It may precede the actual TQM completion. */
+        if (source == 3 && status == 5) {
+            if (d[2] & 0x80000000u) return invalid(t);
+            continue;
+        }
+        /* With CC disabled, native hal_tx_comp_get_desc_id reads the
+         * original buffer_addr_info in DWORDs 0/1. Only converted records
+         * move the cookie/RBM into the completion metadata. */
+        unsigned converted = !!(d[2] & 0x40000000u);
+        unsigned cookie = converted ?
+            ((d[2] >> 18) & 4095) | ((d[7] >> 20) & 255) << 12 : d[1] >> 12;
+        unsigned rbm = converted ? (d[2] >> 9) & 15 : (d[1] >> 8) & 15;
+        unsigned peer = (source == 3 ? d[5] : d[7]) & 65535;
+        if (t->acked + t->dropped < 3 && t->htt->htc->ops.log) {
+            t->htt->htc->ops.log(t->htt->htc->ops.context, "TX completion source/status", source, status);
+            t->htt->htc->ops.log(t->htt->htc->ops.context, "TX completion cookie/peer", cookie, peer);
+        }
+        /* Peach bit30 reports cookie conversion, not an internal error.
+         * Keep using our cookie table; never dereference the returned VA. */
+        if ((source != 0 && source != 3) || ((d[2] >> 6) & 7) != 0 ||
+            rbm != TX_RBM || (d[2] & 0x80000000u)) return invalid(t);
+        /* FW reinject/inspect return ownership too (dp_tx_*_handler),
+         * but are dropped by this STA path and never counted as ACKs.
+         * Their overlay is not the OK/DROP/TTL peer-status layout. */
+        /* The FW status valid bit qualifies peer/TID metadata, not the
+         * ownership return or OK status. The cookie identifies our packet
+         * even when those optional fields are unavailable. */
+        /* FW VDEVID_MISMATCH=6 also returns the packet. Native dp_be_tx.c
+         * releases it as a drop; it is not a transport failure or an ACK.
+         * MEC=5 was handled above and never transfers ownership. */
+        if (source == 3 && status > 6) return invalid(t);
+        unsigned i = cookie & (PEACH_TX_BUFFERS - 1);
+        if (!t->bound || !t->owned[i] || cookie != t->cookies[i] ||
+            ((source == 0 || (status < 3 && (d[5] & (1u << 21)))) && peer != t->peer)) return invalid(t);
+        if (!converted && (d[0] | (uint64_t)(d[1] & 255) << 32) !=
+            t->memory.iova + i * PEACH_TX_BUFFER_BYTES + 2) return invalid(t);
+        /* A source TP advance did not release this buffer. Only this
+         * validated completion permits reuse, including failed TX. */
+        t->owned[i] = 0; t->in_flight--;
+        unsigned acked = status == 0;
+        if (t->control_pending && cookie == t->control_cookie) {
+            t->control_pending = 0; t->control_done = 1; t->control_acked = acked;
+        }
+        if (acked) t->acked++;
+        else t->dropped++;
+    }
+    if (t->in_flight) {
+        uint64_t current = now(t);
+        for (unsigned i = 0; i < PEACH_TX_BUFFERS; i++)
+            if (t->owned[i] && current - t->submitted_at[i] > 10000000)
+                return t->error = PeachMhiTimeout;
+    }
+    return 0;
+}
diff --git a/bsd/dev/qcom/PeachTx.h b/bsd/dev/qcom/PeachTx.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/qcom/PeachTx.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PEACH_TX_H
+#define PEACH_TX_H
+#include "PeachSrng.h"
+
+#define PEACH_TX_BUFFERS 64u
+#define PEACH_TX_BUFFER_BYTES 2048u
+#define PEACH_TX_DMA_BYTES (PEACH_TX_BUFFERS * PEACH_TX_BUFFER_BYTES)
+typedef struct {
+    PeachSrng *ring, *completion;
+    PeachHtt *htt;
+    PeachMhiDma memory;
+    unsigned prepared, started, bound, authorized, lmac, pdev, vdev, peer, ast, hash, qos;
+    uint32_t peer_generation;
+    unsigned char peer_mac[6];
+    unsigned in_flight, next;
+    unsigned control_pending, control_done, control_acked;
+    uint32_t control_cookie;
+    unsigned char owned[PEACH_TX_BUFFERS];
+    uint32_t cookies[PEACH_TX_BUFFERS];
+    uint64_t submitted_at[PEACH_TX_BUFFERS];
+    uint64_t submitted, acked, dropped;
+    uint32_t last_descriptor[8], last_status;
+    int error;
+} PeachTx;
+int peach_tx_prepare(PeachTx *, PeachSrng rings[PeachSrngKinds], PeachHtt *,
+                     PeachMhiDma, unsigned lmac, unsigned pdev);
+/* Host SRNGs precede WMI INIT; enable packet TX only after HTT confirms
+ * the metadata ABI and the firmware has completed initialization. */
+int peach_tx_start(PeachTx *);
+/* Binding must use a real HTT peer map after successful association. The
+ * caller may authorize only after the required security/key setup succeeds.
+ * Unbind needs all outstanding completions; no timeout-based DMA freeing. */
+int peach_tx_bind(PeachTx *, unsigned vdev, const unsigned char mac[6]);
+int peach_tx_unbind(PeachTx *);
+int peach_tx_authorize(PeachTx *, unsigned enabled);
+int peach_tx_send(PeachTx *, const void *, size_t, unsigned tid);
+/* One retained EAPOL packet, also allowed before ordinary data authorization.
+ * Destination/source must match the selected BSS and local station. Completion
+ * is a real TQM/FW result; a successful enqueue is not a transmitted handshake. */
+int peach_tx_eapol(PeachTx *, const unsigned char local[6], const void *, size_t);
+int peach_tx_poll(PeachTx *);
+#endif
diff --git a/bsd/dev/qcom/PeachWlfw.c b/bsd/dev/qcom/PeachWlfw.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/qcom/PeachWlfw.c
@@ -0,0 +1,556 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* QRTR and WLFW wire ABI from net/qrtr and Qualcomm's matching
+ * platform/cnss_utils/wlan_firmware_service_v01.{c,h}, cnss2/{qmi,main}.c.
+ * No Linux sockets, module ABI, fake replies or unowned DMA addresses. */
+#include "PeachWlfw.h"
+#include "PeachCe.h"
+#include <string.h>
+
+#define CTRL 0xfffffffeu
+#define QRTR_TX_FLOW_LOW 5u
+#define QRTR_TX_FLOW_HIGH 10u
+#define WTRY(expr) do { int e_ = (expr); if (e_) return e_; } while (0)
+static uint16_t u16(const unsigned char *p) { return p[0] | (uint16_t)p[1] << 8; }
+static uint32_t u32(const unsigned char *p)
+{ return u16(p) | (uint32_t)u16(p + 2) << 16; }
+static uint64_t u64(const unsigned char *p) { return u32(p) | (uint64_t)u32(p + 4) << 32; }
+static void p16(unsigned char *p, unsigned v) { p[0] = v; p[1] = v >> 8; }
+static void p32(unsigned char *p, uint32_t v) { p16(p, v); p16(p + 2, v >> 16); }
+static void p64(unsigned char *p, uint64_t v) { p32(p, (uint32_t)v); p32(p + 4, (uint32_t)(v >> 32)); }
+static uint64_t now(PeachWlfw *w) { return w->host->io->now_us(w->host->io->context); }
+static void pause_poll(PeachWlfw *w) { w->host->io->sleep_us(w->host->io->context, 1000); }
+static void report(PeachWlfw *w, const char *s, uint32_t a, uint32_t b)
+{ if (w->ops.log) w->ops.log(w->ops.context, s, a, b); }
+
+static void header(unsigned char *p, unsigned type, uint32_t sn, uint32_t sp,
+                   uint32_t dn, uint32_t dp, unsigned size, unsigned confirm)
+{
+    p32(p, 1); p32(p + 4, type); p32(p + 8, sn); p32(p + 12, sp);
+    p32(p + 16, confirm); p32(p + 20, size); p32(p + 24, dn); p32(p + 28, dp);
+}
+
+static void control(PeachWlfw *w, unsigned type, uint32_t sn, uint32_t sp,
+                    uint32_t dn, uint32_t dp)
+{
+    if (w->error) return;
+    if (type == 2 && w->hello_sent) return;
+    if (w->control_count == 64) { w->error = PeachWlfwStorage; return; }
+    unsigned char *p = w->controls[w->control_wp];
+    memset(p, 0, 52);
+    header(p, type, sn, sp, dn, dp, 20, 0);
+    p32(p + 32, type);
+    if (type == 7) { p32(p + 36, sn); p32(p + 40, sp); }
+    w->control_wp = (w->control_wp + 1) & 63;
+    w->control_count++;
+    if (type == 2) w->hello_sent = 1;
+}
+
+/* Validate the complete TLV stream, including unknown extensions, before
+ * interpreting it. Duplicate requested fields cannot override earlier data. */
+static int tlvs_valid(const unsigned char *p, size_t n)
+{
+    while (n) {
+        if (n < 3 || u16(p + 1) > n - 3) return 0;
+        size_t step = 3 + u16(p + 1);
+        p += step; n -= step;
+    }
+    return 1;
+}
+static const unsigned char *field(PeachWlfw *w, const unsigned char *p, size_t n,
+                                  unsigned type, size_t *size)
+{
+    const unsigned char *found = NULL;
+    *size = 0;
+    while (n) {
+        size_t len = u16(p + 1), step = len + 3;
+        if (p[0] == type) {
+            if (found) { w->error = PeachWlfwProtocol; return NULL; }
+            found = p + 3; *size = len;
+        }
+        p += step; n -= step;
+    }
+    return found;
+}
+
+static void memory_request(PeachWlfw *w, const unsigned char *p, size_t n)
+{
+    size_t len;
+    const unsigned char *v = field(w, p, n, 1, &len);
+    if (w->error) return;
+    if (!v || !len || !v[0] || v[0] > PEACH_WLFW_SEGMENTS || w->memory_requested) {
+        w->error = PeachWlfwProtocol; return;
+    }
+    unsigned count = *v++; len--;
+    for (unsigned i = 0; i < count; i++) {
+        if (len < 9) { w->error = PeachWlfwProtocol; return; }
+        uint32_t bytes = u32(v), type = u32(v + 4);
+        unsigned cfg = v[8];
+        v += 9; len -= 9;
+        report(w, "requested memory type/bytes", type, bytes);
+        if (cfg) report(w, "requested memory type/configs", type, cfg);
+        /* LPASS_SHARED (11) uses the same owned DMA allocation as CNSS2;
+         * its optional WFDS/ADSP consumer is not enabled here. MSA and
+         * pageable/MLO memory still need additional ownership or protocols. */
+        if (!bytes || type < 1 || type > 12 || type == 6 || type == 8 ||
+            type == 9 || cfg > 2 || cfg * 13 > len) {
+            w->error = PeachWlfwUnsupported; return;
+        }
+        for (unsigned j = 0; j < cfg; j++, v += 13, len -= 13) {
+            uint64_t offset = u64(v);
+            uint32_t size = u32(v + 8);
+            if (v[12] || offset > bytes || size > bytes - offset) {
+                report(w, "unsupported memory config offset/size", (uint32_t)offset, size);
+                report(w, "unsupported memory config type/secure", type, v[12]);
+                w->error = PeachWlfwUnsupported; return;
+            }
+        }
+        w->memory[i].size = bytes; w->memory[i].type = type;
+    }
+    if (len) { w->error = PeachWlfwProtocol; return; }
+    w->memory_count = count; w->memory_requested = 1;
+}
+
+static void qmi_receive(PeachWlfw *w, const unsigned char *p, size_t n)
+{
+    if (n < 7 || u16(p + 5) != n - 7 || !tlvs_valid(p + 7, n - 7)) {
+        w->error = PeachWlfwProtocol; return;
+    }
+    unsigned flags = p[0], txn = u16(p + 1), message = u16(p + 3);
+    const unsigned char *data = p + 7;
+    size_t bytes = n - 7;
+    if (flags == 2) { /* QMI_RESPONSE */
+        if (!w->awaiting || txn != w->awaiting || message != w->message) return;
+        size_t len;
+        const unsigned char *result = field(w, data, bytes, 2, &len);
+        if (w->error) return;
+        if (!result || len != 4 || bytes > sizeof(w->response) || w->response_ready) {
+            w->error = PeachWlfwProtocol; return;
+        }
+        w->result = u16(result); w->remote_error = u16(result + 2);
+        memcpy(w->response, data, bytes);
+        w->response_bytes = (unsigned)bytes; w->response_ready = 1;
+    } else if (flags == 4) { /* QMI_INDICATION */
+        switch (message) {
+        case 0x35: memory_request(w, data, bytes); break;
+        case 0x37: w->memory_ready = 1; break;
+        case 0x38: w->firmware_ready = 1; break;
+        case 0x3e: { /* CAL_DONE is an indication, never inferred from mode ACK. */
+            size_t len;
+            const unsigned char *size = field(w, data, bytes, 0x10, &len);
+            if (w->error || !w->calibration_active || w->calibration_seen ||
+                (size && (len != 8 || u64(size) > w->calibration.capacity))) {
+                w->error = PeachWlfwProtocol; return;
+            }
+            w->calibration_seen = 1;
+            report(w, "WLFW CAL_DONE bytes", size ? (uint32_t)u64(size) : 0, 0);
+            break;
+        }
+        case 0x5c: w->error = PeachMhiWrongEnvironment; break;
+        default: break;
+        }
+    } else { w->error = PeachWlfwProtocol; }
+}
+
+static void receive(void *context, const void *packet, size_t bytes)
+{
+    PeachWlfw *w = context;
+    const unsigned char *p = packet;
+    unsigned type, confirm, hdr, size;
+    uint32_t sn, sp, dn, dp;
+    if (w->error) return;
+    if (bytes < 16 || (bytes & 3)) { w->error = PeachWlfwProtocol; return; }
+    if (p[0] == 1 && bytes >= 32 && u32(p) == 1) {
+        hdr = 32; type = u32(p + 4); sn = u32(p + 8); sp = u32(p + 12);
+        confirm = !!u32(p + 16); size = u32(p + 20); dn = u32(p + 24); dp = u32(p + 28);
+    } else if (p[0] == 3) { /* Linux's QRTR_PROTO_VER_2 has wire version 3. */
+        hdr = 16u + p[3]; type = p[1]; confirm = p[2] & 1; size = u32(p + 4);
+        sn = u16(p + 8); sp = u16(p + 10); dn = u16(p + 12); dp = u16(p + 14);
+        if (sp == 0xfffe) sp = CTRL;
+        if (dp == 0xfffe) dp = CTRL;
+    } else { w->error = PeachWlfwProtocol; return; }
+    if (dp == 0xffff) dp = CTRL;
+    if (hdr > bytes || !size || size > bytes - hdr || ((size + 3u) & ~3u) != bytes - hdr ||
+        sn == w->local_node || sn == 0xffffffffu) { w->error = PeachWlfwProtocol; return; }
+    p += hdr;
+    if (type == 1) { /* QRTR_TYPE_DATA */
+        if (dn != w->local_node || dp != w->local_port) return;
+        /* The firmware's watermark must be acknowledged after actual delivery.
+         * Queue it; the RX callback must not wait for its own MHI completion. */
+        if (w->server && sn == w->server_node && sp == w->server_port) qmi_receive(w, p, size);
+        if (!w->error && confirm) control(w, 7, dn, dp, sn, sp);
+        return;
+    }
+    if (size < 20 || u32(p) != type) { w->error = PeachWlfwProtocol; return; }
+    if (type == 7) {
+        /* RESUME_TX names the receiver of the original DATA, i.e. this
+         * flow's remote WLFW endpoint. qrtr_tx_resume keys by that payload,
+         * not by the sender's local endpoint or the outer source port. */
+        if (w->server && dn == w->local_node && sn == w->server_node &&
+            u32(p + 4) == w->server_node && u32(p + 8) == w->server_port)
+            w->flow_pending = 0;
+        return;
+    }
+    if (dp != CTRL) { w->error = PeachWlfwProtocol; return; }
+    if (type == 2) { /* HELLO */
+        if (!w->hello) {
+            w->peer = sn; w->hello = 1;
+            control(w, 2, w->local_node, CTRL, sn, CTRL);
+            report(w, "QRTR HELLO", sn, 0);
+        } else if (sn != w->peer) w->error = PeachWlfwProtocol;
+    } else if (type == 4) { /* NEW_SERVER: version in instance's low byte. */
+        uint32_t service = u32(p + 4), instance = u32(p + 8), node = u32(p + 12), port = u32(p + 16);
+        if (service == 0x45 && instance == 0x101) {
+            if (!port || port >= CTRL || node == w->local_node || node == 0xffffffffu ||
+                (w->server && (node != w->server_node || port != w->server_port))) {
+                w->error = PeachWlfwProtocol; return;
+            }
+            w->server_node = node; w->server_port = port; w->server = 1;
+            report(w, "WLFW service", node, port);
+        }
+    } else if ((type == 3 && sn == w->peer) ||
+               (type == 5 && u32(p + 12) == w->server_node && u32(p + 16) == w->server_port)) {
+        w->error = PeachMhiWrongEnvironment;
+    }
+}
+
+int peach_wlfw_init(PeachWlfw *w, PeachMhiHost *host, const PeachWlfwOps *ops)
+{
+    if (!w || !host || !host->io || !ops || !ops->allocate || !ops->file_read ||
+        !ops->iova_bytes || ops->iova_base >= 0x100000000ull ||
+        ops->iova_bytes > 0x100000000ull - ops->iova_base) return PeachMhiInvalid;
+    memset(w, 0, sizeof(*w));
+    w->host = host; w->ops = *ops; w->local_node = 1; w->local_port = 0x4000;
+    host->receive = receive; host->receive_context = w;
+    return 0;
+}
+
+static int flush_controls(PeachWlfw *w)
+{
+    while (w->control_count) {
+        int err = peach_mhi_host_send(w->host, w->controls[w->control_rp], 52);
+        if (err == -6) return 0;
+        if (err) return err;
+        w->control_rp = (w->control_rp + 1) & 63; w->control_count--;
+    }
+    return 0;
+}
+int peach_wlfw_poll(PeachWlfw *w)
+{
+    if (!w || !w->host) return PeachMhiInvalid;
+    if (w->error) return w->error;
+    WTRY(flush_controls(w));
+    WTRY(peach_mhi_host_poll(w->host, 32));
+    if (w->error) return w->error;
+    return flush_controls(w);
+}
+
+/* Payload is built in packet+39. All builders below have fixed schema bounds
+ * less than the 8192-byte IPCR MTU; no kernel stack packet arrays are used. */
+static size_t scalar(PeachWlfw *w, size_t n, unsigned type, uint64_t value, unsigned width)
+{
+    unsigned char *p = w->packet + 39 + n;
+    p[0] = type; p16(p + 1, width);
+    for (unsigned i = 0; i < width; i++) p[3 + i] = (unsigned char)(value >> (8 * i));
+    return n + 3 + width;
+}
+static int request(PeachWlfw *w, unsigned message, size_t bytes)
+{
+    if (w->awaiting || !w->server || bytes > sizeof(w->packet) - 42) return PeachMhiInvalid;
+    uint64_t end = now(w) + 10000000;
+    while (w->flow_pending >= QRTR_TX_FLOW_HIGH || w->control_count) {
+        WTRY(peach_wlfw_poll(w));
+        if (now(w) >= end) return PeachMhiTimeout;
+        if (w->flow_pending >= QRTR_TX_FLOW_HIGH || w->control_count) pause_poll(w);
+    }
+    if (!++w->transaction) ++w->transaction;
+    w->awaiting = w->transaction; w->message = (uint16_t)message; w->response_ready = 0;
+    header(w->packet, 1, w->local_node, w->local_port, w->server_node, w->server_port,
+        (unsigned)bytes + 7, w->flow_pending + 1 == QRTR_TX_FLOW_LOW);
+    w->packet[32] = 0; /* QMI_REQUEST */
+    p16(w->packet + 33, w->awaiting); p16(w->packet + 35, message); p16(w->packet + 37, (unsigned)bytes);
+    size_t length = (39 + bytes + 3) & ~(size_t)3;
+    memset(w->packet + 39 + bytes, 0, length - 39 - bytes);
+    int err;
+    while ((err = peach_mhi_host_send(w->host, w->packet, length)) == -6) {
+        WTRY(peach_wlfw_poll(w));
+        if (now(w) >= end) return PeachMhiTimeout;
+        pause_poll(w);
+    }
+    if (err) return err;
+    w->flow_pending++;
+    while (!w->response_ready) {
+        WTRY(peach_wlfw_poll(w));
+        if (now(w) >= end) { report(w, "QMI timeout", message, w->awaiting); return PeachMhiTimeout; }
+        if (!w->response_ready) pause_poll(w);
+    }
+    w->awaiting = 0;
+    if (w->result) { report(w, "QMI rejected", message, w->remote_error); return PeachWlfwRejected; }
+    return 0;
+}
+int peach_wlfw_read_word(PeachWlfw *w, uint32_t offset, unsigned memory_type, uint32_t *value)
+{
+    if (!w || !value || (offset & 3) || w->phase != 9 || !w->firmware_ready || w->awaiting)
+        return PeachMhiInvalid;
+    if (w->error) return w->error;
+    /* Matching cnss_utils IDL: three mandatory u32 TLVs, exactly 21 bytes.
+     * memory_type belongs to ATHDIAG, not the WLFW DMA allocation enum. */
+    size_t n = scalar(w, 0, 1, offset, 4);
+    n = scalar(w, n, 2, memory_type, 4);
+    n = scalar(w, n, 3, 4, 4);
+    int err = request(w, 0x30, n);
+    if (err == PeachMhiTimeout) {
+        /* This read has no state or DMA ownership to roll back. Retire its
+         * transaction so a late reply cannot occupy the next request. */
+        w->awaiting = 0; w->response_ready = 0;
+    }
+    if (err) return err;
+    size_t bytes;
+    const unsigned char *data = field(w, w->response, w->response_bytes, 0x10, &bytes);
+    if (w->error) return w->error;
+    /* QMI_DATA_LEN is u16 on the wire; data_valid is TLV presence only. */
+    if (!data || bytes != 6 || u16(data) != 4) return PeachWlfwProtocol;
+    *value = u32(data + 2);
+    return 0;
+}
+static int wait_flag(PeachWlfw *w, const unsigned *flag)
+{
+    uint64_t end = now(w) + 30000000;
+    while (!*flag) {
+        WTRY(peach_wlfw_poll(w));
+        if (now(w) >= end) return PeachMhiTimeout;
+        if (!*flag) pause_poll(w);
+    }
+    return 0;
+}
+
+static int respond_memory(PeachWlfw *w)
+{
+    unsigned char *p = w->packet + 39;
+    p[0] = 1; p16(p + 1, 1 + w->memory_count * 17); p[3] = w->memory_count;
+    for (unsigned i = 0; i < w->memory_count; i++) {
+        PeachWlfwMemory *m = &w->memory[i];
+        if (m->type == 4 && w->calibration.bytes) {
+            m->dma = w->calibration; /* Mission firmware consumes real calibration output. */
+        } else if (w->ops.allocate(w->ops.context, m->size, &m->dma)) return PeachWlfwStorage;
+        if (!m->dma.bytes || m->dma.capacity < m->size || m->dma.iova < w->ops.iova_base ||
+            m->dma.iova - w->ops.iova_base >= w->ops.iova_bytes ||
+            m->size > w->ops.iova_bytes - (m->dma.iova - w->ops.iova_base)) return PeachWlfwStorage;
+        if (m->type == 4) w->calibration = m->dma;
+        unsigned char *v = p + 4 + i * 17;
+        p64(v, m->dma.iova); p32(v + 8, m->size); p32(v + 12, m->type); v[16] = 0;
+        report(w, "firmware memory", m->type, m->size);
+        report(w, "firmware memory IOVA", m->type, (uint32_t)m->dma.iova);
+    }
+    WTRY(request(w, 0x36, 4 + w->memory_count * 17));
+    w->memory_responded = 1;
+    return 0;
+}
+
+static int download_bdf(PeachWlfw *w, const char *name, unsigned type)
+{
+    uint64_t total;
+    if (w->ops.file_read(w->ops.context, name, 0, NULL, 0, &total) || !total || total > 0x200000)
+        return PeachWlfwStorage;
+    for (uint64_t off = 0, segment = 0; off < total; segment++) {
+        unsigned bytes = (unsigned)(total - off > 6144 ? 6144 : total - off);
+        size_t n = scalar(w, 0, 1, 1, 1);
+        n = scalar(w, n, 0x10, w->board_id, 4);
+        n = scalar(w, n, 0x11, total - off, 4); /* CNSS sends remaining bytes. */
+        n = scalar(w, n, 0x12, segment, 4);
+        unsigned char *p = w->packet + 39 + n;
+        p[0] = 0x13; p16(p + 1, bytes + 2); p16(p + 3, bytes);
+        if (w->ops.file_read(w->ops.context, name, off, p + 5, bytes, NULL)) return PeachWlfwStorage;
+        n += 5 + bytes;
+        n = scalar(w, n, 0x14, off + bytes == total, 1);
+        n = scalar(w, n, 0x15, type, 1);
+        WTRY(request(w, 0x25, n));
+        size_t len;
+        const unsigned char *flags = field(w, w->response, w->response_bytes, 0x10, &len);
+        if (w->error) return w->error;
+        if (flags) {
+            if (len != 8) return PeachWlfwProtocol;
+            if (u64(flags) & 6) return PeachWlfwUnsupported; /* radio off or extra CBC file required. */
+        }
+        off += bytes;
+    }
+    report(w, "board file downloaded", type, (uint32_t)total);
+    return 0;
+}
+
+static int download_dma_file(PeachWlfw *w, const char *name, unsigned message)
+{
+    uint64_t total;
+    PeachMhiDma dma = {0};
+    if (w->ops.file_read(w->ops.context, name, 0, NULL, 0, &total) || !total || total > 0x200000 ||
+        w->ops.allocate(w->ops.context, (size_t)total, &dma) || !dma.bytes || dma.capacity < total ||
+        dma.iova < w->ops.iova_base || dma.iova - w->ops.iova_base >= w->ops.iova_bytes ||
+        total > w->ops.iova_bytes - (dma.iova - w->ops.iova_base)) return PeachWlfwStorage;
+    if (w->ops.file_read(w->ops.context, name, 0, dma.bytes, (size_t)total, NULL)) return PeachWlfwStorage;
+    w->host->barrier(w->host->io->context);
+    size_t n = scalar(w, 0, 1, dma.iova, 8);
+    n = scalar(w, n, 2, total, 4);
+    WTRY(request(w, message, n));
+    report(w, "microcode downloaded", message, (uint32_t)total);
+    return 0;
+}
+
+/* cnss2/qmi.c's QDSS config download, also required by TB323FU's WCN7860
+ * ath12k port (0024). This phone's captured Android log selects the v2
+ * fallback below. These are this phone's files, read from its active slot. */
+static int download_qdss(PeachWlfw *w)
+{
+    static const char *const names[] = {
+        "peach/qdss_trace_config_perf_v2.cfg", "peach/qdss_trace_config_v2.cfg"
+    };
+    uint64_t total = 0; const char *name = NULL;
+    for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+        if (!w->ops.file_read(w->ops.context, names[i], 0, NULL, 0, &total)) {
+            name = names[i]; break;
+        }
+    }
+    if (!name || !total || total > 0x200000) return PeachWlfwStorage;
+    for (uint64_t off = 0, segment = 0; off < total; segment++) {
+        unsigned bytes = total - off > 6144 ? 6144 : (unsigned)(total - off);
+        size_t n = scalar(w, 0, 0x10, total - off, 4);
+        n = scalar(w, n, 0x11, segment, 4);
+        unsigned char *p = w->packet + 39 + n;
+        p[0] = 0x12; p16(p + 1, bytes + 2); p16(p + 3, bytes);
+        if (w->ops.file_read(w->ops.context, name, off, p + 5, bytes, NULL)) return PeachWlfwStorage;
+        n += 5 + bytes;
+        n = scalar(w, n, 0x13, off + bytes == total, 1);
+        WTRY(request(w, 0x44, n));
+        off += bytes;
+    }
+    report(w, "QDSS configuration downloaded", 0x44, (uint32_t)total);
+    return 0;
+}
+
+int peach_wlfw_bootstrap(PeachWlfw *w)
+{
+    if (!w || !w->host || !w->host->ipcr_up || w->phase) return PeachMhiInvalid;
+    w->phase = 1;
+    control(w, 2, w->local_node, CTRL, 0xffffffffu, CTRL);
+    WTRY(wait_flag(w, &w->hello));
+    WTRY(wait_flag(w, &w->server));
+    size_t n = scalar(w, 0, 0x15, 0x4b4e454c, 4); /* WLFW_CLIENT_ID ABI. */
+    n = scalar(w, n, 0x16, 1, 1); n = scalar(w, n, 0x17, 1, 1);
+    n = scalar(w, n, 0x18, 1, 1); n = scalar(w, n, 0x24, 1, 1);
+    n = scalar(w, n, 0x1b, 1, 1); /* CAL_DONE */
+    WTRY(request(w, 0x20, n));
+    w->phase = 2;
+    n = scalar(w, 0, 0x10, 1, 4);
+    n = scalar(w, n, 0x14, 1, 1); /* BDF */
+    n = scalar(w, n, 0x16, 1, 1); /* actual PHY microcode via M3_INFO */
+    n = scalar(w, n, 0x17, 0, 1); /* no cached M3 */
+    n = scalar(w, n, 0x1a, w->calibration_done, 1);
+    n = scalar(w, n, 0x21, 0, 1); n = scalar(w, n, 0x33, 0, 1); /* no MLO/dynamic reallocation */
+    /* CNSS and ath12k announce AUX_UC_SUPPORT before loading AUX microcode. */
+    n = scalar(w, n, 0x27, 1u << 6, 8);
+    unsigned char *p = w->packet + 39 + n;
+    p[0] = 0x1f; p16(p + 1, 48); memset(p + 3, 0, 48);
+    p64(p + 3, w->ops.iova_base); p64(p + 11, w->ops.iova_bytes); n += 51;
+    WTRY(request(w, 0x34, n));
+    WTRY(wait_flag(w, &w->memory_requested));
+    w->phase = 3;
+    WTRY(respond_memory(w));
+    WTRY(wait_flag(w, &w->memory_ready));
+    report(w, "WLFW memory ready", w->memory_count, 0);
+    w->phase = 4;
+    WTRY(request(w, 0x24, 0));
+    size_t len;
+    p = (unsigned char *)field(w, w->response, w->response_bytes, 0x10, &len);
+    report(w, "WLFW capability field/bytes", 0x10, (uint32_t)len);
+    if (!p || len != 8 || w->error) return PeachWlfwProtocol;
+    w->chip_id = u32(p);
+    p = (unsigned char *)field(w, w->response, w->response_bytes, 0x11, &len);
+    report(w, "WLFW capability field/bytes", 0x11, (uint32_t)len);
+    if (w->error || (p && len != 4)) return PeachWlfwProtocol;
+    /* CNSS uses 0xff when the optional board_info is absent. */
+    w->board_id = p ? u32(p) : 0xff;
+    p = (unsigned char *)field(w, w->response, w->response_bytes, 0x12, &len);
+    report(w, "WLFW capability field/bytes", 0x12, (uint32_t)len);
+    if (!p || len != 4 || w->error) return PeachWlfwProtocol;
+    w->soc_id = u32(p);
+    report(w, "WLFW chip/board", w->chip_id, w->board_id);
+    /* These are this phone's captured Android-selected files. Do not select
+     * an unrelated board file from an older Snapdragon port. */
+    WTRY(download_bdf(w, "peach/regdb_xiaomi.bin", 4));
+    WTRY(download_bdf(w, "peach/bd_p1.elf", 1));
+    w->phase = 5;
+    WTRY(download_dma_file(w, "peach/phy_ucode20.elf", 0x3c));
+    WTRY(download_dma_file(w, "peach/aux_ucode20.elf", 0x5a));
+    WTRY(download_qdss(w));
+    WTRY(wait_flag(w, &w->firmware_ready));
+    w->phase = 6;
+    report(w, "WLFW FW_INIT_DONE", w->soc_id, w->memory_count);
+    return 0;
+}
+
+/* CNSS cold-boot sequence, also recorded in Armada patch 1151. The
+ * endpoint has not seen CE/WLAN_CFG yet. No calibration data is fabricated
+ * or written to persistent storage. */
+int peach_wlfw_calibrate(PeachWlfw *w)
+{
+    if (!w || w->phase != 6 || !w->firmware_ready || w->calibration_done ||
+        !w->calibration.bytes || w->calibration_active) return PeachMhiInvalid;
+    uint64_t start = now(w);
+    w->calibration_active = 1;
+    size_t n = scalar(w, 0, 1, 7, 4); /* CALIBRATION */
+    n = scalar(w, n, 0x10, 0, 1);
+    WTRY(request(w, 0x22, n));
+    WTRY(wait_flag(w, &w->calibration_seen));
+    w->host->barrier(w->host->io->context);
+    report(w, "WLFW cold calibration completed ms/IOVA", (uint32_t)((now(w) - start) / 1000),
+        (uint32_t)w->calibration.iova);
+    n = scalar(w, 0, 1, 4, 4); /* OFF before endpoint reset */
+    n = scalar(w, n, 0x10, 0, 1);
+    WTRY(request(w, 0x22, n));
+    w->calibration_done = 1;
+    return 0;
+}
+
+int peach_wlfw_wlan_enable(PeachWlfw *w, const unsigned char mac[6])
+{
+    if (!w || w->phase != 6 || !w->firmware_ready) return PeachMhiInvalid;
+    if (w->error) return w->error;
+    if (!mac || (mac[0] & 1) || !memcmp(mac, "\0\0\0\0\0\0", 6)) return PeachMhiInvalid;
+    /* CNSS provisions the collected host address before WLAN_CFG/MISSION;
+     * otherwise this firmware reports an all-zero MAC in WMI READY. */
+    unsigned char *p = w->packet + 39;
+    p[0] = 0x10; p16(p + 1, 6); memcpy(p + 3, mac, 6);
+    WTRY(request(w, 0x33, 9));
+    report(w, "WLFW MAC provisioned", 0, 0);
+    /* cnss2/qmi.c WLAN_CFG schema: variable arrays carry an 8-bit count,
+     * all pipe fields are 32-bit. Use the vendor's Peach-selected table,
+     * including its terminator. No shadow/MSI capabilities are asserted. */
+    p = w->packet + 39;
+    static const char version[] = "UniXNU-Nezha";
+    p[0] = 0x10; p16(p + 1, sizeof(version) - 1);
+    memcpy(p + 3, version, sizeof(version) - 1);
+    size_t n = 3 + sizeof(version) - 1;
+    p += n;
+    p[0] = 0x11; p16(p + 1, 1 + 9 * 20); p[3] = 9;
+    for (unsigned i = 0; i < 9; i++) {
+        const PeachCeTarget *t = &peach_ce_target[i];
+        unsigned char *v = p + 4 + i * 20;
+        p32(v, t->pipe); p32(v + 4, t->direction); p32(v + 8, t->entries);
+        p32(v + 12, t->max_bytes); p32(v + 16, t->flags);
+    }
+    n += 4 + 9 * 20; p = w->packet + 39 + n;
+    p[0] = 0x12; p16(p + 1, 1 + 15 * 12); p[3] = 15;
+    for (unsigned i = 0; i < 15; i++) {
+        const PeachCeService *s = &peach_ce_services[i];
+        unsigned char *v = p + 4 + i * 12;
+        p32(v, s->service); p32(v + 4, s->direction); p32(v + 8, s->pipe);
+    }
+    n += 4 + 15 * 12;
+    w->phase = 7;
+    WTRY(request(w, 0x23, n));
+    n = scalar(w, 0, 1, 0, 4); /* MISSION */
+    n = scalar(w, n, 0x10, 0, 1); /* no hardware debug */
+    w->phase = 8;
+    WTRY(request(w, 0x22, n));
+    w->phase = 9;
+    report(w, "WLFW MISSION acknowledged", 9, 15);
+    return 0;
+}
diff --git a/bsd/dev/qcom/PeachWlfw.h b/bsd/dev/qcom/PeachWlfw.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/qcom/PeachWlfw.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PEACH_WLFW_H
+#define PEACH_WLFW_H
+#include "PeachMhiHost.h"
+
+enum { PeachWlfwProtocol = -10, PeachWlfwRejected = -11,
+       PeachWlfwStorage = -12, PeachWlfwUnsupported = -13 };
+#define PEACH_WLFW_SEGMENTS 52u
+
+typedef struct {
+    void *context;
+    /* Return real, zeroed coherent DMA in this endpoint's domain. All storage
+     * is retained, even if a later allocation/transaction fails. */
+    int (*allocate)(void *, size_t, PeachMhiDma *);
+    int (*file_read)(void *, const char *, uint64_t, void *, size_t, uint64_t *);
+    void (*log)(void *, const char *, uint32_t, uint32_t);
+    uint64_t iova_base, iova_bytes;
+} PeachWlfwOps;
+
+typedef struct {
+    uint32_t size, type;
+    PeachMhiDma dma;
+} PeachWlfwMemory;
+
+/* One worker, one outstanding QMI transaction. Receive callbacks never wait,
+ * allocate, read UFS, or recursively poll MHI. Control replies have a bounded
+ * queue; overflow is an error, never a silent lost flow-control message. */
+typedef struct {
+    PeachMhiHost *host;
+    PeachWlfwOps ops;
+    uint32_t peer, server_node, server_port, local_node, local_port;
+    uint16_t transaction, awaiting, message, result, remote_error;
+    unsigned hello, hello_sent, server, flow_pending, response_ready, response_bytes;
+    unsigned control_rp, control_wp, control_count;
+    unsigned memory_requested, memory_responded, memory_count, memory_ready, firmware_ready;
+    unsigned phase, calibration_active, calibration_seen, calibration_done;
+    PeachMhiDma calibration; /* Retained CAL region across the one firmware restart. */
+    uint32_t chip_id, board_id, soc_id;
+    int error;
+    unsigned char controls[64][52];
+    unsigned char packet[PEACH_MHI_IPCR_MTU];
+    unsigned char response[2304];
+    PeachWlfwMemory memory[PEACH_WLFW_SEGMENTS];
+} PeachWlfw;
+
+/* Install before IPCR is opened so an early HELLO cannot be lost. */
+int peach_wlfw_init(PeachWlfw *, PeachMhiHost *, const PeachWlfwOps *);
+int peach_wlfw_poll(PeachWlfw *);
+/* Real service discovery, host memory, BDF/regdb and PHY/AUX download. A zero
+ * result means FW_INIT_DONE was received, not that a Wi-Fi NIC exists. CE,
+ * HTC/WMI/HTT and network integration belong to the subsequent data path. */
+int peach_wlfw_bootstrap(PeachWlfw *);
+/* Before WLAN_CFG: wait for real CAL_DONE, then OFF. The caller resets the
+ * endpoint and boots mission firmware with this same retained CAL region. */
+int peach_wlfw_calibrate(PeachWlfw *);
+/* Call with CE DMA prepared, before enabling the host-owned CE rings. Does
+ * not advertise MSI, shadow-register acceleration, MLO or a working NIC. */
+int peach_wlfw_wlan_enable(PeachWlfw *, const unsigned char mac[6]);
+/* Optional one-word diagnostic through WLFW ATHDIAG_READ (0x30). The
+ * firmware may reject it; no direct host access to protected SRAM. */
+int peach_wlfw_read_word(PeachWlfw *, uint32_t offset, unsigned memory_type, uint32_t *value);
+#endif
diff --git a/bsd/dev/qcom/PeachWmi.c b/bsd/dev/qcom/PeachWmi.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/qcom/PeachWmi.c
@@ -0,0 +1,1319 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Minimal single-station WMI initialization. Wire offsets/tags are from
+ * fw-api/fw/{wmi.h,wmi_unified.h,wmi_tlv_defs.h,wmi_services.h,wlan_defs.h}
+ * in sm8850-modules fdd80ae0d6665f8a018c3e06a6152bafdaf1269d.
+ * Resources follow wlan_tgt_def_config.h with one vdev and eight peers.
+ * No capability is inferred from a command send or a successful HTC setup. */
+#include "PeachWmi.h"
+#if defined(KERNEL)
+#include <libkern/libkern.h>
+#else
+#include <string.h>
+#endif
+enum { TAG_U32 = 16, TAG_ARRAY = 18, TAG_SERVICE = 32, TAG_MEMORY = 34,
+       TAG_READY = 35, TAG_INIT = 74, TAG_RESOURCES = 75, TAG_CHUNK = 76,
+       TAG_EXT = 428, TAG_AVAILABLE = 559, TAG_EXT2 = 820,
+       TAG_MAC_PHY = 528, TAG_HW_CAP = 529, TAG_SOC_CAP = 530,
+       TAG_HAL_REG = 531,
+       TAG_SCAN_EVENT = 36, TAG_MGMT = 44, TAG_SCAN = 77, TAG_CHANNELS = 79, TAG_CHANNEL = 80,
+       TAG_VDEV = 86, TAG_STREAMS = 411, TAG_RULE = 608, TAG_REG = 609,
+       TAG_RULE_EXT = 937, TAG_REG_EXT = 938,
+       TAG_PEER_CREATE = 97, TAG_PEER_DELETE = 98, TAG_PEER_QUEUE = 549,
+       TAG_PEER_CONFIRM = 868, TAG_PEER_DELETED = 451,
+       TAG_START = 88, TAG_STARTED = 40, TAG_STOP = 93, TAG_STOPPED = 41,
+       TAG_MGMT_TX = 422, TAG_MGMT_DONE = 423, TAG_TX_PARAMS = 644,
+       TAG_ASSOC = 101, TAG_ASSOC_CONF = 434, TAG_VHT_RATES = 102, TAG_UP = 92,
+       TAG_KEY = 96, TAG_KEY_DONE = 42,
+       TAG_FW_READY = 1321, TAG_MODE = 1322, TAG_MODE_RESPONSE = 1323,
+       RESOURCE_WORDS = 88, VDEVS = 1, PEERS = 8 };
+enum { MGMT_RX_ENTRIES = 128, MGMT_RX_BYTES = 3520, MGMT_RX_BUFFERS = 1152,
+       MGMT_RX_STORAGE = MGMT_RX_BUFFERS + MGMT_RX_ENTRIES * MGMT_RX_BYTES };
+static const uint32_t host_abi[6] = {0x01000000, 1822, 0x5f414351, 0x4c4d, 0, 0};
+#define WTRY(w, expr) do { int err_ = (expr); if (err_) { (w)->error = err_; return err_; } } while (0)
+static uint32_t u32(const void *p) { uint32_t v; memcpy(&v, p, 4); return v; }
+static uint16_t u16(const void *p) { uint16_t v; memcpy(&v, p, 2); return v; }
+static void p32(void *p, uint32_t v) { memcpy(p, &v, 4); }
+static void tlv(unsigned char *p, unsigned tag, unsigned bytes) { p32(p, tag << 16 | bytes); }
+static int bad(PeachWmi *w) { return w->error = PeachCeProtocol; }
+static PeachWmiPeer *peer_find(PeachWmi *w, const unsigned char mac[6])
+{
+    for (unsigned i = 0; i < PEACH_WMI_PEERS; i++)
+        if (w->peers[i].used && !memcmp(w->peers[i].mac, mac, 6)) return &w->peers[i];
+    return NULL;
+}
+static void peer_mac(unsigned char *p, const unsigned char mac[6])
+{
+    p32(p, (uint32_t)mac[0] | (uint32_t)mac[1] << 8 |
+        (uint32_t)mac[2] << 16 | (uint32_t)mac[3] << 24);
+    p32(p + 4, (uint32_t)mac[4] | (uint32_t)mac[5] << 8);
+}
+static void report(PeachWmi *w, const char *s, uint32_t a, uint32_t b)
+{ if (w->ops.log) w->ops.log(w->ops.context, s, a, b); }
+static unsigned service(PeachWmi *w, unsigned id)
+{ return id < 1024 && ((w->services[id / 32] >> (id & 31)) & 1); }
+static void add_service(PeachWmi *w, unsigned id)
+{ if (id < 1024) w->services[id / 32] |= 1u << (id & 31); }
+static int abi_compatible(const unsigned char *p)
+{
+    for (unsigned i = 0; i < 6; i++)
+        if (i != 1 && u32(p + 4 * i) != host_abi[i]) return 0;
+    return 1; /* vendor compares namespace + major/minor, ignores revision */
+}
+static int tlvs_valid(const unsigned char *p, size_t n)
+{
+    while (n) {
+        if (n < 4) return 0;
+        unsigned len = u32(p) & 0xffff;
+        /* ARRAY_BYTE and later headers need not be word aligned. The
+         * vendor helper advances by header+length; all loads use memcpy. */
+        if (len > n - 4) return 0;
+        p += 4 + len; n -= 4 + len;
+    }
+    return 1;
+}
+int peach_wmi_init(PeachWmi *w, PeachHtc *h, const PeachWmiOps *ops)
+{
+    if (!w || !h || !ops || !ops->allocate || !ops->barrier ||
+        !ops->iova_bytes || ops->iova_base >= 0x100000000ull ||
+        ops->iova_bytes > 0x100000000ull - ops->iova_base) return PeachMhiInvalid;
+    memset(w, 0, sizeof(*w)); w->htc = h; w->ops = *ops;
+    return 0;
+}
+static int service_ready(PeachWmi *w, const unsigned char *p, size_t n)
+{
+    unsigned stage = 0, count = 0, seen_memory = 0;
+    if (w->service_ready) return bad(w);
+    while (n) {
+        unsigned tag = u32(p) >> 16, len = u32(p) & 0xffff;
+        if (!stage) {
+            if (tag != TAG_SERVICE || len < 128 || !abi_compatible(p + 8)) return bad(w);
+            for (unsigned i = 0; i < 6; i++) w->firmware_abi[i] = u32(p + 8 + i * 4);
+            w->chains = u32(p + 40); w->max_fragments = u32(p + 36);
+            count = u32(p + 76);
+            if (!w->chains || w->chains > 8 || count > PEACH_WMI_MEMORY_REQUESTS) return bad(w);
+            w->requests = count;
+        } else if (stage == 2) {
+            if (tag != TAG_U32 || len != 128) return bad(w);
+            /* Legacy service bitmap uses FOUR bits per u32, as specified
+             * by WMI_SERVICE_IS_ENABLED; extended bitmaps use 32. */
+            for (unsigned i = 0; i < 128; i++)
+                if (u32(p + 4 + (i / 4) * 4) & (1u << (i & 3))) add_service(w, i);
+        } else if (stage == 3) {
+            if (tag != TAG_ARRAY || len != count * 20) return bad(w);
+            for (unsigned i = 0; i < count; i++) {
+                const unsigned char *v = p + 4 + i * 20;
+                if (u32(v) != (TAG_MEMORY << 16 | 16)) return bad(w);
+                PeachWmiMemory *m = &w->memory[i];
+                m->id = u32(v + 4); m->unit_size = u32(v + 8);
+                m->flags = u32(v + 12); m->units = u32(v + 16);
+                if (!m->unit_size || m->flags & ~15u) return bad(w);
+                for (unsigned j = 0; j < i; j++) if (w->memory[j].id == m->id) return bad(w);
+            }
+            seen_memory = 1;
+        }
+        p += len + 4; n -= len + 4; stage++;
+    }
+    if (!seen_memory) return bad(w);
+    w->service_ready = 1;
+    report(w, "WMI SERVICE_READY chains/memory", w->chains, w->requests);
+    return 0;
+}
+static int radio_capabilities(PeachWmi *w, const unsigned char *p, size_t n)
+{
+    struct Mode { uint32_t id, phys, type, seen; } modes[32];
+    unsigned stage = 0, count = 0, used = 0, seen = 0;
+    PeachWmiRadio selected = {0};
+    while (n) {
+        unsigned tag = u32(p) >> 16, len = u32(p) & 0xffff;
+        if (stage == 1) {
+            if (tag != TAG_SOC_CAP || len < 8) return bad(w);
+            count = u32(p + 4);
+            if (!count || count > 32) return bad(w);
+        } else if (stage == 2) {
+            if (tag != TAG_ARRAY || !tlvs_valid(p + 4, len)) return bad(w);
+            for (size_t off = 4; off < len + 4;) {
+                const unsigned char *v = p + off;
+                unsigned bytes = u32(v) & 0xffff;
+                if (u32(v) >> 16 != TAG_HW_CAP || bytes < 12 || used >= count) return bad(w);
+                struct Mode *m = &modes[used];
+                m->id = u32(v + 4); m->phys = u32(v + 8); m->type = u32(v + 12); m->seen = 0;
+                if (!m->phys) return bad(w);
+                for (unsigned j = 0; j < used; j++) if (modes[j].id == m->id) return bad(w);
+                used++; off += 4 + bytes;
+            }
+            if (used != count) return bad(w);
+        } else if (stage == 3) {
+            if (tag != TAG_ARRAY || !tlvs_valid(p + 4, len)) return bad(w);
+            for (size_t off = 4; off < len + 4;) {
+                const unsigned char *v = p + off;
+                unsigned bytes = u32(v) & 0xffff, i;
+                /* Fixed ABI: 60 words including tag; two embedded 10-word
+                 * PPE structures precede lmac_id at word 50. No compact ABI. */
+                if (u32(v) >> 16 != TAG_MAC_PHY || bytes < 236) return bad(w);
+                unsigned id = u32(v + 4), phy = u32(v + 12);
+                for (i = 0; i < used && modes[i].id != id; i++) {}
+                if (i == used || phy >= 32 || !(modes[i].phys & (1u << phy)) ||
+                    (modes[i].seen & (1u << phy))) return bad(w);
+                modes[i].seen |= 1u << phy;
+                /* Explicit single-PHY mode, advertised by this firmware.
+                 * Ignore multi-radio/MLO modes rather than guessing mapping. */
+                if ((modes[i].type & 0x7ffffffu) == 0 &&
+                    !(modes[i].phys & (modes[i].phys - 1))) {
+                    PeachWmiRadio c = {0};
+                    c.mode = id; c.pdev = u32(v + 8) & 0xffff; c.phy = phy;
+                    c.lmac = u32(v + 200); c.bands = u32(v + 20);
+                    c.low_2g = u32(v + 220); c.high_2g = u32(v + 224);
+                    c.low_5g = u32(v + 228); c.high_5g = u32(v + 232);
+                    c.tx_chains = ((c.bands & 1) ? u32(v + 52) : 0) |
+                                  ((c.bands & 2) ? u32(v + 84) : 0);
+                    c.rx_chains = ((c.bands & 1) ? u32(v + 56) : 0) |
+                                  ((c.bands & 2) ? u32(v + 88) : 0);
+                    if (!c.pdev || c.pdev > 3 || c.phy >= 3 || c.lmac > 2 ||
+                        !c.bands || c.bands & ~3u || !c.tx_chains || !c.rx_chains ||
+                        (c.tx_chains | c.rx_chains) & ~0xffu)
+                        return bad(w);
+                    c.valid = 1;
+                    if (!selected.valid || (c.bands == 3 && selected.bands != 3)) selected = c;
+                }
+                off += bytes + 4;
+            }
+            for (unsigned i = 0; i < used; i++)
+                if (modes[i].seen != modes[i].phys) return bad(w);
+            seen = 1;
+        } else if (stage == 5) {
+            if (tag != TAG_ARRAY || !tlvs_valid(p + 4, len)) return bad(w);
+            unsigned matched = 0;
+            for (size_t off = 4; off < len + 4;) {
+                const unsigned char *v = p + off;
+                unsigned bytes = u32(v) & 0xffff;
+                if (u32(v) >> 16 != TAG_HAL_REG || bytes < 40) return bad(w);
+                if (selected.valid && u32(v + 4) == selected.phy) {
+                    if (matched++) return bad(w);
+                    /* Peach leaves the per-MAC ranges unset. Use its real
+                     * HAL ranges for the same PHY; later scan filtering
+                     * still intersects the firmware's regulatory rules. */
+                    if (!selected.low_2g && !selected.high_2g) {
+                        selected.low_2g = u32(v + 28); selected.high_2g = u32(v + 32);
+                    }
+                    if (!selected.low_5g && !selected.high_5g) {
+                        selected.low_5g = u32(v + 36); selected.high_5g = u32(v + 40);
+                    }
+                }
+                off += bytes + 4;
+            }
+        }
+        p += len + 4; n -= len + 4; stage++;
+    }
+    if (!seen || !selected.valid ||
+        ((selected.bands & 1) && (!selected.low_2g || selected.low_2g > selected.high_2g)) ||
+        ((selected.bands & 2) && (!selected.low_5g || selected.low_5g > selected.high_5g)))
+        return bad(w);
+    w->radio = selected;
+    report(w, "WMI single radio mode/pdev", selected.mode, selected.pdev);
+    report(w, "WMI single radio phy/lmac", selected.phy, selected.lmac);
+    report(w, "WMI PHY 2GHz low/high MHz", selected.low_2g, selected.high_2g);
+    report(w, "WMI PHY 5GHz low/high MHz", selected.low_5g, selected.high_5g);
+    return 0;
+}
+static int regulatory_event(PeachWmi *w, const unsigned char *p, size_t n, unsigned extended)
+{
+    unsigned len = u32(p) & 0xffff;
+    if (len < 56 || (u32(p) >> 16) != (extended ? TAG_REG_EXT : TAG_REG)) return bad(w);
+    unsigned phy = u32(p + 8);
+    if (phy >= 3) { report(w, "WMI regulatory untracked PHY", phy, u32(p + 4)); return 0; }
+    PeachWmiRegDomain *r = &w->regulatory[phy];
+    PeachWmiRegDomain next = {0};
+    next.status = u32(p + 4);
+    if (next.status) {
+        r->valid = 0; r->status = next.status;
+        if (r->generation == UINT32_MAX) return bad(w);
+        r->generation++;
+        return 0;
+    }
+    unsigned n2 = u32(p + 52), n5 = u32(p + 56);
+    if (n2 > PEACH_WMI_REG_RULES || n5 > PEACH_WMI_REG_RULES - n2) return bad(w);
+    next.alpha2 = u32(p + 12); next.country = u32(p + 20);
+    next.domain = u32(p + 24); next.dfs = u32(p + 28);
+    size_t off = len + 4;
+    if (n - off < 4 || u32(p + off) >> 16 != TAG_ARRAY) return bad(w);
+    unsigned array_bytes = u32(p + off) & 0xffff;
+    if (array_bytes > n - off - 4 || !tlvs_valid(p + off + 4, array_bytes)) return bad(w);
+    const unsigned char *v = p + off + 4;
+    unsigned count = 0;
+    for (size_t left = array_bytes; left;) {
+        unsigned bytes = u32(v) & 0xffff;
+        if (u32(v) >> 16 != (extended ? TAG_RULE_EXT : TAG_RULE) ||
+            bytes < (extended ? 16u : 12u)) return bad(w);
+        if (count < n2 + n5) {
+            PeachWmiRegRule *rule = &next.rules[count];
+            rule->frequencies = u32(v + 4); rule->bandwidth_power = u32(v + 8);
+            rule->flags = u32(v + 12);
+            unsigned low = rule->frequencies & 0xffff, high = rule->frequencies >> 16;
+            if (!low || low >= high || !(rule->bandwidth_power & 0xffff)) return bad(w);
+        }
+        count++; v += bytes + 4; left -= bytes + 4;
+    }
+    if (count < n2 + n5 || (!extended && count != n2 + n5)) return bad(w);
+    /* Repeated identical domain notifications do not revoke an active
+     * scan/association. Only a real rule change advances its generation. */
+    if (r->valid && r->alpha2 == next.alpha2 && r->country == next.country &&
+        r->domain == next.domain && r->dfs == next.dfs &&
+        r->count_2g == n2 && r->count_5g == n5 &&
+        !memcmp(r->rules, next.rules, (n2 + n5) * sizeof(next.rules[0]))) return 0;
+    if (r->generation == UINT32_MAX) return bad(w);
+    next.count_2g = n2; next.count_5g = n5; next.valid = 1;
+    next.generation = r->generation + 1; *r = next;
+    report(w, "WMI real regulatory PHY/country", phy, r->alpha2 & 0xffff);
+    return 0;
+}
+static int scan_event(PeachWmi *w, const unsigned char *p)
+{
+    if (u32(p) >> 16 != TAG_SCAN_EVENT || (u32(p) & 0xffff) < 24) return bad(w);
+    /* A late event belongs to its original request. Do not complete a new
+     * scan with it, or turn a stale completion into a transport failure. */
+    if (!w->scan_active || !w->scan_sent || u32(p + 16) != w->scan_requestor ||
+        u32(p + 20) != w->scan_id || u32(p + 24) != 0 || w->scan_finished) return 0;
+    unsigned event = u32(p + 4), reason = u32(p + 8);
+    w->scan_event = event; w->scan_reason = reason;
+    if (event == 1) {
+        if (w->scan_started) return bad(w);
+        w->scan_started = 1;
+    } else if (event == 2) {
+        if (!reason && !w->scan_started) return bad(w);
+        w->scan_done = !reason; w->scan_finished = 1;
+    } else if (event == 0x10 || event == 0x40) {
+        /* DEQUEUED / START_FAILED terminate this request. PREEMPTED may
+         * resume and still needs its real terminal event or timeout. */
+        w->scan_finished = 1;
+    }
+    if (event == 8) report(w, "WMI scan channel MHz/reason", u32(p + 12), reason);
+    else report(w, "WMI real scan event/reason", event, reason);
+    return 0;
+}
+static void management_event(PeachWmi *w, const unsigned char *p, size_t n)
+{
+    unsigned len = u32(p) & 0xffff;
+    if (u32(p) >> 16 != TAG_MGMT || len < 68) { bad(w); return; }
+    size_t off = len + 4;
+    unsigned bytes = u32(p + 20), frequency = u32(p + 68);
+    if (n - off < 4 || u32(p + off) >> 16 != 17 ||
+        bytes > (u32(p + off) & 0xffff)) { bad(w); return; }
+    static unsigned reported;
+    if (reported < 48) {
+        reported++;
+        report(w, "WMI RX mgmt frequency/bytes", frequency, bytes);
+    }
+    if (u32(p + 24) || u32(p + 64) != w->radio.pdev || bytes < 24) return;
+    const unsigned char *frame = p + off + 4;
+    unsigned fc = u16(frame);
+    if (fc & 0x030f) return;
+    if (w->vdev_started && !w->vdev_stop_sent && frequency == w->vdev_frequency &&
+        !memcmp(frame + 16, w->vdev_bssid, 6) && !memcmp(frame + 10, w->vdev_bssid, 6) &&
+        (!memcmp(frame + 4, w->mac, 6) || (frame[4] & 1))) {
+        unsigned subtype = fc & 0xfc;
+        if (subtype == 0xb0 || subtype == 0x10 || subtype == 0x30 ||
+            subtype == 0xa0 || subtype == 0xc0) {
+            /* These are on-air packets, not firmware control responses.
+             * This legacy STA implements no action/PMF/fragment path. An
+             * unsupported or malformed frame must not poison the WMI
+             * transport, nor may ordinary RX pressure stop the radio. */
+            unsigned response = subtype == 0xb0 || subtype == 0x10 || subtype == 0x30;
+            if ((fc & 0x4400) || (u16(frame + 22) & 15) ||
+                bytes < (response ? 30u : 26u) || bytes > PEACH_WMI_MGMT_BYTES ||
+                (response && memcmp(frame + 4, w->mac, 6))) return;
+            if (w->mgmt_count == PEACH_WMI_MGMT_FRAMES) { w->mgmt_dropped++; return; }
+            PeachWmiMgmt *m = &w->mgmt[(w->mgmt_head + w->mgmt_count) % PEACH_WMI_MGMT_FRAMES];
+            m->bytes = bytes; m->frequency = frequency; m->rssi = (int32_t)u32(p + 48);
+            memcpy(m->frame, frame, bytes); w->mgmt_count++;
+        }
+    }
+    if (!w->scan_active || !w->scan_sent || w->scan_finished || bytes < 36) return;
+    unsigned i;
+    for (i = 0; i < w->channel_count && w->channels[i].frequency != frequency; i++) {}
+    if (i == w->channel_count) return;
+    if ((fc & 3) || ((fc & 0xfc) != 0x80 && (fc & 0xfc) != 0x50) ||
+        (frame[16] & 1) || !memcmp(frame + 16, "\0\0\0\0\0\0", 6)) return;
+    const unsigned char *ssid = NULL;
+    unsigned ssid_bytes = 0, dtim_period = 0;
+    for (size_t pos = 36; pos < bytes;) {
+        /* A management frame can arrive cut short: the WMI event reports the
+         * length the firmware kept. A 5 GHz beacon carrying HE/VHT elements is
+         * long enough to lose its tail, and treating that as malformed threw the
+         * whole AP away (log88: 13 BSS, all 2.4 GHz, not one 5 GHz beacon kept,
+         * although laoshi_5G sits at 5220 MHz and -32 dBm). The SSID and DTIM
+         * that did arrive are enough to list and join it, so a truncated
+         * trailing element ends the walk instead of discarding the frame. */
+        if (bytes - pos < 2) break;
+        unsigned size = frame[pos + 1];
+        if (size > bytes - pos - 2) break;
+        if (!frame[pos]) {
+            if (ssid || size > 32) break;
+            ssid = frame + pos + 2; ssid_bytes = size;
+        }
+        if (frame[pos] == 5 && size >= 4) dtim_period = frame[pos + 3];
+        pos += 2 + size;
+    }
+    if (!ssid) return;
+    if (w->scan_target_bytes && (ssid_bytes != w->scan_target_bytes ||
+        memcmp(ssid, w->scan_target_ssid, ssid_bytes) ||
+        (w->scan_target_bssid_valid && memcmp(frame + 16, w->scan_target_bssid, 6)))) return;
+    int rssi = (int32_t)u32(p + 48);
+    if (rssi < -127 || rssi > 0) rssi = -128;
+    for (i = 0; i < w->bss_count && memcmp(w->bss[i].bssid, frame + 16, 6); i++) {}
+    if (i == w->bss_count) {
+        if (i == PEACH_WMI_BSS_ENTRIES) {
+            /* A full cache must not retain only the first scanned
+             * channels and discard a nearby AP seen later in the sweep. */
+            unsigned weakest = 0;
+            for (unsigned j = 1; j < w->bss_count; j++)
+                if (w->bss[j].rssi < w->bss[weakest].rssi) weakest = j;
+            w->bss_dropped++;
+            if (rssi <= w->bss[weakest].rssi) return;
+            i = weakest;
+        } else w->bss_count++;
+        memset(&w->bss[i], 0, sizeof(w->bss[i]));
+    }
+    PeachWmiBss *b = &w->bss[i];
+    b->seen_us = w->htc->ops.now_us(w->htc->ops.context);
+    b->frequency = frequency; b->rssi = rssi;
+    memcpy(b->bssid, frame + 16, 6);
+    if (ssid_bytes || !b->ssid_bytes) {
+        b->ssid_bytes = ssid_bytes; memcpy(b->ssid, ssid, ssid_bytes);
+    }
+    b->beacon_interval = u16(frame + 32); b->capability = u16(frame + 34);
+    if (dtim_period) b->dtim_period = dtim_period;
+    b->ies_truncated = bytes - 36 > sizeof(b->ies);
+    b->ie_bytes = b->ies_truncated ? sizeof(b->ies) : bytes - 36;
+    memcpy(b->ies, frame + 36, b->ie_bytes);
+}
+void peach_wmi_receive(PeachWmi *w, const void *packet, size_t n)
+{
+    const unsigned char *p = packet;
+    if (!w || w->error) return;
+    if (!p || n < 8 || !tlvs_valid(p + 4, n - 4)) { bad(w); return; }
+    unsigned id = u32(p) & 0xffffff;
+    p += 4; n -= 4;
+    unsigned tag = u32(p) >> 16, len = u32(p) & 0xffff;
+    w->last_event = id; w->last_tag = tag;
+    switch (id) {
+    case 0x4002: /* WMI_CHAN_INFO_EVENTID: initial scan RF evidence */
+        if (tag != 38 || len < 56) { bad(w); return; }
+        if (w->scan_id == 0xa001) {
+            report(w, "WMI channel MHz/error", u32(p + 8), u32(p + 4));
+            report(w, "WMI channel RX frames/clear", u32(p + 36), u32(p + 20));
+            report(w, "WMI channel cycles/noise", u32(p + 24), u32(p + 16));
+        }
+        break;
+    case 0x1d004: { /* WMI_UPDATE_STATS_EVENTID, legacy PDEV base prefix */
+        if (tag != 70 || len < 32) { bad(w); return; }
+        report(w, "WMI radio stats pdev/count", u32(p + 32), u32(p + 8));
+        size_t off = len + 4;
+        if (!(u32(p + 4) & 4) || !u32(p + 8)) break;
+        if (n - off < 32 || u32(p + off) >> 16 != 17 ||
+            (u32(p + off) & 0xffff) < 28) { bad(w); return; }
+        const unsigned char *base = p + off + 4;
+        report(w, "WMI radio RX frames/cycles", u32(base + 8), u32(base + 16));
+        report(w, "WMI radio noise/PHY errors", u32(base), u32(base + 20));
+        break;
+    }
+    case 0x5003: /* WMI_VDEV_INSTALL_KEY_COMPLETE_EVENTID */
+        if (tag != TAG_KEY_DONE || len < 24 || !w->key_pending || w->key_done ||
+            u32(p + 4) || memcmp(p + 8, w->vdev_bssid, 6) ||
+            u32(p + 16) != w->key_index || (u32(p + 20) & 1) != w->key_group ||
+            (u32(p + 20) & ~0x31u) || u32(p + 24)) { bad(w); return; }
+        report(w, "WMI key confirm index/flags", u32(p + 16), u32(p + 20));
+        w->key_done = 1;
+        break;
+    case 0x6006: { /* WMI_PEER_ASSOC_CONF_EVENTID */
+        if (tag != TAG_ASSOC_CONF || len < 16 || u32(p + 4) || u32(p + 16)) { bad(w); return; }
+        PeachWmiPeer *s = peer_find(w, p + 8);
+        if (!s || !s->assoc_sent || s->assoc_confirmed || s->delete_sent) { bad(w); return; }
+        s->assoc_confirmed = 1;
+        break;
+    }
+    case 0x5001: /* WMI_VDEV_START_RESP_EVENTID */
+        if (tag == TAG_STARTED && len >= 36) {
+            report(w, "WMI vdev start status/pdev", u32(p + 16), u32(p + 28));
+            report(w, "WMI vdev start vdev/requestor", u32(p + 4), u32(p + 8));
+            report(w, "WMI vdev start response/expected requestor", u32(p + 12), w->vdev_request);
+            report(w, "WMI vdev start TX/RX streams", u32(p + 32), u32(p + 36));
+        }
+        if (tag != TAG_STARTED || len < 36 || !w->vdev_start_sent || w->vdev_started ||
+            u32(p + 4) || u32(p + 8) != w->vdev_request || u32(p + 12) || u32(p + 16) ||
+            u32(p + 28) != w->radio.pdev || u32(p + 32) != 1 || u32(p + 36) != 1) {
+            bad(w); return;
+        }
+        w->vdev_started = 1;
+        break;
+    case 0x5002: /* WMI_VDEV_STOPPED_EVENTID */
+        if (tag != TAG_STOPPED || len < 4 || u32(p + 4) || !w->vdev_stop_sent || w->vdev_stopped) {
+            bad(w); return;
+        }
+        w->vdev_stopped = 1; w->vdev_started = 0;
+        break;
+    case 0x7006: /* WMI_MGMT_TX_COMPLETION_EVENTID */
+        if (tag != TAG_MGMT_DONE || len < 12 || !w->mgmt_in_flight || w->mgmt_done ||
+            u32(p + 4) != w->mgmt_id || u32(p + 12) != w->radio.pdev || u32(p + 8) > 3) {
+            bad(w); return;
+        }
+        w->mgmt_status = u32(p + 8); w->mgmt_done = 1; w->mgmt_in_flight = 0;
+        break;
+    case 0x601a: /* WMI_PEER_CREATE_CONF_EVENTID */
+    case 0x6007: { /* WMI_PEER_DELETE_RESP_EVENTID */
+        if (tag != (id == 0x601a ? TAG_PEER_CONFIRM : TAG_PEER_DELETED) ||
+            len < 16 || u32(p + 4)) { bad(w); return; }
+        PeachWmiPeer *s = peer_find(w, p + 8);
+        if (!s || !s->create_sent || u32(p + 16)) { bad(w); return; }
+        if (id == 0x601a) {
+            if (s->create_confirmed) { bad(w); return; }
+            s->create_confirmed = 1;
+        } else {
+            if (!s->delete_sent || s->delete_response) { bad(w); return; }
+            s->delete_response = 1;
+        }
+        break;
+    }
+    case 0x3a001: (void)regulatory_event(w, p, n, 0); break;
+    case 0x3a003: (void)regulatory_event(w, p, n, 1); break;
+    case 0x3001: (void)scan_event(w, p); break;
+    case 0x7001: management_event(w, p, n); break;
+    case 1: (void)service_ready(w, p, n); break;
+    case 2: {
+        if (!w->phase || tag != TAG_READY || len < 36 || !abi_compatible(p + 4) || u32(p + 36)) {
+            report(w, "WMI READY rejected/tag", len >= 36 ? u32(p + 36) : 0xffffffffu, tag);
+            bad(w); return;
+        }
+        uint32_t lo = u32(p + 28), hi = u32(p + 32);
+        for (unsigned i = 0; i < 4; i++) w->mac[i] = lo >> (i * 8);
+        w->mac[4] = hi; w->mac[5] = hi >> 8;
+        if ((lo & 1) || (!lo && !hi) || w->ready) { bad(w); return; }
+        w->ready = 1;
+        report(w, "WMI READY real MAC", lo, hi & 0xffff);
+        break;
+    }
+    case 3: {
+        if (tag != TAG_AVAILABLE || len < 20) { bad(w); return; }
+        uint32_t offset = u32(p + 4);
+        if ((offset & 31) || offset > 896) { bad(w); return; }
+        for (unsigned i = 0; i < 128; i++)
+            if (u32(p + 8 + (i / 32) * 4) & (1u << (i & 31))) add_service(w, offset + i);
+        /* The following UINT32 TLV continues at segment_offset + 128.
+         * Native Peach advertises MGMT_SRNG (420) here, not in the fixed
+         * 128..255 bitmap. Ignoring this array silently loses that path. */
+        size_t next = len + 4;
+        unsigned base = offset + 128;
+        while (next < n) {
+            unsigned header = u32(p + next), bytes = header & 0xffff;
+            if (header >> 16 != TAG_U32 || (bytes & 3) ||
+                bytes > n - next - 4 || bytes / 4 > (1024 - base) / 32) {
+                bad(w); return;
+            }
+            for (unsigned i = 0; i < bytes / 4; i++) {
+                uint32_t bits = u32(p + next + 4 + i * 4);
+                for (unsigned bit = 0; bit < 32; bit++)
+                    if (bits & (1u << bit)) add_service(w, base + i * 32 + bit);
+            }
+            base += bytes * 8;
+            next += bytes + 4;
+        }
+        report(w, "WMI extended capabilities through/MGMT_SRNG", base, service(w, 420));
+        break;
+    }
+    case 5:
+        if (tag != TAG_FW_READY || w->mode_required || w->service_ready) { bad(w); return; }
+        w->mode_required = 1;
+        break;
+    case 6:
+        if (tag != TAG_MODE_RESPONSE || len < 4 || !w->mode_sent || u32(p + 4)) { bad(w); return; }
+        w->mode_accepted = 1;
+        break;
+    case 0x4009:
+        if (tag != TAG_EXT || w->ext_ready) { bad(w); return; }
+        if (radio_capabilities(w, p, n)) return;
+        w->ext_ready = 1;
+        report(w, "WMI SERVICE_READY_EXT", len, 0);
+        break;
+    case 0x4022:
+        if (tag != TAG_EXT2 || len < 32 || w->ext2_ready) { bad(w); return; }
+        w->peer_metadata_version = u32(p + 32) & 3;
+        w->ext2_ready = 1;
+        report(w, "WMI SERVICE_READY_EXT2", len, 0);
+        break;
+    default:
+        if (w->unknown_events++ < 8) report(w, "WMI pending event", id, (uint32_t)n);
+        break;
+    }
+}
+static int progress(PeachWmi *w)
+{
+    WTRY(w, peach_htc_poll(w->htc));
+    return w->error;
+}
+static int send_command(PeachWmi *w, unsigned id, size_t n)
+{
+    if (w->error) return w->error;
+    if (n < 4 || n > sizeof(w->command)) return PeachMhiInvalid;
+    p32(w->command, id);
+    uint64_t end = w->htc->ops.now_us(w->htc->ops.context) + 10000000;
+    int err;
+    while ((err = peach_htc_send(w->htc, 0x100, w->command, n)) == PeachCeFull) {
+        WTRY(w, progress(w));
+        if (w->htc->ops.now_us(w->htc->ops.context) >= end) return w->error = PeachMhiTimeout;
+        w->htc->ops.sleep_us(w->htc->ops.context, 1000);
+    }
+    return err;
+}
+static int wait_flag(PeachWmi *w, const unsigned *flag)
+{
+    if (w->error) return w->error;
+    uint64_t end = w->htc->ops.now_us(w->htc->ops.context) + 10000000;
+    while (!*flag) {
+        WTRY(w, progress(w));
+        if (w->mode_required && !w->mode_sent) {
+            memset(w->command, 0, 12); tlv(w->command + 4, TAG_MODE, 4);
+            w->mode_sent = 1;
+            WTRY(w, send_command(w, 2, 12));
+        }
+        if (w->htc->ops.now_us(w->htc->ops.context) >= end) return w->error = PeachMhiTimeout;
+        if (!*flag) w->htc->ops.sleep_us(w->htc->ops.context, 1000);
+    }
+    return 0;
+}
+static int allocate_memory(PeachWmi *w)
+{
+    for (unsigned i = 0; i < w->requests; i++) {
+        PeachWmiMemory *m = &w->memory[i];
+        unsigned units = m->units;
+        if (m->flags & 1) units = VDEVS;
+        if (m->flags & 6) units = PEERS + 1; /* vendor includes target self peer */
+        uint64_t unit = ((uint64_t)m->unit_size + 3) & ~3ull;
+        uint64_t bytes = unit * units;
+        if (!bytes || bytes > 0x2000000 || bytes > w->ops.iova_bytes) return bad(w);
+        WTRY(w, w->ops.allocate(w->ops.context, (size_t)bytes, &m->dma));
+        if (!m->dma.bytes || m->dma.capacity < bytes || m->dma.iova < w->ops.iova_base ||
+            m->dma.iova - w->ops.iova_base >= w->ops.iova_bytes ||
+            bytes > w->ops.iova_bytes - (m->dma.iova - w->ops.iova_base)) return bad(w);
+        report(w, "WMI host memory id/bytes", m->id, (uint32_t)bytes);
+    }
+    if (service(w, 420)) {
+        WTRY(w, w->ops.allocate(w->ops.context, MGMT_RX_STORAGE, &w->mgmt_rx_dma));
+        PeachMhiDma d = w->mgmt_rx_dma;
+        if (!d.bytes || d.capacity < MGMT_RX_STORAGE || (d.iova & 63) ||
+            d.iova < w->ops.iova_base || d.iova - w->ops.iova_base >= w->ops.iova_bytes ||
+            MGMT_RX_STORAGE > w->ops.iova_bytes - (d.iova - w->ops.iova_base)) return bad(w);
+        memset(d.bytes, 0, MGMT_RX_STORAGE);
+    }
+    w->ops.barrier(w->ops.context);
+    return 0;
+}
+static size_t build_init(PeachWmi *w)
+{
+    memset(w->command, 0, sizeof(w->command));
+    unsigned char *p = w->command + 4;
+    tlv(p, TAG_INIT, 28);
+    for (unsigned i = 0; i < 6; i++) p32(p + 4 + i * 4, host_abi[i]);
+    p32(p + 28, w->requests);
+    p += 32;
+    tlv(p, TAG_RESOURCES, RESOURCE_WORDS * 4 - 4);
+    /* Indices include the TLV header. Appended optional fields stay zero;
+     * no MLO, NAN, TDLS, IPA, monitor or accelerator features are enabled. */
+#define R(word, value) p32(p + 4 * (word), (value))
+    R(1, VDEVS); R(2, PEERS); R(3, VDEVS + 1); R(4, 1); R(5, 2);
+    R(6, 2 * (PEERS + VDEVS + 2)); R(7, 16);
+    R(8, w->radio.tx_chains); R(9, w->radio.rx_chains);
+    R(10, 100); R(11, 100); R(12, 100); R(13, 40);
+    R(14, 2); R(15, 1); R(16, 1); /* Ethernet decap, one scan, beacon miss */
+    R(29, 256); R(30, w->max_fragments > 10 ? 10 : w->max_fragments);
+    R(44, 1u << 30 | 1u << 10); /* IPA disabled; native 20-bit TX MSDU IDs */
+    R(54, 1); R(63, 1); R(81, 1); /* pdev IDs, single STA/active vdev */
+    /* Native EAPOL uses TCL TX_NOTIFY=3. Its firmware path must first be
+     * enabled by NOTIFY_FRAME_CONFIG_ENABLE (flags2 bit14), as in the
+     * captured native INIT (0x013040e0) and wmi_copy_resource_config.
+     * WBM FW completions are handled by PeachTx. */
+    /* The firmware's RX peer-metadata helpers are also used by its EAPOL
+     * TX path. V0 initializes no ML-bit getter; our RDDM records PC=0 at
+     * the indirect call through 0x015598b4. Native init_cmd_api.c selects
+     * V1A=2 when service365 is advertised; the phone's INIT has bits5:4=2.
+     * This changes the descriptor ABI, not our single-link association. */
+    R(68, w->peer_metadata_version << 4 | 1u << 14 |
+        (w->mgmt_rx_dma.bytes ? 1u << 21 : 0));
+    report(w, "WMI INIT flags1/flags2", u32(p + 44 * 4), u32(p + 68 * 4));
+    if (service(w, 143)) R(57, 0x22); /* allow V2 map/unmap; legacy still legal */
+#undef R
+    p += RESOURCE_WORDS * 4;
+    tlv(p, TAG_ARRAY, w->requests * 20); p += 4;
+    for (unsigned i = 0; i < w->requests; i++, p += 20) {
+        PeachWmiMemory *m = &w->memory[i];
+        tlv(p, TAG_CHUNK, 16); p32(p + 4, m->id); p32(p + 8, (uint32_t)m->dma.iova);
+        p32(p + 12, (uint32_t)m->dma.capacity); p32(p + 16, 0);
+    }
+    /* The selected mode is SINGLE. Vendor init_deinit_send_init_cmd
+     * deliberately omits the optional HW_MODE/band-to-MAC TLVs for SINGLE
+     * because firmware does not support that override in this mode. */
+    return (size_t)(p - w->command);
+}
+int peach_wmi_wait_services(PeachWmi *w)
+{
+    if (!w || !w->htc || !w->htc->started || w->phase) return PeachMhiInvalid;
+    if (w->error) return w->error;
+    WTRY(w, wait_flag(w, &w->service_ready));
+    if (w->mode_required) WTRY(w, wait_flag(w, &w->mode_accepted));
+    if (service(w, 77)) WTRY(w, wait_flag(w, &w->ext_ready));
+    if (service(w, 220)) WTRY(w, wait_flag(w, &w->ext2_ready));
+    if (!w->radio.valid) return bad(w);
+    return 0;
+}
+int peach_wmi_bootstrap(PeachWmi *w)
+{
+    int err = peach_wmi_wait_services(w);
+    if (err) return err;
+    unsigned advertised = w->peer_metadata_version;
+    if (service(w, 365)) w->peer_metadata_version = 2;
+    if (!w->peer_metadata_version || w->peer_metadata_version > 2) return PeachMhiInvalid;
+    report(w, "WMI RX peer metadata advertised/selected", advertised, w->peer_metadata_version);
+    WTRY(w, allocate_memory(w));
+    w->phase = 1;
+    WTRY(w, send_command(w, 1, build_init(w)));
+    WTRY(w, wait_flag(w, &w->ready));
+    /* ath12k_mac_start applies the advertised antenna masks after READY.
+     * INIT's resource limits alone are not the runtime PDEV configuration.
+     * This command has no ACK; only subsequent received frames prove RX. */
+    for (unsigned parameter = 1; parameter <= 2; parameter++) {
+        memset(w->command, 0, 20);
+        tlv(w->command + 4, 82, 12); /* wmi_pdev_set_param_cmd_fixed_param */
+        p32(w->command + 8, w->radio.pdev);
+        p32(w->command + 12, parameter); /* TX_CHAIN_MASK / RX_CHAIN_MASK */
+        p32(w->command + 16, parameter == 1 ? w->radio.tx_chains : w->radio.rx_chains);
+        WTRY(w, send_command(w, 0x4003, 20));
+    }
+    report(w, "WMI TX/RX antenna masks submitted", w->radio.tx_chains, w->radio.rx_chains);
+    w->phase = 2;
+    return 0;
+}
+/* qcacld wlan_mgmt_rx_srng: HOST4 is a SW-to-SW source ring. The
+ * hardware completion is the coherent remote tail, not the reap notification.
+ * Keep 127 buffers posted; recycle only after validated tail advancement. */
+int peach_wmi_start_management(PeachWmi *w, PeachHtt *h)
+{
+    if (!w || !w->ready || !h || w->mgmt_rx_started) return PeachMhiInvalid;
+    if (!w->mgmt_rx_dma.bytes) return 0;
+    PeachMhiDma d = w->mgmt_rx_dma;
+    unsigned char *p = d.bytes;
+    uint32_t *ring = d.bytes;
+    for (unsigned i = 0; i < MGMT_RX_ENTRIES - 1; i++) {
+        uint64_t address = d.iova + MGMT_RX_BUFFERS + i * MGMT_RX_BYTES;
+        ring[i * 2] = (uint32_t)address;
+        ring[i * 2 + 1] = (uint32_t)(address >> 32) | i << 12; /* RBM=0 */
+    }
+    PeachHttRing request = {
+        {p, d.iova, 1024}, {p + 1024, d.iova + 1024, 4},
+        {p + 1088, d.iova + 1088, 4}, 0, 15, PeachHttSwToSw, MGMT_RX_ENTRIES, 2
+    };
+    w->ops.barrier(w->ops.context);
+    WTRY(w, peach_htt_setup_ring(h, &request));
+    memset(w->command, 0, 20);
+    tlv(w->command + 4, 82, 12);
+    p32(w->command + 12, 0xf6); /* MGMT_SRNG_REAP_EVENT_THRESHOLD, SOC pdev=0 */
+    p32(w->command + 16, 1);
+    WTRY(w, send_command(w, 0x4003, 20));
+    w->mgmt_rx_write = MGMT_RX_ENTRIES - 1;
+    w->mgmt_rx_started = 1;
+    w->ops.barrier(w->ops.context);
+    *(volatile uint32_t *)(p + 1024) = w->mgmt_rx_write * 2;
+    w->ops.barrier(w->ops.context);
+    report(w, "WMI management refill posted entries/bytes", w->mgmt_rx_write, MGMT_RX_BYTES);
+    return 0;
+}
+int peach_wmi_poll_management(PeachWmi *w)
+{
+    if (!w) return PeachMhiInvalid;
+    if (w->error) return w->error;
+    if (!w->mgmt_rx_started) return 0;
+    unsigned char *p = w->mgmt_rx_dma.bytes;
+    uint32_t *ring = w->mgmt_rx_dma.bytes;
+    w->ops.barrier(w->ops.context);
+    uint32_t tail = *(volatile uint32_t *)(p + 1088);
+    if (tail >= MGMT_RX_ENTRIES * 2 || (tail & 1)) return bad(w);
+    unsigned target = tail / 2;
+    unsigned consumed = (target + MGMT_RX_ENTRIES - w->mgmt_rx_read) % MGMT_RX_ENTRIES;
+    unsigned owned = (w->mgmt_rx_write + MGMT_RX_ENTRIES - w->mgmt_rx_read) % MGMT_RX_ENTRIES;
+    if (consumed > owned) return bad(w);
+    for (unsigned i = 0; i < consumed; i++) {
+        unsigned slot = w->mgmt_rx_read, cookie = ring[slot * 2 + 1] >> 12;
+        uint32_t info = ring[slot * 2 + 1];
+        uint64_t address = ring[slot * 2] | (uint64_t)(info & 255) << 32;
+        if (cookie >= MGMT_RX_ENTRIES || ((info >> 8) & 15) ||
+            address != w->mgmt_rx_dma.iova + MGMT_RX_BUFFERS + cookie * MGMT_RX_BYTES)
+            return bad(w);
+        unsigned char *buffer = p + MGMT_RX_BUFFERS + cookie * MGMT_RX_BYTES;
+        w->ops.barrier(w->ops.context);
+        unsigned bytes = u16(buffer);
+        if (bytes >= 12 && bytes <= MGMT_RX_BYTES && !u16(buffer + 2)) {
+            if (w->mgmt_rx_received < 3)
+                report(w, "WMI management DMA event/bytes", u32(buffer + 4), bytes - 4);
+            w->mgmt_rx_received++;
+            peach_wmi_receive(w, buffer + 4, bytes - 4);
+            if (w->error) return w->error;
+        } else w->mgmt_rx_discarded++;
+        memset(buffer, 0, MGMT_RX_BYTES);
+        unsigned next = w->mgmt_rx_write;
+        ring[next * 2] = (uint32_t)address;
+        ring[next * 2 + 1] = (uint32_t)(address >> 32) | cookie << 12;
+        w->mgmt_rx_read = (slot + 1) % MGMT_RX_ENTRIES;
+        w->mgmt_rx_write = (next + 1) % MGMT_RX_ENTRIES;
+    }
+    if (consumed) {
+        w->ops.barrier(w->ops.context);
+        *(volatile uint32_t *)(p + 1024) = w->mgmt_rx_write * 2;
+        w->ops.barrier(w->ops.context);
+    }
+    return 0;
+}
+static int scan_channel(PeachWmi *w, unsigned frequency, unsigned band)
+{
+    const PeachWmiRegDomain *r = &w->regulatory[w->radio.phy];
+    unsigned start = band == 1 ? 0 : r->count_2g;
+    unsigned end = band == 1 ? r->count_2g : r->count_2g + r->count_5g;
+    unsigned found = 0, flags = 0, power = 127, antenna = 127;
+    if (!(w->radio.bands & band)) return 0;
+    /* MAC/PHY limits are channel centres, unlike the regulatory rules'
+     * band edges checked below. Keep 2GHz/5GHz fields separate; WMI band
+     * capability bits are not array indices (Armada's 1021 range fix). */
+    unsigned low = band == 1 ? w->radio.low_2g : w->radio.low_5g;
+    unsigned high = band == 1 ? w->radio.high_2g : w->radio.high_5g;
+    if (frequency < low || frequency > high) return 0;
+    for (unsigned i = start; i < end; i++) {
+        const PeachWmiRegRule *rule = &r->rules[i];
+        if (frequency - 10 < (rule->frequencies & 0xffff) || frequency + 10 > rule->frequencies >> 16)
+            continue;
+        if ((rule->bandwidth_power & 0xffff) < 20 || (rule->flags & 0xffff) & ~15u) return 0;
+        unsigned p = (rule->bandwidth_power >> 16) & 255, a = rule->bandwidth_power >> 24;
+        if (p > 127 || a > 127) return 0;
+        if (p < power) power = p;
+        if (a < antenna) antenna = a;
+        flags |= rule->flags & 15; found = 1;
+    }
+    if (!found || (band == 2 && (flags & 4))) return 0;
+    if (w->channel_count == PEACH_WMI_SCAN_CHANNELS) return bad(w);
+    w->channels[w->channel_count++] = (PeachWmiScanChannel){frequency, flags, power, antenna};
+    return 0;
+}
+static int configure_scan_channels(PeachWmi *w)
+{
+    const unsigned five_ghz[] = {36,40,44,48,52,56,60,64,100,104,108,112,116,
+        120,124,128,132,136,140,144,149,153,157,161,165,169,173,177};
+    w->channel_count = 0;
+    for (unsigned i = 1; i <= 14; i++) WTRY(w, scan_channel(w, i == 14 ? 2484 : 2407 + i * 5, 1));
+    for (unsigned i = 0; i < sizeof(five_ghz) / sizeof(five_ghz[0]); i++)
+        WTRY(w, scan_channel(w, 5000 + five_ghz[i] * 5, 2));
+    if (!w->channel_count) return bad(w);
+    report(w, "WMI passive scan channels/country", w->channel_count,
+        w->regulatory[w->radio.phy].alpha2);
+    memset(w->command, 0, sizeof(w->command));
+    unsigned char *p = w->command + 4;
+    tlv(p, TAG_CHANNELS, 12); p32(p + 4, w->channel_count);
+    /* pdev_id=0 is required by this command for non-DBDC (single mode). */
+    p += 16; tlv(p, TAG_ARRAY, w->channel_count * 28); p += 4;
+    for (unsigned i = 0; i < w->channel_count; i++, p += 28) {
+        const PeachWmiScanChannel *c = &w->channels[i];
+        tlv(p, TAG_CHANNEL, 24); p32(p + 4, c->frequency); p32(p + 8, c->frequency);
+        unsigned mode = c->frequency < 2500 ? ((c->flags & 4) ? 2 : 1) : 0;
+        p32(p + 16, mode | 1u << 7 | ((c->flags & 2) ? 1u << 10 : 0));
+        p32(p + 20, c->power << 8 | c->power << 16);
+        p32(p + 24, c->antenna | c->power << 8); /* 20MHz width enum=0 */
+    }
+    return send_command(w, 0x3003, (size_t)(p - w->command));
+}
+static int create_scan_vdev(PeachWmi *w)
+{
+    if (w->vdev_sent) return 0;
+    memset(w->command, 0, sizeof(w->command));
+    unsigned char *p = w->command + 4;
+    /* This phone's Android wire capture: 48B payload through cfp_enable,
+     * no newer global_vdev_id. SINGLE uses PDEV 0 for VDEV creation. */
+    tlv(p, TAG_VDEV, 48); p32(p + 8, 2); /* vdev 0, STA */
+    uint32_t lo = 0, hi = 0;
+    for (unsigned i = 0; i < 4; i++) lo |= (uint32_t)w->mac[i] << (i * 8);
+    hi = w->mac[4] | (uint32_t)w->mac[5] << 8;
+    p32(p + 16, lo); p32(p + 20, hi); p32(p + 24, 2);
+    p += 52; tlv(p, TAG_ARRAY, 32); p += 4;
+    for (unsigned band = 1; band <= 2; band++, p += 16) {
+        unsigned streams = !!(w->radio.bands & band);
+        /* Actual vendor builder uses TPC band IDs 0/1 for this field. */
+        tlv(p, TAG_STREAMS, 12); p32(p + 4, band - 1); p32(p + 8, streams); p32(p + 12, streams);
+    }
+    tlv(p, TAG_ARRAY, 0); p += 4; /* no MLO MAC; same ABI as native non-MLO vdev */
+    WTRY(w, send_command(w, 0x5001, (size_t)(p - w->command)));
+    w->vdev_sent = 1; /* submission only: this ABI has no VDEV_CREATE ACK */
+    /* Keep the firmware's exception path consistent with the Ethernet-II
+     * TCL bank and RX resource configuration, including pre-key EAPOL. */
+    const unsigned params[] = {0x30, 0x5b}; /* TX_ENCAP_TYPE / RX_DECAP_TYPE */
+    for (unsigned i = 0; i < sizeof(params) / sizeof(params[0]); i++) {
+        memset(w->command, 0, 20); tlv(w->command + 4, 95, 12);
+        p32(w->command + 12, params[i]); p32(w->command + 16, 2);
+        WTRY(w, send_command(w, 0x5008, 20));
+    }
+    report(w, "WMI vdev TX/RX Ethernet encapsulation submitted", 2, 2);
+    return 0;
+}
+int peach_wmi_passive_scan(PeachWmi *w)
+{
+    if (!w || w->phase != 2 || !w->ready || !w->radio.valid || w->radio.phy >= 3 ||
+        w->scan_active || w->vdev_stop_sent || (w->vdev_start_sent && !w->vdev_up_sent))
+        return PeachMhiInvalid;
+    if (w->error) return w->error;
+    PeachWmiRegDomain *r = &w->regulatory[w->radio.phy];
+    uint64_t end = w->htc->ops.now_us(w->htc->ops.context) + 10000000;
+    while (!r->valid) {
+        WTRY(w, progress(w));
+        if (r->status) return bad(w);
+        if (w->htc->ops.now_us(w->htc->ops.context) >= end) return w->error = PeachMhiTimeout;
+        if (!r->valid) w->htc->ops.sleep_us(w->htc->ops.context, 1000);
+    }
+    w->scan_done = w->scan_finished = 0;
+    w->scan_reg_generation = r->generation;
+    WTRY(w, configure_scan_channels(w));
+    WTRY(w, create_scan_vdev(w));
+    if (!r->valid || r->generation != w->scan_reg_generation) return bad(w);
+    memset(w->command, 0, sizeof(w->command));
+    memset(w->bss, 0, sizeof(w->bss)); w->bss_count = w->bss_dropped = 0;
+    unsigned char *p = w->command + 4;
+    tlv(p, TAG_SCAN, 168); /* 43-word current vendor fixed struct, including header */
+    unsigned sequence = (w->scan_id + 1) & 0xfff;
+    w->scan_id = 0xa000 | (sequence ? sequence : 1); w->scan_requestor = 0xa001;
+    p32(p + 4, w->scan_id); p32(p + 8, w->scan_requestor);
+    p32(p + 16, 1); p32(p + 20, 0x7b); /* low priority, channel/start/completion/failures */
+    /* 120 ms per channel: log88 shows the firmware cutting a 250 ms request to
+     * about 58 ms, which is shorter than a 100 ms beacon interval and left a
+     * passive 5 GHz channel deaf; 120 ms hears at least one full beacon and
+     * still finishes the 26-channel sweep in about 3 s. The previous 250 ms
+     * took 6.5 s, and Settings made the operator wait through a whole sweep
+     * before it could show a password field (log95: every tap stalled). */
+    p32(p + 24, 120); p32(p + 28, 120); /* active/passive dwell in ms */
+    p32(p + 48, 25); p32(p + 52, 15000);
+    p32(p + 60, 0x21 | (w->scan_id == 0xa001 ? 0x10 : 0));
+    /* PASSIVE + FILTER_PROBE_REQ; request channel counters on the first scan. */
+    p32(p + 68, w->channel_count);
+    p32(p + 72, 1); /* broadcast BSSID, as in ath12k_wmi_start_scan_init */
+    p += 172; tlv(p, TAG_U32, w->channel_count * 4); p += 4;
+    for (unsigned i = 0; i < w->channel_count; i++, p += 4) p32(p, w->channels[i].frequency);
+    tlv(p, 19, 0); p += 4; /* no SSID filter */
+    tlv(p, 19, 8); p += 4;
+    memset(p, 255, 6); p += 8; /* wmi_mac_addr broadcast; reserved bits zero */
+    const unsigned empty_tags[] = {17,18,17,19,19};
+    for (unsigned i = 0; i < sizeof(empty_tags) / sizeof(empty_tags[0]); i++, p += 4)
+        tlv(p, empty_tags[i], 0);
+    w->scan_active = 1; w->scan_sent = w->scan_started = w->scan_done = 0;
+    w->scan_reason = 0xff; w->scan_event = 0;
+    int err = send_command(w, 0x3001, (size_t)(p - w->command));
+    if (!err) w->scan_sent = 1;
+    end = w->htc->ops.now_us(w->htc->ops.context) + 20000000;
+    while (!err && !w->scan_finished) {
+        err = progress(w);
+        if (!err && (!r->valid || r->generation != w->scan_reg_generation)) err = bad(w);
+        if (!err && !w->scan_finished && w->htc->ops.now_us(w->htc->ops.context) >= end)
+            err = w->error = PeachMhiTimeout;
+        if (!err && !w->scan_finished) w->htc->ops.sleep_us(w->htc->ops.context, 1000);
+    }
+    w->scan_active = w->scan_sent = 0;
+    if (err || !w->scan_done) {
+        w->scan_done = 0; w->bss_count = 0;
+        return err ? err : PeachWmiScanFailed;
+    }
+    report(w, "WMI passive scan actual BSS/dropped", w->bss_count, w->bss_dropped);
+    return 0;
+}
+int peach_wmi_passive_scan_target(PeachWmi *w, const unsigned char *ssid, unsigned bytes,
+                                   const unsigned char *bssid)
+{
+    if (!w || !ssid || !bytes || bytes > 32 || w->scan_active || w->scan_target_bytes ||
+        (bssid && ((bssid[0] & 1) || !memcmp(bssid, "\0\0\0\0\0\0", 6))))
+        return PeachMhiInvalid;
+    memcpy(w->scan_target_ssid, ssid, bytes); w->scan_target_bytes = bytes;
+    w->scan_target_bssid_valid = bssid != NULL;
+    if (bssid) memcpy(w->scan_target_bssid, bssid, 6);
+    report(w, "WMI manual passive scan target bytes/BSSID filter", bytes, bssid != NULL);
+    int err = peach_wmi_passive_scan(w);
+    w->scan_target_bytes = w->scan_target_bssid_valid = 0;
+    return err;
+}
+int peach_wmi_request_radio_stats(PeachWmi *w)
+{
+    if (!w || !w->ready || w->scan_active) return PeachMhiInvalid;
+    memset(w->command, 0, 40);
+    tlv(w->command + 4, 143, 20); /* wmi_request_stats_cmd_fixed_param */
+    p32(w->command + 8, 4); /* WMI_REQUEST_PDEV_STAT */
+    p32(w->command + 24, w->radio.pdev);
+    tlv(w->command + 28, TAG_ARRAY, 0);
+    tlv(w->command + 32, TAG_U32, 0);
+    tlv(w->command + 36, 19, 0);
+    return send_command(w, 0x16001, 40);
+}
+int peach_wmi_peer_create(PeachWmi *w, const unsigned char mac[6], unsigned type)
+{
+    if (!w || !mac || !w->ready || !w->vdev_sent || w->scan_active || type > 1 ||
+        (mac[0] & 1) || !memcmp(mac, "\0\0\0\0\0\0", 6) || peer_find(w, mac) ||
+        (!type && memcmp(mac, w->mac, 6)) || (type && !memcmp(mac, w->mac, 6)))
+        return PeachMhiInvalid;
+    if (w->error) return w->error;
+    PeachWmiPeer *s = NULL;
+    for (unsigned i = 0; i < PEACH_WMI_PEERS; i++)
+        if (!w->peers[i].used) { s = &w->peers[i]; break; }
+    if (!s) return PeachCeFull;
+    /* Current fixed struct is 32B, followed by empty non-MLO array. */
+    memset(w->command, 0, 40); tlv(w->command + 4, TAG_PEER_CREATE, 28);
+    /* type is this host's self/remote ownership marker. Native STA AP
+     * peers use WMI_PEER_TYPE_DEFAULT=0, not that internal role value. */
+    peer_mac(w->command + 12, mac); p32(w->command + 20, 0);
+    tlv(w->command + 36, TAG_ARRAY, 0);
+    memset(s, 0, sizeof(*s)); s->used = 1; s->type = type; memcpy(s->mac, mac, 6);
+    WTRY(w, send_command(w, 0x6001, 40)); s->create_sent = 1;
+    if (service(w, 234)) WTRY(w, wait_flag(w, &s->create_confirmed));
+    return 0;
+}
+int peach_wmi_peer_delete(PeachWmi *w, const unsigned char mac[6])
+{
+    if (!w || !mac) return PeachMhiInvalid;
+    if (w->error) return w->error;
+    PeachWmiPeer *s = peer_find(w, mac);
+    if (!s || !s->create_sent || s->delete_sent) return PeachMhiInvalid;
+    /* Stop/flush TX and detach queues separately; this command does not
+     * release any retained DMA allocation or permit queue reuse. */
+    memset(w->command, 0, 24); tlv(w->command + 4, TAG_PEER_DELETE, 12);
+    peer_mac(w->command + 12, mac); tlv(w->command + 20, TAG_ARRAY, 0);
+    WTRY(w, send_command(w, 0x6002, 24)); s->delete_sent = 1;
+    if (service(w, 92)) WTRY(w, wait_flag(w, &s->delete_response));
+    return 0;
+}
+int peach_wmi_peer_queue(PeachWmi *w, const PeachHtt *h, const unsigned char mac[6],
+                         unsigned tid, PeachMhiDma queue)
+{
+    if (!w || !h || !mac || tid > 16 || !queue.bytes || !queue.iova ||
+        (queue.iova & 127) || ((uintptr_t)queue.bytes & 127) ||
+        queue.iova >= 0x100000000ull || queue.capacity < (tid == 16 ? 128u : 512u) ||
+        (tid == 16 ? 128u : 512u) > 0x100000000ull - queue.iova) return PeachMhiInvalid;
+    if (w->error || h->error) return w->error = w->error ? w->error : h->error;
+    PeachWmiPeer *s = peer_find(w, mac);
+    const PeachHttPeer *mapped = peach_htt_peer(h, 0, mac);
+    if (!s || !s->type || !s->create_sent || s->delete_sent ||
+        (service(w, 234) && !s->create_confirmed) ||
+        !mapped || (s->queues_sent & (1u << tid))) return PeachMhiInvalid;
+    uint32_t generation = mapped->generation;
+    memset(w->command, 0, 44); tlv(w->command + 4, TAG_PEER_QUEUE, 36);
+    peer_mac(w->command + 12, mac); p32(w->command + 20, tid);
+    p32(w->command + 24, (uint32_t)queue.iova);
+    p32(w->command + 28, (uint32_t)(queue.iova >> 32));
+    p32(w->command + 32, tid); p32(w->command + 36, 1); p32(w->command + 40, 1);
+    w->ops.barrier(w->ops.context);
+    WTRY(w, send_command(w, 0x6013, 44));
+    s->queues_sent |= 1u << tid; /* submitted, not acknowledged */
+    mapped = peach_htt_peer(h, 0, mac);
+    if (!mapped || mapped->generation != generation) return bad(w);
+    return 0;
+}
+int peach_wmi_vdev_start(PeachWmi *w, unsigned bss_index, unsigned pmf)
+{
+    if (!w || !w->ready || !w->vdev_sent || w->scan_active || !w->scan_done ||
+        w->vdev_start_sent || bss_index >= w->bss_count || pmf > 1 || !service(w, 76))
+        return PeachMhiInvalid;
+    if (w->error) return w->error;
+    const PeachWmiBss *b = &w->bss[bss_index];
+    const PeachWmiRegDomain *r = &w->regulatory[w->radio.phy];
+    if (!r->valid || r->generation != w->scan_reg_generation || !b->beacon_interval ||
+        !b->dtim_period || (b->capability & 3) != 1 || b->ies_truncated) return PeachMhiInvalid;
+    const PeachWmiScanChannel *c = NULL;
+    for (unsigned i = 0; i < w->channel_count; i++)
+        if (w->channels[i].frequency == b->frequency) { c = &w->channels[i]; break; }
+    if (!c) return PeachMhiInvalid;
+    if (!w->mgmt_dma.bytes) {
+        WTRY(w, w->ops.allocate(w->ops.context, PEACH_WMI_MGMT_BYTES, &w->mgmt_dma));
+        PeachMhiDma d = w->mgmt_dma;
+        if (!d.bytes || d.capacity < PEACH_WMI_MGMT_BYTES || !d.iova || (d.iova & 3) ||
+            ((uintptr_t)d.bytes & 3) || d.iova < w->ops.iova_base ||
+            d.iova - w->ops.iova_base > w->ops.iova_bytes ||
+            PEACH_WMI_MGMT_BYTES > w->ops.iova_bytes - (d.iova - w->ops.iova_base)) return bad(w);
+    }
+    /* Native 35-word fixed struct, channel, NOA/MLO/partner arrays.
+     * No HT/VHT/HE/EHT or MLO capability is advertised by this start. */
+    memset(w->command, 0, sizeof(w->command));
+    unsigned char *p = w->command + 4;
+    /* Peach's vendor start command leaves requestor_id zero. One start
+     * per boot is allowed; match that zero with the pending vdev below. */
+    tlv(p, TAG_START, 136); p32(p + 8, w->vdev_request);
+    p32(p + 12, b->beacon_interval); p32(p + 16, b->dtim_period);
+    p32(p + 20, pmf << 1); p32(p + 76, 1); p32(p + 80, 1);
+    p32(p + 132, 1); p32(p + 136, 1);
+    p += 140; tlv(p, TAG_CHANNEL, 24); p32(p + 4, c->frequency); p32(p + 8, c->frequency);
+    unsigned mode = c->frequency < 2500 ? ((c->flags & 4) ? 2 : 1) : 0;
+    p32(p + 16, mode | ((c->flags & 2) ? 1u << 10 : 0));
+    p32(p + 20, c->power << 8 | c->power << 16);
+    p32(p + 24, c->antenna | c->power << 8); p += 28;
+    for (unsigned i = 0; i < 3; i++, p += 4) tlv(p, TAG_ARRAY, 0);
+    w->vdev_frequency = b->frequency; w->vdev_reg_generation = r->generation;
+    memcpy(w->vdev_bssid, b->bssid, 6); w->mgmt_head = w->mgmt_count = 0;
+    WTRY(w, send_command(w, 0x5003, (size_t)(p - w->command))); w->vdev_start_sent = 1;
+    WTRY(w, wait_flag(w, &w->vdev_started));
+    if (!r->valid || r->generation != w->vdev_reg_generation) return bad(w);
+    return 0;
+}
+int peach_wmi_vdev_stop(PeachWmi *w)
+{
+    if (!w || !w->vdev_started || w->vdev_stop_sent || w->mgmt_in_flight) return PeachMhiInvalid;
+    if (w->error) return w->error;
+    memset(w->command, 0, 12); tlv(w->command + 4, TAG_STOP, 4);
+    WTRY(w, send_command(w, 0x5006, 12)); w->vdev_stop_sent = 1;
+    return wait_flag(w, &w->vdev_stopped);
+}
+int peach_wmi_wmm(PeachWmi *w, const unsigned char *ies, size_t bytes)
+{
+    if (!w || !w->vdev_started || w->vdev_stop_sent || (!ies && bytes)) return PeachMhiInvalid;
+    if (w->error) return w->error;
+    const unsigned char *params = NULL;
+    while (bytes) {
+        if (bytes < 2 || ies[1] > bytes - 2) return PeachMhiInvalid;
+        if (ies[0] == 221 && ies[1] == 24 &&
+            !memcmp(ies + 2, "\x00\x50\xf2\x02\x01\x01", 6)) {
+            if (params) return PeachMhiInvalid;
+            params = ies + 10;
+        }
+        size_t n = ies[1] + 2u; ies += n; bytes -= n;
+    }
+    static const unsigned defaults[4][4] = {
+        {15,1023,3,0}, {15,1023,7,0}, {7,15,2,94}, {3,7,2,47}
+    };
+    memset(w->command, 0, 128); unsigned char *p = w->command + 4;
+    tlv(p, 199, 120); /* VDEV_SET_WMM_PARAMS fixed 124B, EDCA type 0 */
+    for (unsigned ac = 0; ac < 4; ac++) {
+        unsigned char *q = p + 8 + ac * 28; tlv(q, 199, 24);
+        for (unsigned field = 0; field < 4; field++) p32(q + 4 + field * 4, defaults[ac][field]);
+    }
+    unsigned seen = 0;
+    if (params) for (unsigned i = 0; i < 4; i++) {
+        const unsigned char *q = params + i * 4;
+        unsigned ac = (q[0] >> 5) & 3, min = q[1] & 15, max = q[1] >> 4;
+        if ((seen & (1u << ac)) || !(q[0] & 15) || min > max) return PeachMhiInvalid;
+        seen |= 1u << ac;
+        unsigned char *d = p + 8 + ac * 28;
+        p32(d + 4, (1u << min) - 1); p32(d + 8, (1u << max) - 1);
+        p32(d + 12, q[0] & 15); p32(d + 16, u16(q + 2)); p32(d + 20, (q[0] >> 4) & 1);
+    }
+    WTRY(w, send_command(w, 0x500d, 128));
+    report(w, "WMI EDCA queues/AP parameters submitted", 4, !!params);
+    return 0;
+}
+int peach_wmi_mgmt_tx(PeachWmi *w, const void *packet, size_t bytes)
+{
+    const unsigned char *frame = packet;
+    if (!w || !frame || !w->vdev_started || w->vdev_stop_sent || w->mgmt_in_flight ||
+        !w->mgmt_dma.bytes || bytes < 24 || bytes > PEACH_WMI_MGMT_BYTES ||
+        w->mgmt_id == 0xffffffffu || (u16(frame) & 0x430f) ||
+        memcmp(frame + 4, w->vdev_bssid, 6) || memcmp(frame + 10, w->mac, 6) ||
+        memcmp(frame + 16, w->vdev_bssid, 6)) return PeachMhiInvalid;
+    if (w->error) return w->error;
+    const PeachWmiRegDomain *r = &w->regulatory[w->radio.phy];
+    if (!r->valid || r->generation != w->vdev_reg_generation) return bad(w);
+    memcpy(w->mgmt_dma.bytes, frame, bytes); w->ops.barrier(w->ops.context);
+    memset(w->command, 0, sizeof(w->command));
+    unsigned char *p = w->command + 4;
+    size_t prefix = bytes < 64 ? bytes : 64, padded = (prefix + 3) & ~(size_t)3;
+    tlv(p, TAG_MGMT_TX, 40); p32(p + 8, ++w->mgmt_id);
+    p32(p + 12, w->vdev_frequency); p32(p + 16, (uint32_t)w->mgmt_dma.iova);
+    p32(p + 20, (uint32_t)(w->mgmt_dma.iova >> 32));
+    p32(p + 24, (uint32_t)bytes); p32(p + 28, (uint32_t)prefix);
+    p += 44; tlv(p, 17, (unsigned)padded); p += 4;
+    memcpy(p, frame, prefix); p += padded;
+    /* tx_params_valid=0 still requires this fixed TLV. */
+    tlv(p, TAG_TX_PARAMS, 8); p += 12;
+    /* Native non-MLO management TX ends at tx_send_params. */
+    w->mgmt_done = 0; w->mgmt_status = 0xffffffffu;
+    WTRY(w, send_command(w, 0x7008, (size_t)(p - w->command))); w->mgmt_in_flight = 1;
+    WTRY(w, wait_flag(w, &w->mgmt_done));
+    return w->mgmt_status ? PeachMhiDeviceError : 0;
+}
+int peach_wmi_mgmt_rx(PeachWmi *w, PeachWmiMgmt *out)
+{
+    if (!w || !out) return PeachMhiInvalid;
+    if (w->error) return w->error;
+    if (!w->mgmt_count) return PeachWmiNoFrame;
+    *out = w->mgmt[w->mgmt_head];
+    w->mgmt_head = (w->mgmt_head + 1) % PEACH_WMI_MGMT_FRAMES; w->mgmt_count--;
+    return 0;
+}
+int peach_wmi_peer_assoc(PeachWmi *w, const PeachHtt *h, const PeachWmiAssociation *a)
+{
+    if (!w || !h || !a || !w->vdev_started || w->vdev_stop_sent || w->vdev_up_sent ||
+        a->aid < 1 || a->aid > 2007 || a->capabilities > 65535 || a->protected_network > 1 || a->qos > 1 ||
+        !a->rate_count || a->rate_count > sizeof(a->rates) ||
+        !!(a->capabilities & 16) != a->protected_network) return PeachMhiInvalid;
+    if (w->error || h->error) return w->error = w->error ? w->error : h->error;
+    PeachWmiPeer *s = peer_find(w, w->vdev_bssid);
+    const PeachHttPeer *mapped = peach_htt_peer(h, 0, w->vdev_bssid);
+    if (!s || !s->type || !s->create_sent || s->delete_sent || s->assoc_sent || !mapped ||
+        (service(w, 234) && !s->create_confirmed)) return PeachMhiInvalid;
+    uint32_t generation = mapped->generation;
+    static const unsigned char legacy[] = {2,4,11,22,12,18,24,36,48,72,96,108};
+    for (unsigned i = 0; i < a->rate_count; i++) {
+        unsigned rate = a->rates[i] & 127, found = 0;
+        for (unsigned j = w->vdev_frequency < 2500 ? 0 : 4; j < sizeof(legacy); j++)
+            if (rate == legacy[j]) found = 1;
+        for (unsigned j = 0; j < i; j++) if (rate == (a->rates[j] & 127)) return PeachMhiInvalid;
+        if (!found) return PeachMhiInvalid;
+    }
+    /* Legacy PHY, with WMM only if accepted by the AP; no aggregation. */
+    memset(w->command, 0, sizeof(w->command));
+    unsigned char *p = w->command + 4;
+    /* Native Peach module send_peer_assoc_cmd_tlv: 280-byte fixed struct,
+     * not the later UHR/V2 ABI. Follow its five optional arrays below. */
+    tlv(p, TAG_ASSOC, 276); peer_mac(p + 4, s->mac);
+    p32(p + 16, 1); p32(p + 20, a->aid);
+    /* Native protected association requests PTK/GTK handshakes. PRIV
+     * would enable encryption before a pairwise key exists for M2. */
+    p32(p + 24, (a->protected_network ? 0x14 : 1) | (a->qos ? 2u : 0));
+    p32(p + 28, a->capabilities); p32(p + 32, 10); p32(p + 52, 1);
+    unsigned mode = w->vdev_frequency < 2500 ? 1 : 0;
+    for (unsigned i = 0; i < w->channel_count; i++)
+        if (w->channels[i].frequency == w->vdev_frequency && (w->channels[i].flags & 4)) mode = 2;
+    p32(p + 60, mode); p32(p + 72, a->rate_count);
+    p32(p + 172, a->protected_network ? 11 : 1); /* RSNA_PSK / OPEN */
+    p32(p + 252, 1); /* peer_max_tx_nss */
+    p += 280; unsigned padded = (a->rate_count + 3) & ~3u;
+    tlv(p, 17, padded); memcpy(p + 4, a->rates, a->rate_count); p += 4 + padded;
+    tlv(p, 17, 0); p += 4; tlv(p, TAG_VHT_RATES, 20); p += 24;
+    for (unsigned i = 0; i < 5; i++, p += 4) tlv(p, TAG_ARRAY, 0);
+    report(w, "WMI native peer assoc bytes/rates", (uint32_t)(p - w->command), a->rate_count);
+    report(w, "WMI peer negotiated QoS/flags", a->qos, u32(w->command + 28));
+    WTRY(w, send_command(w, 0x6005, (size_t)(p - w->command))); s->assoc_sent = 1;
+    s->assoc_id = a->aid; s->protected_network = a->protected_network;
+    if (service(w, 79)) WTRY(w, wait_flag(w, &s->assoc_confirmed));
+    mapped = peach_htt_peer(h, 0, s->mac);
+    if (!mapped || mapped->generation != generation) return bad(w);
+    return 0;
+}
+int peach_wmi_vdev_up(PeachWmi *w)
+{
+    if (!w || !w->vdev_started || w->vdev_stop_sent || w->vdev_up_sent) return PeachMhiInvalid;
+    if (w->error) return w->error;
+    PeachWmiPeer *s = peer_find(w, w->vdev_bssid);
+    if (!s || !s->assoc_sent || s->delete_sent ||
+        (service(w, 79) && !s->assoc_confirmed)) return PeachMhiInvalid;
+    memset(w->command, 0, 44); tlv(w->command + 4, TAG_UP, 36);
+    p32(w->command + 12, s->assoc_id); peer_mac(w->command + 16, s->mac);
+    WTRY(w, send_command(w, 0x5005, 44)); w->vdev_up_sent = 1;
+    return 0;
+}
+int peach_wmi_install_ccmp(PeachWmi *w, const PeachHtt *h, unsigned group, unsigned index,
+                           const unsigned char key[16], uint64_t rsc)
+{
+    if (!w || !h || !key || group > 1 || index > 3 || (!group && index) ||
+        rsc >= 0x1000000000000ull || !w->vdev_up_sent || w->vdev_stop_sent || w->key_pending)
+        return PeachMhiInvalid;
+    if (w->error || h->error) return w->error = w->error ? w->error : h->error;
+    PeachWmiPeer *s = peer_find(w, w->vdev_bssid);
+    const PeachHttPeer *p = peach_htt_peer(h, 0, w->vdev_bssid);
+    if (!s || !s->protected_network || !s->assoc_sent || s->delete_sent || !p)
+        return PeachMhiInvalid;
+    PeachWmiKey *slot = &w->keys[group ? index + 1 : 0];
+    /* A retransmitted M3/group message must not reinstall an existing key
+     * or lower PN. The handshake owner still checks replay/MIC itself. */
+    if (slot->installed && !memcmp(slot->bytes, key, 16)) return 0;
+    if (slot->generation == 0xffffffffu) return bad(w);
+    uint32_t generation = p->generation;
+    memset(w->command, 0, 128);
+    unsigned char *out = w->command + 4;
+    tlv(out, TAG_KEY, 100); peer_mac(out + 8, s->mac);
+    p32(out + 16, index); p32(out + 20, group); p32(out + 24, 4);
+    p32(out + 28, (uint32_t)rsc); p32(out + 32, (uint32_t)(rsc >> 32));
+    p32(out + 84, 16); tlv(out + 104, 17, 16); memcpy(out + 108, key, 16);
+    w->key_pending = 1; w->key_done = 0; w->key_group = group; w->key_index = index;
+    int err = send_command(w, 0x5009, 128);
+    /* HTC/CE already copied the command into their retained TX storage. */
+    memset(w->command, 0, 128);
+    if (err) return w->error = err; /* pending/old/new DMA state is unknown */
+    WTRY(w, wait_flag(w, &w->key_done));
+    p = peach_htt_peer(h, 0, s->mac);
+    if (!p || p->generation != generation) return bad(w);
+    memcpy(slot->bytes, key, 16); slot->rsc = rsc;
+    slot->generation++; slot->installed = 1; w->key_pending = 0;
+    return 0;
+}
+int peach_wmi_authorize(PeachWmi *w, const PeachHtt *h)
+{
+    if (!w || !h || !w->vdev_up_sent || w->vdev_stop_sent || w->key_pending)
+        return PeachMhiInvalid;
+    if (w->error || h->error) return w->error = w->error ? w->error : h->error;
+    PeachWmiPeer *s = peer_find(w, w->vdev_bssid);
+    const PeachHttPeer *p = peach_htt_peer(h, 0, w->vdev_bssid);
+    if (!s || !p || !s->assoc_sent || s->delete_sent) return PeachMhiInvalid;
+    unsigned group_installed = 0;
+    for (unsigned i = 1; i < 5; i++)
+        group_installed |= w->keys[i].installed && w->keys[i].generation;
+    if (s->protected_network && (!w->keys[0].installed || !w->keys[0].generation ||
+        !group_installed)) return PeachMhiInvalid;
+    /* wmi_peer_set_param_cmd_fixed_param: vdev, MAC, param, value. There is
+     * no completion for this command; success means queued, not data proof. */
+    memset(w->command, 0, 28); tlv(w->command + 4, 100, 20);
+    peer_mac(w->command + 12, s->mac); p32(w->command + 20, 3);
+    /* WMI_PEER_AUTHORIZE_TYPE distinguishes secured and open ports. */
+    p32(w->command + 24, s->protected_network ? 1 : 2);
+    return send_command(w, 0x6004, 28);
+}
+/* Teardown of one association. keyed=0 is the original unkeyed retirement used
+ * when association failed before the four-way handshake; keyed=1 is the same
+ * sequence for a live, keyed link: peer delete makes the firmware drop the
+ * pairwise and group keys with the peer, so the host side only has to forget
+ * them instead of refusing the teardown. Both leave the firmware MISSION state
+ * untouched (no endpoint reset, no recovery budget spent), which is what a
+ * network switch needs. */
+static int retire_common(PeachWmi *w, PeachHtt *h, uint32_t generation, int keyed)
+{
+    if (!w || !h || !w->ready || !generation || w->scan_active ||
+        w->mgmt_in_flight || w->key_pending || !service(w, 92)) return PeachMhiInvalid;
+    if (w->error || h->error) return w->error ? w->error : h->error;
+    if (!keyed)
+        for (unsigned i = 0; i < 5; i++)
+            if (w->keys[i].installed) return PeachMhiInvalid;
+    PeachWmiPeer *s = peer_find(w, w->vdev_bssid);
+    const PeachHttPeer *p = peach_htt_peer(h, 0, w->vdev_bssid);
+    if (!s || !s->type || !s->create_sent || s->delete_sent ||
+        (p && p->generation != generation)) return PeachMhiInvalid;
+    if (w->vdev_started) WTRY(w, peach_wmi_vdev_stop(w));
+    else if (w->vdev_start_sent && !w->vdev_stopped) return PeachMhiInvalid;
+    WTRY(w, peach_wmi_peer_delete(w, s->mac));
+    uint64_t end = w->htc->ops.now_us(w->htc->ops.context) + 10000000;
+    while ((p = peach_htt_peer(h, 0, s->mac))) {
+        if (p->generation != generation) return bad(w);
+        WTRY(w, progress(w));
+        if (w->htc->ops.now_us(w->htc->ops.context) >= end)
+            return w->error = PeachMhiTimeout;
+        w->htc->ops.sleep_us(w->htc->ops.context, 1000);
+    }
+    if (h->error) return h->error;
+    if (w->vdev_up_sent) {
+        memset(w->command, 0, 12); tlv(w->command + 4, 94, 4);
+        WTRY(w, send_command(w, 0x5007, 12)); /* VDEV_DOWN, vdev0 */
+    }
+    memset(s, 0, sizeof(*s));
+    w->vdev_start_sent = w->vdev_started = w->vdev_stop_sent = w->vdev_stopped = w->vdev_up_sent = 0;
+    w->vdev_frequency = w->vdev_reg_generation = 0;
+    w->mgmt_head = w->mgmt_count = w->mgmt_done = 0;
+    memset(w->vdev_bssid, 0, sizeof(w->vdev_bssid));
+    if (keyed) {
+        /* The peer that owned these keys is gone, so the host copy is dead
+         * weight; keeping it would make the next association look keyed. */
+        for (unsigned i = 0; i < 5; i++) {
+            memset(w->keys[i].bytes, 0, sizeof(w->keys[i].bytes));
+            w->keys[i].installed = 0;
+            w->keys[i].generation = 0;
+        }
+        w->key_pending = 0;
+    }
+    return 0;
+}
+int peach_wmi_retire_unkeyed(PeachWmi *w, PeachHtt *h, uint32_t generation)
+{
+    return retire_common(w, h, generation, 0);
+}
+int peach_wmi_retire_keyed(PeachWmi *w, PeachHtt *h, uint32_t generation)
+{
+    return retire_common(w, h, generation, 1);
+}
diff --git a/bsd/dev/qcom/PeachWmi.h b/bsd/dev/qcom/PeachWmi.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/qcom/PeachWmi.h
@@ -0,0 +1,169 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PEACH_WMI_H
+#define PEACH_WMI_H
+#include "PeachHtc.h"
+#include "PeachHtt.h"
+#define PEACH_WMI_MEMORY_REQUESTS 16u
+#define PEACH_WMI_REG_RULES 64u
+#define PEACH_WMI_SCAN_CHANNELS 64u
+#define PEACH_WMI_BSS_ENTRIES 32u
+#define PEACH_WMI_PEERS 8u
+#define PEACH_WMI_MGMT_BYTES 1024u
+#define PEACH_WMI_MGMT_FRAMES 4u
+enum { PeachWmiNoFrame = 1, PeachWmiScanFailed = -22 };
+typedef struct {
+    void *context;
+    int (*allocate)(void *, size_t, PeachMhiDma *);
+    void (*barrier)(void *);
+    void (*log)(void *, const char *, uint32_t, uint32_t);
+    uint64_t iova_base, iova_bytes;
+} PeachWmiOps;
+typedef struct {
+    uint32_t id, unit_size, flags, units;
+    PeachMhiDma dma;
+} PeachWmiMemory;
+typedef struct {
+    unsigned valid, mode, pdev, phy, lmac, bands;
+    uint32_t tx_chains, rx_chains, low_2g, high_2g, low_5g, high_5g;
+} PeachWmiRadio;
+typedef struct { uint32_t frequencies, bandwidth_power, flags; } PeachWmiRegRule;
+typedef struct {
+    unsigned valid, status, generation, count_2g, count_5g;
+    uint32_t alpha2, country, domain, dfs;
+    PeachWmiRegRule rules[PEACH_WMI_REG_RULES];
+} PeachWmiRegDomain;
+typedef struct { unsigned frequency, flags, power, antenna; } PeachWmiScanChannel;
+typedef struct {
+    unsigned frequency, ssid_bytes, ie_bytes, ies_truncated, dtim_period;
+    uint64_t seen_us;
+    int rssi;
+    unsigned char bssid[6], ssid[32], ies[1024]; /* Apple80211 scan IE capacity */
+    uint16_t capability, beacon_interval;
+} PeachWmiBss;
+
+typedef struct {
+    unsigned used, type, create_sent, create_confirmed, delete_sent, delete_response;
+    unsigned assoc_sent, assoc_confirmed, assoc_id, protected_network;
+    uint32_t queues_sent;
+    unsigned char mac[6];
+} PeachWmiPeer;
+
+typedef struct {
+    unsigned bytes, frequency;
+    int rssi;
+    unsigned char frame[PEACH_WMI_MGMT_BYTES];
+} PeachWmiMgmt;
+
+typedef struct {
+    unsigned aid, capabilities, protected_network, rate_count, qos;
+    unsigned char rates[12]; /* 500kbps, including the basic-rate bit */
+} PeachWmiAssociation;
+
+typedef struct {
+    unsigned installed;
+    uint32_t generation;
+    uint64_t rsc;
+    unsigned char bytes[16];
+} PeachWmiKey;
+typedef struct {
+    PeachHtc *htc;
+    PeachWmiOps ops;
+    unsigned phase, service_ready, ext_ready, ext2_ready, ready;
+    unsigned mode_required, mode_sent, mode_accepted, unknown_events, peer_metadata_version;
+    uint32_t firmware_abi[6], services[32], requests, chains, max_fragments;
+    uint32_t last_event, last_tag;
+    unsigned char mac[6];
+    PeachWmiRadio radio;
+    PeachWmiRegDomain regulatory[3];
+    unsigned vdev_sent, scan_active, scan_sent, scan_started, scan_done, scan_finished;
+    unsigned scan_id, scan_requestor, scan_reason, scan_event, channel_count, bss_count;
+    unsigned bss_dropped;
+    unsigned scan_reg_generation;
+    PeachWmiScanChannel channels[PEACH_WMI_SCAN_CHANNELS];
+    PeachWmiBss bss[PEACH_WMI_BSS_ENTRIES];
+    PeachWmiPeer peers[PEACH_WMI_PEERS];
+    unsigned vdev_start_sent, vdev_started, vdev_request, vdev_frequency, vdev_reg_generation;
+    unsigned vdev_stop_sent, vdev_stopped, vdev_up_sent;
+    unsigned char vdev_bssid[6];
+    PeachMhiDma mgmt_rx_dma;
+    unsigned mgmt_rx_started, mgmt_rx_read, mgmt_rx_write;
+    uint64_t mgmt_rx_received, mgmt_rx_discarded;
+    PeachMhiDma mgmt_dma;
+    unsigned mgmt_in_flight, mgmt_done, mgmt_id, mgmt_status;
+    unsigned mgmt_head, mgmt_count, mgmt_dropped;
+    PeachWmiMgmt mgmt[PEACH_WMI_MGMT_FRAMES];
+    PeachWmiKey keys[5]; /* pairwise slot0, GTK indices 0..3 in slots1..4 */
+    unsigned key_pending, key_done, key_index, key_group;
+    int error;
+    PeachWmiMemory memory[PEACH_WMI_MEMORY_REQUESTS];
+    unsigned char command[2048];
+    unsigned scan_target_bytes, scan_target_bssid_valid;
+    unsigned char scan_target_ssid[32], scan_target_bssid[6];
+} PeachWmi;
+int peach_wmi_init(PeachWmi *, PeachHtc *, const PeachWmiOps *);
+/* HTC service callback: validates/copies capabilities, never allocates/waits. */
+void peach_wmi_receive(PeachWmi *, const void *, size_t);
+/* Actual SERVICE_READY -> host memory/INIT -> successful READY. Not scan,
+ * association, data transport or an iOS network-interface implementation. */
+/* Capabilities must be known before preparing host REO rings for INIT. */
+int peach_wmi_wait_services(PeachWmi *);
+int peach_wmi_bootstrap(PeachWmi *);
+/* Native Peach management RX: retained coherent HOST4 ring, polled remote
+ * tail; each buffer contains its 4B length prefix and an ordinary WMI event. */
+int peach_wmi_start_management(PeachWmi *, PeachHtt *);
+int peach_wmi_poll_management(PeachWmi *);
+/* Optional bring-up diagnostic; the real asynchronous reply is logged. */
+int peach_wmi_request_radio_stats(PeachWmi *);
+/* One STA vdev, firmware-supplied regulatory rules, passive 2.4/5GHz scan.
+ * Completion requires real scan events; BSS entries come only from received
+ * beacon/probe-response bytes. PeachWmiScanFailed means a real terminal
+ * failure event; a new scan is allowed. Timeout or transport failure still
+ * requires containment because the firmware may retain the old request. */
+int peach_wmi_passive_scan(PeachWmi *);
+/* One manual selection only; filters received BSS records on the host.
+ * It sends no directed probe and clears the filter before returning. */
+int peach_wmi_passive_scan_target(PeachWmi *, const unsigned char *ssid, unsigned bytes,
+                                   const unsigned char *bssid);
+/* vdev0 only; type 0=self, 1=BSS. Optional firmware confirmation is waited
+ * for only when advertised. The caller must ALSO wait for a real HTT map.
+ * Delete retains the peer slot/queue memory; no drain or cache flush implied. */
+int peach_wmi_peer_create(PeachWmi *, const unsigned char mac[6], unsigned type);
+int peach_wmi_peer_delete(PeachWmi *, const unsigned char mac[6]);
+/* Initial non-BA queues only, after a live HTT map. Success means command
+ * submission: this ABI has no queue-setup ACK. Protected RX needs PN setup. */
+int peach_wmi_peer_queue(PeachWmi *, const PeachHtt *, const unsigned char mac[6],
+                         unsigned tid, PeachMhiDma);
+/* Start on a scanned, regulatory-valid 20MHz BSS; wait for matching
+ * successful START_RESP. No authentication/association or network link. */
+int peach_wmi_vdev_start(PeachWmi *, unsigned bss_index, unsigned pmf);
+int peach_wmi_vdev_stop(PeachWmi *);
+/* No installed keys or outstanding management TX. Requires an observed
+ * peer generation, real STOP/DELETE responses and HTT unmap before reset.
+ * Queue descriptors and packet DMA remain allocated by their owners. */
+int peach_wmi_retire_unkeyed(PeachWmi *, PeachHtt *, uint32_t peer_generation);
+/* Same teardown for a live keyed link: peer delete drops the firmware keys. */
+int peach_wmi_retire_keyed(PeachWmi *, PeachHtt *, uint32_t peer_generation);
+/* Program four EDCA queues from the AP's WMM parameters, or defaults
+ * for a legacy AP. No U-APSD or MU-EDCA is enabled. */
+int peach_wmi_wmm(PeachWmi *, const unsigned char *ies, size_t bytes);
+/* One retained pass-by-reference buffer. Reuse only after matching real
+ * MGMT_TX_COMPLETION. RX frames are copied out of CE before callback return.
+ * These primitives do not manufacture auth/association responses. */
+int peach_wmi_mgmt_tx(PeachWmi *, const void *, size_t);
+int peach_wmi_mgmt_rx(PeachWmi *, PeachWmiMgmt *);
+/* Caller has already validated the AP's successful on-air association
+ * response. WMI ASSOC_CONF only acknowledges the firmware configuration.
+ * Legacy 20MHz, one stream, optional WMM; protected peers remain unauthorized. */
+int peach_wmi_peer_assoc(PeachWmi *, const PeachHtt *, const PeachWmiAssociation *);
+/* No ACK in this ABI: success records vdev_up_sent, not a connected NIC. */
+int peach_wmi_vdev_up(PeachWmi *);
+/* Caller has authenticated the EAPOL key material. AES-CCMP128 only,
+ * serialized matching INSTALL_KEY_COMPLETE required. Repeated same key is
+ * not reinstalled and does not reset its replay counter. ACK/SEC_IND alone
+ * do not authorize the port; RX PN setup and the 4-way exchange remain. */
+int peach_wmi_install_ccmp(PeachWmi *, const PeachHtt *, unsigned group, unsigned index,
+                           const unsigned char key[16], uint64_t rsc);
+/* Submit firmware peer authorization only after real association and, for
+ * protected peers, successful key ACKs plus matching HTT security state. */
+int peach_wmi_authorize(PeachWmi *, const PeachHtt *);
+#endif
diff --git a/iokit/Kernel/arm/PeachWLAN.cpp b/iokit/Kernel/arm/PeachWLAN.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/PeachWLAN.cpp
@@ -0,0 +1,246 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* IO80211.framework's ioctl fallback and SystemConfiguration discovery,
+ * following HackiOS RedwoodWLAN's registry contract. The data interface
+ * and Apple80211 operations are owned by PeachNet, not this registry node. */
+#include <pexpert/arm64/board_config.h>
+#include <sys/errno.h>
+#if defined(PANDORA)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <kern/thread.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSKext.h>
+#include <pexpert/pexpert.h>
+#include <sys/proc.h>
+
+/* These three classes are ours, named as IO80211Family and IONetworkingFamily name
+ * theirs: neither has anything but properties, because wifid and configd find the
+ * interface through the registry class name and properties, not through a C++
+ * interface. Inheriting the real IONetworkController would drag in
+ * IONetworkingFamily.kext, which is a user-space kext this kernel does not contain;
+ * the previous omission of the IONetworkController metaclass below was exactly what
+ * kept this file out of the kernel link (link87: "no IO80211 kext to publish it").
+ * HackiOS RedwoodWLAN and ios-fuxi FuxiWLAN publish the same property-only shape. */
+class IONetworkController : public IOService {
+    OSDeclareDefaultStructors(IONetworkController);
+};
+class IO80211Controller : public IONetworkController {
+    OSDeclareDefaultStructors(IO80211Controller);
+};
+/* SystemConfiguration lists only objects whose class is IONetworkInterface, and
+ * calls one a Wi-Fi interface when its parent is an IO80211Controller, so the
+ * interface node must keep that class name: a subclass would be named after
+ * itself and be invisible to the list. The refusal of a user client lives on
+ * the class itself, for that reason. IO80211.framework opens one first and,
+ * when it fails, falls back to the ioctl path this kernel answers; so the open
+ * is not wanted, but hearing that somebody tried is the only kernel-side
+ * evidence that wifid found the node at all. */
+class IONetworkInterface : public IOService {
+    OSDeclareDefaultStructors(IONetworkInterface);
+public:
+    virtual IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type,
+        OSDictionary *properties, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IONetworkController, IOService);
+OSDefineMetaClassAndStructors(IO80211Controller, IONetworkController);
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+IOReturn
+IONetworkInterface::newUserClient(task_t, void *, UInt32 type, OSDictionary *, IOUserClient **handler)
+{
+    static unsigned said;
+    if (said++ < 8)
+        IOLog("NEZHA WIFI: user client type %u asked for on en0; there is none\n", (unsigned)type);
+    if (handler != NULL) *handler = NULL;
+    return kIOReturnUnsupported;
+}
+
+/* InterfaceNamer must open this service before it publishes registry quiet.
+ * Without it SCNetworkInterfaceCopyAll blocks wifid and then SpringBoard.
+ * BSD already assigned en0, so there is no interface naming operation here.
+ * See HackiOS MiniIONetworkStack.cpp. */
+class IONetworkStack : public IOService {
+    OSDeclareDefaultStructors(IONetworkStack);
+};
+class IONetworkStackUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(IONetworkStackUserClient);
+public:
+    virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn setProperties(OSObject *) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+/* One delayed snapshot with the existing Wi-Fi diagnostic flag: identify the
+ * service blocking InterfaceNamer without changing its busy accounting. */
+static void network_quiet_diagnostic(void *, wait_result_t)
+{
+    IOService *root = IOService::getServiceRoot();
+    (void)root->waitQuiet(45000000000ULL);
+    IOLog("NEZHA WIFI: registry busy after network discovery %u\n", root->getBusyState());
+    OSKext *image4 = OSKext::lookupKextWithIdentifier("com.apple.security.AppleImage4");
+    IOLog("NEZHA WIFI: AppleImage4 present %u loaded %u started %u\n",
+        image4 != NULL, image4 && image4->isLoaded(), image4 && image4->isStarted());
+    OSSafeReleaseNULL(image4);
+    IORegistryIterator *iter = IORegistryIterator::iterateOver(root,
+        gIOServicePlane, kIORegistryIterateRecursively);
+    if (iter) {
+        IOService *service;
+        while ((service = OSDynamicCast(IOService, iter->getNextObject()))) {
+            IOService *provider = service->getProvider();
+            if (provider && !strcmp(provider->getName(), "defaults"))
+                IOLog("NEZHA WIFI: defaults child %s (%s) state %#x\n", service->getName(),
+                    service->getMetaClass()->getClassName(), (unsigned)service->getState());
+            if (service->getBusyState())
+                IOLog("NEZHA WIFI: busy service %s (%s) count %u\n",
+                    service->getName(), service->getMetaClass()->getClassName(),
+                    service->getBusyState());
+        }
+        iter->release();
+    }
+    thread_terminate(current_thread());
+}
+bool IONetworkStackUserClient::start(IOService *provider)
+{
+    if (!IOUserClient::start(provider)) return false;
+    char name[32];
+    proc_selfname(name, sizeof(name));
+    IOLog("NEZHA WIFI: network stack opened by %s, registry busy %u\n",
+        name, (unsigned)IOService::getServiceRoot()->getBusyState());
+    int capture = 0;
+    (void)PE_parse_boot_argn("nezha_wifi_dump", &capture, sizeof(capture));
+    thread_t thread;
+    if (capture == 1 && kernel_thread_start(network_quiet_diagnostic, NULL, &thread) == KERN_SUCCESS)
+        thread_deallocate(thread);
+    return true;
+}
+IOReturn IONetworkStackUserClient::clientClose(void)
+{
+    if (!isInactive()) terminate();
+    return kIOReturnSuccess;
+}
+IOReturn IONetworkStackUserClient::setProperties(OSObject *)
+{ return kIOReturnUnsupported; }
+static int network_stack_publish(void)
+{
+    IOService *resources = IOService::getResourceService();
+    IONetworkStack *stack = new IONetworkStack;
+    if (!resources || !stack || !stack->init()) {
+        OSSafeReleaseNULL(stack); return ENOMEM;
+    }
+    stack->setName("IONetworkStack");
+    stack->setProperty(kIOUserClientClassKey, "IONetworkStackUserClient");
+    int error = EIO;
+    if (stack->attach(resources)) {
+        if (stack->start(resources)) {
+            stack->registerService(); error = 0;
+        } else stack->detach(resources);
+    }
+    stack->release(); return error;
+}
+extern "C" int peach_wlan_publish(const char *, const unsigned char *);
+extern "C" int peach_wlan_publish_nodes(const unsigned char *);
+
+/* The two nodes wifid looks for carry properties only, so they can exist long
+ * before the link does. Publishing them at the top of the worker thread puts
+ * them in the registry before launchd's wifid walks it; log89 published them
+ * at 33.7 s, inside the run of configd's own discovery, which is late enough
+ * to be missed. The network stack is different: configd opens it to publish
+ * en0's name and then makes a service for that name, so it still waits for the
+ * BSD interface (log89: "network stack opened by configd" right after
+ * ifnet_attach). */
+static bool nodes_published;
+/* What the registry actually holds, 60 s in, by class name: the question this
+ * round is whether wifid can see the nodes at all, and the only trustworthy
+ * answer is the classes an independent walk finds. */
+static void
+registry_audit(void *, wait_result_t)
+{
+    IOSleep(60000);
+    IORegistryIterator *iter = IORegistryIterator::iterateOver(IOService::getServiceRoot(),
+        gIOServicePlane, kIORegistryIterateRecursively);
+    if (iter == NULL) { thread_terminate(current_thread()); return; }
+    unsigned found = 0;
+    IOService *service;
+    while ((service = OSDynamicCast(IOService, iter->getNextObject())) != NULL) {
+        const char *cls = service->getMetaClass()->getClassName();
+        if (!strcmp(cls, "IO80211Controller") || !strcmp(cls, "IONetworkInterface") ||
+            !strcmp(cls, "IONetworkStack") || !strcmp(cls, "IO80211Interface")) {
+            OSObject *name = service->getProperty("IOInterfaceName");
+            IOLog("NEZHA WIFI: registry %s (%s) interface %s busy %u\n", service->getName(), cls,
+                name && OSDynamicCast(OSString, name) ? ((OSString *)name)->getCStringNoCopy() : "-",
+                (unsigned)service->getBusyState());
+            found++;
+        }
+    }
+    iter->release();
+    IOLog("NEZHA WIFI: registry audit found %u network nodes\n", found);
+    thread_terminate(current_thread());
+}
+extern "C" int
+peach_wlan_publish_nodes(const unsigned char *mac)
+{
+    if (nodes_published) return 0;
+    IOService *provider = IOService::getPlatform();
+    IO80211Controller *controller = new IO80211Controller;
+    IONetworkInterface *interface = new IONetworkInterface;
+    OSData *address = mac ? OSData::withBytes(mac, 6) : NULL;
+    if (!provider || !controller || !interface || !address || !controller->init() || !interface->init()) {
+        OSSafeReleaseNULL(controller); OSSafeReleaseNULL(interface); OSSafeReleaseNULL(address);
+        return ENOMEM;
+    }
+    controller->setName("NezhaPeachWLAN");
+    controller->setProperty("IOMACAddress", address);
+    controller->setProperty("IOBuiltin", true);
+    address->release();
+    interface->setName("NezhaPeachInterface");
+    interface->setProperty("IOInterfaceName", "en0");
+    interface->setProperty("BSD Name", "en0");
+    interface->setProperty("IOInterfaceNamePrefix", "en");
+    interface->setProperty("IOInterfaceType", 6ULL, 32);
+    interface->setProperty("IOInterfaceUnit", 0ULL, 32);
+    interface->setProperty("IOBuiltin", true);
+    interface->setProperty("IOPrimaryInterface", true);
+    interface->setProperty("IO80211InterfaceRole", "Infrastructure");
+    int error = EIO;
+    if (controller->attach(provider)) {
+        if (controller->start(provider)) {
+            if (interface->attach(controller)) {
+                if (interface->start(controller)) {
+                    controller->registerService(); interface->registerService();
+                    IOLog("NEZHA WIFI: registry nodes for en0 published\n");
+                    nodes_published = true; error = 0;
+                    thread_t audit;
+                    if (kernel_thread_start(registry_audit, NULL, &audit) == KERN_SUCCESS)
+                        thread_deallocate(audit);
+                } else interface->detach(controller);
+            }
+            if (error) controller->stop(provider);
+        }
+        if (error) controller->detach(provider);
+    }
+    interface->release(); controller->release(); return error;
+}
+
+static bool stack_published;
+extern "C" int
+peach_wlan_publish(const char *name, const unsigned char *mac)
+{
+    (void)name;
+    int error = peach_wlan_publish_nodes(mac);
+    if (error) return error;
+    if (!stack_published) {
+        error = network_stack_publish();
+        if (error) return error;
+        stack_published = true;
+    }
+    IOLog("NEZHA WIFI: Apple80211 ioctl interface en0 published (link separate)\n");
+    return 0;
+}
+#else
+extern "C" int peach_wlan_publish(const char *, const unsigned char *) { return EOPNOTSUPP; }
+extern "C" int peach_wlan_publish_nodes(const unsigned char *) { return EOPNOTSUPP; }
+#endif
